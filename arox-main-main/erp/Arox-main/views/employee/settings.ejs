<div class="erp-h1" style="margin-bottom: 24px; color: #000000;">
  <div style="font-size: 24px; font-weight: 750;">Settings & Preferences</div>
  <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 4px;">Manage account details, security credentials, and notifications</div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; margin-bottom: 32px;">
  <!-- Profile Summary Card -->
  <div class="erp-card" style="background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; padding: 24px;">
    <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px;">
      <div style="width: 56px; height: 56px; border-radius: 12px; background: #000; color: #fff; font-size: 22px; font-weight: 750; display: flex; align-items: center; justify-content: center;">
        <%= (user.first_name || 'E').charAt(0).toUpperCase() %>
      </div>
      <div>
        <h3 style="font-size: 18px; font-weight: 750; color: #000; margin: 0;"><%= user.first_name %> <%= user.last_name %></h3>
        <span style="font-size: 11px; font-weight: 700; padding: 2px 8px; background: #000; color: #fff; border-radius: 4px; text-transform: uppercase;">
          <%= user.role || 'Employee' %>
        </span>
      </div>
    </div>

    <div style="display: flex; flex-direction: column; gap: 14px; font-size: 13px;">
      <div>
        <span style="color: #64748B; font-weight: 500; display: block; font-size: 11px;">EMAIL ADDRESS</span>
        <span style="font-weight: 600; color: #000;"><%= user.email %></span>
      </div>
      <div>
        <span style="color: #64748B; font-weight: 500; display: block; font-size: 11px;">DEPARTMENT</span>
        <span style="font-weight: 600; color: #000;"><%= user.department || 'Corporate Operations' %></span>
      </div>
      <div>
        <span style="color: #64748B; font-weight: 500; display: block; font-size: 11px;">PHONE NUMBER</span>
        <span style="font-weight: 600; color: #000;"><%= user.phone || '—' %></span>
      </div>
      <div>
        <span style="color: #64748B; font-weight: 500; display: block; font-size: 11px;">ACCOUNT STATUS</span>
        <span style="font-weight: 600; color: #16A34A;">● Active & Verified</span>
      </div>
    </div>
  </div>

  <!-- Change Password Form Card -->
  <div class="erp-card" style="background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; padding: 24px;">
    <h3 style="font-size: 16px; font-weight: 750; color: #000; margin: 0 0 16px 0;">Security Credentials</h3>
    <form id="employeePasswordForm" onsubmit="handleEmployeePasswordChange(event)">
      <div style="margin-bottom: 12px;">
        <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">Current Password *</label>
        <input type="password" id="empCurrentPassword" required style="width: 100%; padding: 8px 12px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
      </div>
      <div style="margin-bottom: 12px;">
        <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">New Password *</label>
        <input type="password" id="empNewPassword" required minlength="6" style="width: 100%; padding: 8px 12px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
      </div>
      <div style="margin-bottom: 16px;">
        <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">Confirm New Password *</label>
        <input type="password" id="empConfirmPassword" required minlength="6" style="width: 100%; padding: 8px 12px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
      </div>
      <button type="submit" id="empPassBtn" class="erp-btn erp-btn-primary" style="padding: 8px 16px; background: #000; color: #fff; border-radius: 6px; font-weight: 600; font-size: 13px; cursor: pointer;">
        Update Password
      </button>
    </form>
  </div>

  <!-- Notification Preferences -->
  <div class="erp-card" style="background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; padding: 24px;">
    <h3 style="font-size: 16px; font-weight: 750; color: #000; margin: 0 0 16px 0;">Notification Preferences</h3>
    <div style="display: flex; flex-direction: column; gap: 14px; font-size: 13px;">
      <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer;">
        <span>Email alert for upcoming follow-up calls</span>
        <input type="checkbox" checked style="accent-color: #000; width: 16px; height: 16px;">
      </label>
      <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer;">
        <span>Notification on new lead assignment</span>
        <input type="checkbox" checked style="accent-color: #000; width: 16px; height: 16px;">
      </label>
      <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer;">
        <span>Real-time Triangular Sync push updates</span>
        <input type="checkbox" checked style="accent-color: #000; width: 16px; height: 16px;">
      </label>
      <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer;">
        <span>Daily task summary email at 9:00 AM</span>
        <input type="checkbox" checked style="accent-color: #000; width: 16px; height: 16px;">
      </label>
    </div>
  </div>
</div>

<script>
  async function handleEmployeePasswordChange(e) {
    e.preventDefault();
    const cur = document.getElementById('empCurrentPassword').value;
    const n = document.getElementById('empNewPassword').value;
    const c = document.getElementById('empConfirmPassword').value;
    const btn = document.getElementById('empPassBtn');

    if (n !== c) {
      alert('New passwords do not match.');
      return;
    }

    btn.disabled = true;
    try {
      const res = await fetch('/api/auth/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ current_password: cur, new_password: n })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || 'Failed to update password');

      alert('Password updated successfully!');
      document.getElementById('employeePasswordForm').reset();
    } catch (err) {
      alert(err.message);
    } finally {
      btn.disabled = false;
    }
  }
</script>

