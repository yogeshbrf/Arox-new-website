<div class="erp-h1" style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>
    <div style="font-size: 24px; font-weight: 750;">System Users & Credentials</div>
    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 2px;">Manage user accounts, roles, access permissions, and authentication states</div>
  </div>
  <button onclick="openAddUserModal()" class="erp-btn erp-btn-primary" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #000; color: #fff; border-radius: 8px; font-weight: 600; font-size: 13px; border: none; cursor: pointer;">
    <i data-lucide="user-plus" style="width: 16px; height: 16px;"></i> Add New User
  </button>
</div>

<!-- Interactive Catalogue Filter Toolbar (Apple + Google Material 3) -->
<!-- Summary Metric Cards -->
<%
  const totalUsers = users ? users.length : 0;
  const activeUsers = users ? users.filter(u => (u.status || 'active').toLowerCase() === 'active').length : 0;
  const staffUsers = users ? users.filter(u => u.role_name === 'employee' || u.role_name === 'staff').length : 0;
  const studentUsers = users ? users.filter(u => u.role_name === 'student').length : 0;
%>
<div class="erp-grid-4" style="margin-bottom: 24px;">
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="users"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Total Users</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= totalUsers %></div>
    <div class="erp-p" style="margin-top: 6px; color: #64748B; font-size: 12px;">System accounts</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="user-check"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Active Logins</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= activeUsers %></div>
    <div class="erp-p" style="margin-top: 6px; color: #16A34A; font-weight: 600; font-size: 12px;">Authenticated access</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="briefcase"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Employee Accounts</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= staffUsers %></div>
    <div class="erp-p" style="margin-top: 6px; color: #2563EB; font-weight: 600; font-size: 12px;">Operations & CRM</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="graduation-cap"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Student Accounts</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= studentUsers %></div>
    <div class="erp-p" style="margin-top: 6px; color: #000000; font-weight: 600; font-size: 12px;">Student portal</div>
  </div>
</div>
<div class="catalogue-toolbar" data-catalogue="users">
  <div class="catalogue-search-wrap">
    <i data-lucide="search" class="catalogue-search-icon"></i>
    <input type="text" class="catalogue-search-input" placeholder="Search by name, email, role, phone...">
  </div>

  <div class="catalogue-filters-group">
    <!-- Role Filter -->
    <select class="catalogue-select" data-filter="category" title="Filter by Role">
      <option value="all">All Roles</option>
      <option value="admin">Administrators</option>
      <option value="staff">Staff & Trainers</option>
      <option value="employee">Employees</option>
      <option value="student">Students</option>
    </select>

    <!-- Status Filter -->
    <select class="catalogue-select" data-filter="status" title="Filter by Status">
      <option value="all">All Statuses</option>
      <option value="active">Active Only</option>
      <option value="inactive">Inactive Only</option>
    </select>

    <!-- Sort Dropdown -->
    <select class="catalogue-select" data-filter="sort" title="Sort records">
      <option value="name">Name (A - Z)</option>
      <option value="name_desc">Name (Z - A)</option>
      <option value="newest">Newest Joined</option>
    </select>

    <!-- Reset Button -->
    <button type="button" class="catalogue-reset-btn" title="Reset all filters">
      <i data-lucide="rotate-ccw" style="width: 13px; height: 13px;"></i>
      <span>Reset</span>
    </button>
  </div>

  <!-- Segmented View Switcher: List vs Kanban/Grid -->
  <div class="catalogue-view-switcher">
    <button type="button" class="view-btn active" data-view="list" title="Table List View">
      <i data-lucide="list"></i>
      <span>List</span>
    </button>
    <button type="button" class="view-btn" data-view="kanban" title="Kanban Card Grid View">
      <i data-lucide="layout-grid"></i>
      <span>Kanban</span>
    </button>
  </div>

  <!-- Result Counter -->
  <div class="catalogue-count-badge">Showing <%= users ? users.length : 0 %> users</div>
</div>

<!-- 1. LIST VIEW (Data Table) -->
<div class="catalogue-list-view" data-catalogue="users">
  <div class="erp-card" style="padding: 0; background: #FFFFFF; border: 1px solid #E2E8F0; overflow: hidden; margin-bottom: 24px;">
    <div class="erp-table-container" style="border: none; border-radius: 0; margin-bottom: 0;">
      <table class="erp-table">
        <thead>
          <tr>
            <th style="color: #000;">User Identity</th>
            <th style="color: #000;">Access Role</th>
            <th style="color: #000;">Contact Phone</th>
            <th style="color: #000;">Account Status</th>
            <th style="color: #000;">Joined Date</th>
            <th style="text-align: right; color: #000;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (users && users.length > 0) { %>
            <% users.forEach(u => { 
              const fullName = `${u.first_name || ''} ${u.last_name || ''}`.trim();
              const uRole = (u.role || u.role_name || 'employee').toLowerCase();
              const uStatus = (u.is_active || u.status === 'active') ? 'active' : 'inactive';
            %>
              <tr data-search="<%= (fullName + ' ' + u.email + ' ' + (u.phone || '') + ' ' + uRole).toLowerCase() %>"
                  data-status="<%= uStatus %>"
                  data-category="<%= uRole %>"
                  data-name="<%= fullName.toLowerCase() %>"
                  data-newest="<%= u.id %>">
                <td>
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <div style="width: 36px; height: 36px; border-radius: 50%; background: #000; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px;">
                      <%= (u.first_name || 'U').charAt(0).toUpperCase() %>
                    </div>
                    <div>
                      <div style="font-weight: 700; color: #000; font-size: 13.5px;"><%= fullName %></div>
                      <div style="font-size: 12px; color: #64748B;"><%= u.email %></div>
                    </div>
                  </div>
                </td>
                <td>
                  <span style="display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 700; text-transform: uppercase; background: #F1F5F9; color: #000; border: 1px solid #CBD5E1;">
                    <%= uRole %>
                  </span>
                </td>
                <td>
                  <span style="font-size: 13px; color: #334155;"><%= u.phone || '—' %></span>
                </td>
                <td>
                  <label class="toggle-switch" style="display: inline-flex; align-items: center; cursor: pointer; position: relative;">
                    <input type="checkbox" style="opacity: 0; position: absolute; z-index: -1;" 
                           <%= u.is_active ? 'checked' : '' %> 
                           <%= u.id === user.id ? 'disabled' : '' %>
                           data-user-id="<%= u.id %>"
                           onchange="handleToggleUserStatus(this)">
                    <div class="toggle-track <%= u.is_active ? 'is-active' : '' %>" style="width: 36px; height: 20px; background: #CBD5E1; border-radius: 20px; position: relative; transition: all 0.2s;">
                      <div class="toggle-thumb" style="width: 16px; height: 16px; background: #fff; border-radius: 50%; position: absolute; top: 2px; left: <%= u.is_active ? '18px' : '2px' %>; transition: all 0.2s; box-shadow: 0 1px 2px rgba(0,0,0,0.2);"></div>
                    </div>
                  </label>
                  <span style="font-size: 11px; font-weight: 600; margin-left: 6px; color: <%= u.is_active ? '#16A34A' : '#64748B' %>;">
                    <%= u.is_active ? 'Active' : 'Inactive' %>
                  </span>
                </td>
                <td>
                  <div style="font-size: 12px; color: #64748B;">
                    <%= new Date(u.created_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                  </div>
                </td>
                <td style="text-align: right;">
                  <div style="display: inline-flex; gap: 6px;">
                    <button type="button" onclick="openEditUserById('<%= u.id %>')" class="erp-btn erp-btn-secondary" style="padding: 4px 10px; font-size: 11px; font-weight: 600; border: 1px solid #CBD5E1; color: #000; cursor: pointer;">
                      Edit
                    </button>
                    <% if (u.id !== user.id) { %>
                      <button type="button" onclick="deleteUser('<%= u.id %>', '<%= fullName %>')" class="erp-btn" style="padding: 4px 8px; font-size: 11px; font-weight: 600; border: 1px solid #FECACA; background: #FEF2F2; color: #DC2626; cursor: pointer;">
                        Delete
                      </button>
                    <% } else { %>
                      <span style="font-size: 11px; color: #64748B; font-style: italic; padding: 4px 6px;">(You)</span>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
          <tr class="empty-state-row" style="display: <%= (!users || users.length === 0) ? '' : 'none' %>;">
            <td colspan="6" style="text-align: center; padding: 36px; color: #64748B;">No user accounts found matching current filters.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- 2. KANBAN / GRID VIEW (Cards) -->
<div class="catalogue-kanban-view" data-catalogue="users">
  <% if (users && users.length > 0) { %>
    <% users.forEach(u => { 
      const fullName = `${u.first_name || ''} ${u.last_name || ''}`.trim();
      const uRole = (u.role || u.role_name || 'employee').toLowerCase();
      const uStatus = (u.is_active || u.status === 'active') ? 'active' : 'inactive';
    %>
      <div class="kanban-item-card"
           data-search="<%= (fullName + ' ' + u.email + ' ' + (u.phone || '') + ' ' + uRole).toLowerCase() %>"
           data-status="<%= uStatus %>"
           data-category="<%= uRole %>"
           data-name="<%= fullName.toLowerCase() %>"
           data-newest="<%= u.id %>">
        <div class="kanban-card-top">
          <div style="display: flex; align-items: center; gap: 10px;">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: #000; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px;">
              <%= (u.first_name || 'U').charAt(0).toUpperCase() %>
            </div>
            <div>
              <div class="kanban-card-title"><%= fullName %></div>
              <div class="kanban-card-subtitle"><%= u.email %></div>
            </div>
          </div>
          <% if (u.is_active) { %>
            <span style="padding: 3px 8px; background: #DCFCE7; color: #166534; border-radius: 99px; font-size: 11px; font-weight: 700;">Active</span>
          <% } else { %>
            <span style="padding: 3px 8px; background: #F1F5F9; color: #64748B; border-radius: 99px; font-size: 11px; font-weight: 700;">Inactive</span>
          <% } %>
        </div>

        <div class="kanban-card-body">
          <div class="kanban-chip-row">
            <span class="kanban-chip" style="background:#000; color:#fff; text-transform: uppercase;"><i data-lucide="shield" style="color:#fff;"></i> <%= uRole %></span>
            <% if (u.phone) { %>
              <span class="kanban-chip"><i data-lucide="phone"></i> <%= u.phone %></span>
            <% } %>
            <span class="kanban-chip"><i data-lucide="calendar"></i> Joined <%= new Date(u.created_at).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
          </div>
        </div>

        <div class="kanban-card-footer">
          <a href="mailto:<%= u.email %>" class="erp-btn erp-btn-secondary" style="padding: 6px 12px; font-size: 12px; border: 1px solid #CBD5E1; color: #000; text-decoration: none; border-radius: 8px;">
            Email User
          </a>
          <div style="display: inline-flex; gap: 6px;">
            <button type="button" onclick="openEditUserById('<%= u.id %>')" class="erp-btn erp-btn-secondary" style="padding: 6px 12px; font-size: 12px; border: 1px solid #CBD5E1; color: #000; border-radius: 8px; cursor: pointer;">
              Edit
            </button>
            <% if (u.id !== user.id) { %>
              <button type="button" onclick="deleteUser('<%= u.id %>', '<%= fullName %>')" class="erp-btn" style="padding: 6px 12px; font-size: 12px; border: 1px solid #FECACA; background: #FEF2F2; color: #DC2626; border-radius: 8px; cursor: pointer;">
                Delete
              </button>
            <% } %>
          </div>
        </div>
      </div>
    <% }); %>
  <% } %>
</div>

<!-- Modal: Add New User -->
<div id="addUserModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 99999; align-items: center; justify-content: center; padding: 16px;">
  <div style="background: #FFFFFF; border-radius: 12px; width: 100%; max-width: 500px; padding: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.2);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h3 style="margin: 0; font-size: 18px; font-weight: 700; color: #000;">Add New User</h3>
      <button onclick="closeAddUserModal()" style="border: none; background: transparent; font-size: 20px; cursor: pointer; color: #64748B;">&times;</button>
    </div>

    <form id="addUserForm" onsubmit="handleCreateUser(event)">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">First Name *</label>
          <input type="text" name="first_name" required class="erp-input" style="font-size: 13px;">
        </div>
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">Last Name *</label>
          <input type="text" name="last_name" required class="erp-input" style="font-size: 13px;">
        </div>
      </div>

      <div style="margin-bottom: 12px;">
        <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">Email Address *</label>
        <input type="email" name="email" required class="erp-input" style="font-size: 13px;">
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">System Role *</label>
          <select name="role" required class="erp-input" style="font-size: 13px;">
            <option value="employee">Staff / Trainer</option>
            <option value="admin">Administrator</option>
            <option value="student">Student</option>
          </select>
        </div>
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">Phone Number</label>
          <input type="tel" name="phone" placeholder="+91..." class="erp-input" style="font-size: 13px;">
        </div>
      </div>

      <div id="addFormError" style="color: #DC2626; font-size: 12px; margin-bottom: 12px; display: none;"></div>

      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" onclick="closeAddUserModal()" class="erp-btn erp-btn-secondary" style="padding: 8px 16px; border: 1px solid #CBD5E1; color: #000; cursor: pointer;">Cancel</button>
        <button type="submit" id="addUserSubmitBtn" class="erp-btn erp-btn-primary" style="padding: 8px 20px; background: #000; color: #fff; border-radius: 6px; font-weight: 600; cursor: pointer;">Create User</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Edit Existing User -->
<div id="editUserModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 99999; align-items: center; justify-content: center; padding: 16px;">
  <div style="background: #FFFFFF; border-radius: 12px; width: 100%; max-width: 500px; padding: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.2);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h3 id="editUserModalTitle" style="margin: 0; font-size: 18px; font-weight: 700; color: #000;">Edit User</h3>
      <button onclick="closeEditUserModal()" style="border: none; background: transparent; font-size: 20px; cursor: pointer; color: #64748B;">&times;</button>
    </div>

    <form id="editUserForm" onsubmit="handleEditUserSubmit(event)">
      <input type="hidden" id="editUserId" name="id">

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">First Name *</label>
          <input type="text" id="editUserFirst" name="first_name" required class="erp-input" style="font-size: 13px;">
        </div>
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">Last Name *</label>
          <input type="text" id="editUserLast" name="last_name" required class="erp-input" style="font-size: 13px;">
        </div>
      </div>

      <div style="margin-bottom: 12px;">
        <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">Email Address *</label>
        <input type="email" id="editUserEmail" name="email" required class="erp-input" style="font-size: 13px;">
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">System Role *</label>
          <select id="editUserRole" name="role" required class="erp-input" style="font-size: 13px;">
            <option value="employee">Staff / Trainer</option>
            <option value="admin">Administrator</option>
            <option value="student">Student</option>
          </select>
        </div>
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">Phone Number</label>
          <input type="tel" id="editUserPhone" name="phone" class="erp-input" style="font-size: 13px;">
        </div>
      </div>

      <div style="margin-bottom: 16px;">
        <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">Account Status</label>
        <select id="editUserStatus" name="status" class="erp-input" style="font-size: 13px;">
          <option value="active">Active</option>
          <option value="inactive">Inactive</option>
        </select>
      </div>

      <div id="editFormError" style="color: #DC2626; font-size: 12px; margin-bottom: 12px; display: none;"></div>

      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" onclick="closeEditUserModal()" class="erp-btn erp-btn-secondary" style="padding: 8px 16px; border: 1px solid #CBD5E1; color: #000; cursor: pointer;">Cancel</button>
        <button type="submit" id="editUserSubmitBtn" class="erp-btn erp-btn-primary" style="padding: 8px 20px; background: #000; color: #fff; border-radius: 6px; font-weight: 600; cursor: pointer;">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Temp Password Display -->
<div id="tempPasswordModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 99999; align-items: center; justify-content: center; padding: 16px;">
  <div style="background: #FFFFFF; border-radius: 12px; width: 100%; max-width: 440px; padding: 28px; text-align: center; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.2);">
    <div style="width: 56px; height: 56px; border-radius: 50%; background: #DCFCE7; color: #166534; display: flex; align-items: center; justify-content: center; font-size: 26px; margin: 0 auto 16px;">✓</div>
    <h3 style="margin: 0 0 6px 0; font-size: 18px; font-weight: 750; color: #000;">User Account Created</h3>
    <p style="font-size: 13px; color: #64748B; margin: 0 0 16px 0;">Temporary password generated for first-time sign-in:</p>
    <div style="background: #F8FAFC; border: 1px dashed #CBD5E1; padding: 14px; border-radius: 8px; margin-bottom: 18px;">
      <span id="tempPasswordDisplay" style="font-family: monospace; font-size: 20px; font-weight: 800; color: #000; letter-spacing: 2px;"></span>
    </div>
    <button type="button" onclick="window.location.reload()" class="erp-btn erp-btn-primary" style="width: 100%; padding: 10px; background: #000; color: #fff; border-radius: 6px; font-weight: 600; cursor: pointer;">
      Done
    </button>
  </div>
</div>

<script>
  const allUsersMap = <%- JSON.stringify((users || []).reduce((acc, u) => Object.assign(acc, { [u.id]: u }), {})) %>;

  function openAddUserModal() {
    document.getElementById('addUserModal').style.display = 'flex';
  }
  function closeAddUserModal() {
    document.getElementById('addUserModal').style.display = 'none';
  }

  function openEditUserById(id) {
    const u = allUsersMap[id];
    if (!u) return console.warn('User not found:', id);
    document.getElementById('editUserModalTitle').textContent = `Edit User: ${u.first_name} ${u.last_name || ''}`;
    document.getElementById('editUserId').value = u.id;
    document.getElementById('editUserFirst').value = u.first_name || '';
    document.getElementById('editUserLast').value = u.last_name || '';
    document.getElementById('editUserEmail').value = u.email || '';
    document.getElementById('editUserPhone').value = u.phone || '';
    document.getElementById('editUserRole').value = (u.role || u.role_name || 'employee').toLowerCase();
    document.getElementById('editUserStatus').value = (u.is_active || u.status === 'active') ? 'active' : 'inactive';
    document.getElementById('editUserModal').style.display = 'flex';
  }
  function closeEditUserModal() {
    document.getElementById('editUserModal').style.display = 'none';
  }

  async function handleCreateUser(e) {
    e.preventDefault();
    const form = e.target;
    const btn = document.getElementById('addUserSubmitBtn');
    const errBox = document.getElementById('addFormError');
    errBox.style.display = 'none';
    btn.disabled = true;

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    try {
      const res = await fetch('/admin/users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to create user');

      closeAddUserModal();
      document.getElementById('tempPasswordDisplay').textContent = data.tempPassword || 'AutoCreated';
      document.getElementById('tempPasswordModal').style.display = 'flex';
    } catch (err) {
      errBox.textContent = err.message;
      errBox.style.display = 'block';
    } finally {
      btn.disabled = false;
    }
  }

  async function handleEditUserSubmit(e) {
    e.preventDefault();
    const id = document.getElementById('editUserId').value;
    const btn = document.getElementById('editUserSubmitBtn');
    const errBox = document.getElementById('editFormError');
    errBox.style.display = 'none';
    btn.disabled = true;

    const payload = {
      first_name: document.getElementById('editUserFirst').value.trim(),
      last_name: document.getElementById('editUserLast').value.trim(),
      email: document.getElementById('editUserEmail').value.trim(),
      phone: document.getElementById('editUserPhone').value.trim(),
      role: document.getElementById('editUserRole').value,
      status: document.getElementById('editUserStatus').value
    };

    try {
      const res = await fetch(`/admin/users/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to update user');

      closeEditUserModal();
      window.location.reload();
    } catch (err) {
      errBox.textContent = err.message;
      errBox.style.display = 'block';
    } finally {
      btn.disabled = false;
    }
  }

  async function handleToggleUserStatus(inputEl) {
    const id = inputEl.getAttribute('data-user-id');
    try {
      const res = await fetch('/admin/users/' + id + '/status', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ is_active: inputEl.checked })
      });
      if (!res.ok) {
        const data = await res.json();
        throw new Error(data.error);
      }
      window.location.reload();
    } catch (err) {
      alert(err.message);
      window.location.reload();
    }
  }

  async function deleteUser(id, name) {
    if (!confirm(`Are you sure you want to delete user account "${name}"?`)) return;
    try {
      const res = await fetch('/admin/users/' + id, { method: 'DELETE' });
      if (!res.ok) {
        const data = await res.json();
        throw new Error(data.error);
      }
      window.location.reload();
    } catch (err) {
      alert(err.message);
    }
  }
</script>
