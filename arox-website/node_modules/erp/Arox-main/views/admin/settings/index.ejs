<div class="erp-h1" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>
    <div style="font-size: 26px; font-weight: 750;">System Settings & ERP Preferences</div>
    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 4px;">Configure corporate identity, document generation defaults, CRM automations, and platform security</div>
  </div>
  <div style="display: flex; align-items: center; gap: 8px;">
    <span style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; padding: 4px 10px; background: #DCFCE7; color: #166534; border-radius: 99px;">
      <span style="width: 7px; height: 7px; border-radius: 50%; background: #16A34A;"></span> SQLite DB Synchronized
    </span>
  </div>
</div>

<!-- Tab Navigation -->
<div class="erp-tab-nav" style="margin-bottom: 24px;">
  <button type="button" class="erp-tab-btn active" onclick="switchSettingsTab('tab-org', this)">
    <i data-lucide="building-2" style="width: 15px; height: 15px;"></i> Organization Profile
  </button>
  <button type="button" class="erp-tab-btn" onclick="switchSettingsTab('tab-crm', this)">
    <i data-lucide="filter" style="width: 15px; height: 15px;"></i> CRM & Leads
  </button>
  <button type="button" class="erp-tab-btn" onclick="switchSettingsTab('tab-generator', this)">
    <i data-lucide="award" style="width: 15px; height: 15px;"></i> Document Defaults
  </button>
  <button type="button" class="erp-tab-btn" onclick="switchSettingsTab('tab-security', this)">
    <i data-lucide="shield-check" style="width: 15px; height: 15px;"></i> Platform Security
  </button>
  <button type="button" class="erp-tab-btn" onclick="switchSettingsTab('tab-notifications', this)">
    <i data-lucide="bell" style="width: 15px; height: 15px;"></i> Notification Rules
  </button>
</div>

<!-- TAB 1: Organization Profile -->
<div id="tab-org" class="settings-tab-panel" style="display: block;">
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 12px; padding: 24px; max-width: 900px; margin-bottom: 24px;">
    <div style="border-bottom: 1px solid #E2E8F0; padding-bottom: 14px; margin-bottom: 20px;">
      <h3 style="font-size: 16px; font-weight: 750; color: #000; margin: 0 0 4px 0;">Corporate Identity & Invoicing Details</h3>
      <p style="font-size: 12px; color: #64748B; margin: 0;">These credentials appear across all generated certificates, student receipts, and portal headers.</p>
    </div>

    <form id="orgSettingsForm" onsubmit="handleSaveSettings(event, 'org')">
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div>
            <label style="font-size: 12px; font-weight: 700; color: #000; display: block; margin-bottom: 6px;">Legal Entity Name *</label>
            <input type="text" name="name" value="<%= settings.org.name || '' %>" required class="erp-input" style="font-size: 13px;">
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 700; color: #000; display: block; margin-bottom: 6px;">Corporate Tagline</label>
            <input type="text" name="tagline" value="<%= settings.org.tagline || '' %>" placeholder="e.g. Enterprise Training & Software Solutions" class="erp-input" style="font-size: 13px;">
          </div>
        </div>

        <div>
          <label style="font-size: 12px; font-weight: 700; color: #000; display: block; margin-bottom: 6px;">Registered Address *</label>
          <input type="text" name="address" value="<%= settings.org.address || '' %>" required class="erp-input" style="font-size: 13px;">
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div>
            <label style="font-size: 12px; font-weight: 700; color: #000; display: block; margin-bottom: 6px;">Official Email *</label>
            <input type="email" name="email" value="<%= settings.org.email || '' %>" required class="erp-input" style="font-size: 13px;">
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 700; color: #000; display: block; margin-bottom: 6px;">Support Phone *</label>
            <input type="text" name="phone" value="<%= settings.org.phone || '' %>" required class="erp-input" style="font-size: 13px;">
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div>
            <label style="font-size: 12px; font-weight: 700; color: #000; display: block; margin-bottom: 6px;">GSTIN / Tax ID</label>
            <input type="text" name="gstin" value="<%= settings.org.gstin || '' %>" placeholder="33AABCU9603R1ZM" class="erp-input" style="font-size: 13px; font-family: monospace;">
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 700; color: #000; display: block; margin-bottom: 6px;">Official Website URL</label>
            <input type="url" name="website" value="<%= settings.org.website || '' %>" placeholder="https://aroxtech.com" class="erp-input" style="font-size: 13px;">
          </div>
        </div>

        <div>
          <label style="font-size: 12px; font-weight: 700; color: #000; display: block; margin-bottom: 6px;">Operating / Support Hours</label>
          <input type="text" name="support_hours" value="<%= settings.org.support_hours || 'Mon - Sat: 9:00 AM - 6:00 PM' %>" class="erp-input" style="font-size: 13px;">
        </div>

        <div style="display: flex; justify-content: flex-end; padding-top: 14px; border-top: 1px solid #E2E8F0; margin-top: 6px;">
          <button type="submit" class="erp-btn erp-btn-primary" style="padding: 10px 22px; background: #000; color: #fff; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
            <i data-lucide="save" style="width: 14px; height: 14px;"></i> Save Organization Details
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- TAB 2: CRM & Lead Pipeline -->
<div id="tab-crm" class="settings-tab-panel" style="display: none;">
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 12px; padding: 24px; max-width: 900px; margin-bottom: 24px;">
    <div style="border-bottom: 1px solid #E2E8F0; padding-bottom: 14px; margin-bottom: 20px;">
      <h3 style="font-size: 16px; font-weight: 750; color: #000; margin: 0 0 4px 0;">CRM & Pipeline Rules</h3>
      <p style="font-size: 12px; color: #64748B; margin: 0;">Automations for lead assignment, follow-up SLA monitors, and sales notifications.</p>
    </div>

    <form id="crmSettingsForm" onsubmit="handleSaveSettings(event, 'crm')">
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <label style="display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; cursor: pointer;">
          <div>
            <div style="font-size: 13px; font-weight: 700; color: #000;">Auto-Assign Inbound Leads</div>
            <div style="font-size: 12px; color: #64748B; margin-top: 2px;">Round-robin assign new registrations & applications to active employees</div>
          </div>
          <input type="checkbox" name="auto_assign_leads" value="true" <%= settings.crm.auto_assign_leads ? 'checked' : '' %> style="accent-color: #000; width: 18px; height: 18px;">
        </label>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div>
            <label style="font-size: 12px; font-weight: 700; color: #000; display: block; margin-bottom: 6px;">Overdue Follow-up Threshold (Hours)</label>
            <input type="number" name="overdue_alert_hours" value="<%= settings.crm.overdue_alert_hours || 24 %>" min="1" max="168" class="erp-input" style="font-size: 13px;">
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 700; color: #000; display: block; margin-bottom: 6px;">Currency Symbol</label>
            <input type="text" name="currency_symbol" value="<%= settings.crm.currency_symbol || '₹' %>" class="erp-input" style="font-size: 13px;">
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div>
            <label style="font-size: 12px; font-weight: 700; color: #000; display: block; margin-bottom: 6px;">Default Pipeline Entry Stage</label>
            <select name="default_pipeline_stage" class="erp-input" style="font-size: 13px;">
              <option value="new" <%= settings.crm.default_pipeline_stage === 'new' ? 'selected' : '' %>>New Lead</option>
              <option value="contacted" <%= settings.crm.default_pipeline_stage === 'contacted' ? 'selected' : '' %>>Contacted</option>
              <option value="discussion" <%= settings.crm.default_pipeline_stage === 'discussion' ? 'selected' : '' %>>Discussion</option>
            </select>
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 700; color: #000; display: block; margin-bottom: 6px;">Sales Notifications Routing Email</label>
            <input type="email" name="notify_sales_email" value="<%= settings.crm.notify_sales_email || 'sales@aroxtech.com' %>" class="erp-input" style="font-size: 13px;">
          </div>
        </div>

        <div style="display: flex; justify-content: flex-end; padding-top: 14px; border-top: 1px solid #E2E8F0; margin-top: 6px;">
          <button type="submit" class="erp-btn erp-btn-primary" style="padding: 10px 22px; background: #000; color: #fff; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
            <i data-lucide="save" style="width: 14px; height: 14px;"></i> Save CRM Preferences
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

