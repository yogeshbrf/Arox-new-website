<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="mobile-web-app-capable" content="yes">
  <title>AROX ERP - Admin Dashboard</title>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="AROX ERP Admin">
  <meta property="og:title" content="AROX ERP - Admin Dashboard">
  <meta property="og:description" content="Manage students, courses, registrations, and payments on the AROX Tech Admin Dashboard.">
  <meta property="og:url" content="<%= org.website %><%= currentPath %>">
  <meta property="og:image" content="<%= org.website %>/assets/hero/home_light.png">
  <meta property="og:image:alt" content="AROX ERP Admin Dashboard">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="AROX ERP - Admin Dashboard">
  <meta name="twitter:description" content="Manage students, courses, registrations, and payments on the AROX Tech Admin Dashboard.">

  <!-- SEO -->
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#155EEF">

  <!-- Google Fonts: Montserrat (unified brand font) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Montserrat', 'sans-serif'] },
          colors: {
            primary: { DEFAULT: '#155EEF', light: '#3B82F6', dark: '#0F4EBB' },
          }
        }
      }
    }
  </script>

  <!-- Chart.js for Admin Dashboards -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- Lucide Icons + AROX Duotone Icon System -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="/erp-assets/js/arox-icons.js?v=1"></script>

  <!-- Multi-Panel Simultaneous Session Context -->
  <script>
    (function() {
      const origFetch = window.fetch;
      window.fetch = function(url, options = {}) {
        options = options || {};
        options.headers = options.headers || {};
        if (options.headers instanceof Headers) {
          options.headers.set('X-Role', 'admin');
        } else {
          options.headers['X-Role'] = 'admin';
        }
        return origFetch(url, options);
      };
    })();
  </script>

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/erp-assets/css/erp-theme.css?v=4.1">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/erp-assets/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/erp-assets/assets/logo/logo-dark.png">

  <%- style %>
</head>
<body class="erp-body">

  <!-- Skip to content (accessibility) -->
  <a href="#admin-main-content" style="position:absolute;top:-100%;left:16px;z-index:99999;padding:12px 24px;background:#000;color:#fff;font-weight:600;font-size:14px;border-radius:0 0 8px 8px;text-decoration:none;transition:top 0.2s ease;" onfocus="this.style.top='0'" onblur="this.style.top='-100%'">
    Skip to main content
  </a>

  <!-- Sidebar Overlay (mobile) — must be OUTSIDE .erp-layout for proper z-index -->
  <div class="erp-sidebar-overlay" id="admin-sidebar-overlay" aria-hidden="true"></div>

  <div class="erp-layout">
    <% const activePath = typeof currentPath !== 'undefined' ? currentPath : ''; %>
    <!-- Sidebar -->
    <aside class="erp-sidebar" id="admin-sidebar">
      <script>
        (function () {
          if (window.innerWidth > 768 && localStorage.getItem('arox-sidebar-pinned') === 'true') {
            var sb = document.currentScript.parentElement;
            sb.classList.add('sidebar-pinned');
            if (sb.parentElement) sb.parentElement.classList.add('sidebar-pinned');
          }
        })();
      </script>
      <div class="erp-sidebar-header">
        <% const icon = typeof erpIcon === 'function' ? erpIcon : ((n) => `<i data-lucide="${n}"></i>`); %>
        <div class="sidebar-logo-container">
          <img src="/erp-assets/assets/logo/logo-dark.png" alt="AROX Logo" class="sidebar-logo-large" style="height: 52px; max-height: 56px; width: auto; max-width: 185px; object-fit: contain;">
        </div>
        <button id="sidebar-toggle-btn" class="sidebar-toggle-btn" title="Pin Sidebar Open">
          <%- icon('sidebar-layers') %>
        </button>
      </div>

      <nav class="erp-sidebar-nav">
        <!-- 0. Overview Dashboard -->
        <a href="/admin/dashboard" class="erp-nav-item <%= activePath === '/admin/dashboard' ? 'active' : '' %>">
          <%- icon('layout-dashboard') %>
          <span>Overview</span>
        </a>
        
        <!-- 1. EMPLOYEES (Submenu) -->
        <div class="erp-nav-section" style="display: flex; align-items: center; justify-content: space-between;">
          <span>Employees</span>
          <span style="font-size: 10px; font-weight: 700; padding: 1px 6px; background: #000; color: #fff; border-radius: 4px; letter-spacing: 0.05em;">TEAM</span>
        </div>
        <a href="/admin/employees" class="erp-nav-item <%= (activePath.startsWith('/admin/employees') || activePath.startsWith('/admin/users')) ? 'active' : '' %>">
          <%- icon('users-round') %>
          <span>Employees</span>
        </a>
        <a href="/admin/tasks" class="erp-nav-item <%= activePath.startsWith('/admin/tasks') ? 'active' : '' %>">
          <%- icon('check-square') %>
          <span>Tasks &amp; Proofs</span>
        </a>
        <a href="/admin/clients" class="erp-nav-item <%= activePath.startsWith('/admin/clients') ? 'active' : '' %>">
          <%- icon('building-2') %>
          <span>Clients</span>
        </a>
        <a href="/admin/reports" class="erp-nav-item <%= (activePath.startsWith('/admin/reports') || activePath.startsWith('/admin/performance')) ? 'active' : '' %>">
          <%- icon('bar-chart-3') %>
          <span>Reports</span>
        </a>

        <!-- 2. STUDENTS (Submenu) -->
        <div class="erp-nav-section">Students</div>
        <a href="/admin/students" class="erp-nav-item <%= activePath.startsWith('/admin/students') ? 'active' : '' %>">
          <%- icon('graduation-cap') %>
          <span>Students</span>
        </a>
        <a href="/admin/courses" class="erp-nav-item <%= activePath.startsWith('/admin/courses') ? 'active' : '' %>">
          <%- icon('book-open') %>
          <span>Courses &amp; Classes</span>
        </a>
        <a href="/admin/attendance" class="erp-nav-item <%= activePath.startsWith('/admin/attendance') ? 'active' : '' %>">
          <%- icon('calendar-check-2') %>
          <span>Daily Attendance</span>
        </a>
        <a href="/admin/internships" class="erp-nav-item <%= (activePath.startsWith('/admin/internships') || activePath.startsWith('/admin/registrations')) ? 'active' : '' %>">
          <%- icon('briefcase') %>
          <span>Internships</span>
        </a>

        <!-- 3. CERTIFICATE GENERATOR -->
        <div class="erp-nav-section">Certificates</div>
        <a href="/admin/generators/certificate" class="erp-nav-item <%= activePath.startsWith('/admin/generators/certificate') ? 'active' : '' %>">
          <%- icon('award') %>
          <span>Certificate Generator</span>
        </a>
        <a href="/admin/generators/offer-letter" class="erp-nav-item <%= activePath.startsWith('/admin/generators/offer-letter') ? 'active' : '' %>">
          <%- icon('file-text') %>
          <span>Offer Letters</span>
        </a>
        <a href="/admin/generators/attendance" class="erp-nav-item <%= activePath.startsWith('/admin/generators/attendance') ? 'active' : '' %>">
          <%- icon('clipboard-check') %>
          <span>Attendance Certs</span>
        </a>

        <!-- 4. REFERRAL -->
        <div class="erp-nav-section">Referral &amp; Growth</div>
        <a href="/admin/referrals" class="erp-nav-item <%= activePath.startsWith('/admin/referrals') ? 'active' : '' %>">
          <%- icon('ticket') %>
          <span>Referral</span>
        </a>

        <!-- 5. REVIEWS -->
        <a href="/admin/reviews" class="erp-nav-item <%= activePath.startsWith('/admin/reviews') ? 'active' : '' %>">
          <%- icon('star') %>
          <span>Reviews &amp; Ratings</span>
        </a>

        <!-- Finance / Payments Direct Link -->
        <a href="/admin/payments" class="erp-nav-item <%= activePath.startsWith('/admin/payments') ? 'active' : '' %>">
          <%- icon('wallet') %>
          <span>Payments</span>
        </a>

        <% 
          const adminUser = typeof user !== 'undefined' && user ? user : (typeof locals !== 'undefined' && locals.user ? locals.user : { first_name: 'Admin', last_name: 'User', role: 'admin', email: 'admin@arox.com' });
        %>

        <!-- 6. SETTINGS -->
        <% if (adminUser && (adminUser.role === 'admin' || adminUser.role === 'super_admin')) { %>
          <div class="erp-nav-section">Settings</div>
          <a href="/admin/settings" class="erp-nav-item <%= activePath.startsWith('/admin/settings') ? 'active' : '' %>">
            <%- icon('settings') %>
            <span>Settings</span>
          </a>
          <a href="/admin/profile" class="erp-nav-item <%= activePath.startsWith('/admin/profile') ? 'active' : '' %>">
            <%- icon('user-circle') %>
            <span>Admin Profile</span>
          </a>
        <% } %>
      </nav>

      <div style="padding: 14px 10px; border-top: 1px solid #E2E8F0;">
        <form action="/api/auth/logout" method="POST">
          <button type="submit" class="erp-nav-item" style="width: 100%; border: none; background: transparent; cursor: pointer; text-align: left; color: #DC2626;" title="Logout">
            <%- icon('log-out') %>
            <span>Logout</span>
          </button>
        </form>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="erp-main" id="admin-main-content" role="main" aria-label="Admin dashboard content">
      <!-- Topbar (Desktop: Breadcrumb; Mobile: Logo / Current Page + Profile Icon, No Hamburger) -->
      <header class="erp-topbar">
        <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
          <div class="erp-mobile-nav-brand">
            <a href="/admin/dashboard" class="erp-mobile-logo-link" title="AROX Admin Dashboard">
              <img src="/erp-assets/assets/logo/logo-dark.png" alt="AROX Logo">
            </a>
            <span class="erp-mobile-nav-sep">/</span>
            <span class="erp-mobile-current-page"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Overview' %></span>
          </div>
          <div class="erp-breadcrumb">
            <span style="color: var(--erp-text-secondary);">Admin</span>
            <i data-lucide="chevron-right" style="width: 14px; height: 14px; color: var(--erp-text-secondary);"></i>
            <span class="erp-breadcrumb-active"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Overview' %></span>
          </div>
        </div>

        <div class="erp-topbar-right">
          <!-- Apple Dynamic / Google Live Sync Capsule -->
          <div class="erp-notif-wrapper" data-user-id="<%= (typeof adminUser !== 'undefined' && adminUser && adminUser.id) ? adminUser.id : '' %>" data-user-role="<%= (typeof adminUser !== 'undefined' && adminUser && adminUser.role) ? adminUser.role : 'admin' %>">
            <button type="button" class="erp-notif-trigger" title="Notifications" aria-label="Notifications" aria-haspopup="true" aria-expanded="false">
              <i data-lucide="bell" style="width: 20px; height: 20px;"></i>
              <span class="erp-notif-dot" style="display: none;" aria-hidden="true"></span>
            </button>
            <div class="erp-notif-dropdown" aria-label="Notifications">
              <div class="erp-notif-header">
                <span>Notifications</span>
                <div style="display: flex; align-items: center; gap: 6px;">
                  <span class="erp-notif-status">0 Unwatched</span>
                  <button type="button" class="erp-notif-mark-all" style="display: none;">Clear</button>
                </div>
              </div>
              <div class="erp-notif-list">
                <div class="erp-notif-empty">No unwatched notifications.</div>
              </div>
            </div>
          </div>
          
          <div class="erp-profile-wrapper">
            <button type="button" class="erp-profile erp-profile-trigger" aria-haspopup="true" aria-expanded="false" title="Account Menu">
              <div class="erp-profile-info">
                <span style="font-size: 13px; font-weight: 600;"><%= adminUser.first_name || 'Admin' %> <%= adminUser.last_name || '' %></span>
                <span style="font-size: 11px; color: var(--erp-text-secondary); text-transform: capitalize;"><%= adminUser.role || 'Admin' %></span>
              </div>
              <div class="erp-avatar">
                <%= (adminUser.first_name || 'A').charAt(0).toUpperCase() %>
              </div>
            </button>
            <div class="erp-profile-dropdown">
              <div class="erp-profile-dropdown-header">
                <div style="font-size: 13px; font-weight: 700; color: #0F172A;"><%= adminUser.first_name || 'Admin' %> <%= adminUser.last_name || '' %></div>
                <div style="font-size: 11px; color: #64748B; text-transform: uppercase; letter-spacing: 0.04em;"><%= adminUser.role || 'Admin' %> Portal</div>
              </div>
              <a href="/admin/profile" class="erp-profile-dropdown-item">
                <%- icon('user-circle') %>
                <span>Admin Profile</span>
              </a>
              <a href="/admin/settings" class="erp-profile-dropdown-item">
                <%- icon('settings') %>
                <span>Settings</span>
              </a>
              <form action="/api/auth/logout" method="POST" style="margin-top: 4px;">
                <button type="submit" class="erp-profile-dropdown-item danger">
                  <%- icon('log-out') %>
                  <span>Logout</span>
                </button>
              </form>
            </div>
          </div>
        </div>
      </header>

      <!-- Page Content -->
      <div class="erp-content<%= activePath.startsWith('/admin/generators') ? ' erp-content-full' : '' %>">
        <%- body %>
      </div>

      <!-- Mobile App Bottom Navigation -->
      <nav class="erp-bottom-nav" aria-label="Admin Mobile Navigation">
        <a href="/admin/dashboard" class="erp-bottom-nav-item <%= activePath === '/admin/dashboard' ? 'active' : '' %>">
          <div class="nav-pill-box"><%- icon('layout-dashboard') %></div>
          <span>Home</span>
        </a>
        <a href="/admin/students" class="erp-bottom-nav-item <%= activePath.startsWith('/admin/students') ? 'active' : '' %>">
          <div class="nav-pill-box"><%- icon('graduation-cap') %></div>
          <span>Students</span>
        </a>
        <a href="/admin/attendance" class="erp-bottom-nav-item <%= activePath.startsWith('/admin/attendance') ? 'active' : '' %>">
          <div class="nav-pill-box"><%- icon('calendar-check-2') %></div>
          <span>Attend</span>
        </a>
        <a href="/admin/payments" class="erp-bottom-nav-item <%= activePath.startsWith('/admin/payments') ? 'active' : '' %>">
          <div class="nav-pill-box"><%- icon('wallet') %></div>
          <span>Payments</span>
        </a>
        <button type="button" id="admin-bottom-menu-btn" class="erp-bottom-nav-item" aria-label="All Admin Modules">
          <div class="nav-pill-box"><%- icon('menu-more') %></div>
          <span>More</span>
        </button>
      </nav>
    </main>
  </div>

  <script src="/erp-assets/js/erp-shell.js?v=2"></script>

  <!-- Triangular Sync Client -->
  <script src="/erp-assets/js/sync-client.js"></script>
  <!-- Catalogue Filters & View Switcher -->
  <script src="/erp-assets/js/catalogue-controller.js"></script>
  <!-- SheetJS & Selected Details Excel Exporter -->
  <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
  <script src="/erp-assets/js/excel-export.js?v=4"></script>

  <%- script %>
</body>
</html>