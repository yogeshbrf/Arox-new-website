<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="mobile-web-app-capable" content="yes">
  <title><%= typeof title !== 'undefined' ? title : 'Employee Workspace | AROX ERP' %></title>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="AROX ERP Employee Portal">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Employee Workspace | AROX ERP' %>">
  <meta property="og:description" content="Client management, lead tracking, follow-ups, and performance dashboard for AROX Tech staff.">

  <!-- SEO -->
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#000000">

  <!-- Google Fonts: Montserrat -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Montserrat', 'sans-serif'] },
          colors: {
            primary: { DEFAULT: '#000000', light: '#334155', dark: '#000000' }
          }
        }
      }
    }
  </script>

  <!-- Chart.js for Dashboards -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- Lucide Icons + AROX Duotone Icon System -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="/erp-assets/js/arox-icons.js?v=1"></script>

  <!-- Multi-Panel Simultaneous Session Context -->
  <script>
    (function() {
      const origFetch = window.fetch;
      window.fetch = function(url, options = {}) {
        options = options || {};
        options.headers = options.headers || {};
        if (options.headers instanceof Headers) {
          options.headers.set('X-Role', 'employee');
        } else {
          options.headers['X-Role'] = 'employee';
        }
        return origFetch(url, options);
      };
    })();
  </script>

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/erp-assets/css/erp-theme.css?v=4.1">

  <style>
    @media (max-width: 768px) {
      .sync-status-capsule,
      #employee-sync-capsule,
      .erp-topbar-right .sync-status-capsule,
      .erp-topbar-right .erp-quick-add {
        display: none !important;
      }
    }
  </style>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/erp-assets/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">

  <%- typeof style !== 'undefined' ? style : '' %>
</head>
<body class="erp-body">

  <!-- Skip to main content -->
  <a href="#employee-main-content" style="position:absolute;top:-100%;left:16px;z-index:99999;padding:12px 24px;background:#000;color:#fff;font-weight:600;font-size:14px;border-radius:0 0 8px 8px;text-decoration:none;transition:top 0.2s ease;" onfocus="this.style.top='0'" onblur="this.style.top='-100%'">
    Skip to main content
  </a>

  <!-- Sidebar Overlay (mobile) -->
  <div class="erp-sidebar-overlay" id="employee-sidebar-overlay" aria-hidden="true"></div>

  <div class="erp-layout">
    <% const activePath = typeof currentPath !== 'undefined' ? currentPath : ''; %>
    <!-- Sidebar -->
    <aside class="erp-sidebar" id="employee-sidebar">
      <script>
        (function () {
          if (window.innerWidth > 768 && localStorage.getItem('arox-sidebar-pinned') === 'true') {
            var sb = document.currentScript.parentElement;
            sb.classList.add('sidebar-pinned');
            if (sb.parentElement) sb.parentElement.classList.add('sidebar-pinned');
          }
        })();
      </script>
      <div class="erp-sidebar-header">
        <% const icon = typeof erpIcon === 'function' ? erpIcon : ((n) => `<i data-lucide="${n}"></i>`); %>
        <div class="sidebar-logo-container">
          <img src="/erp-assets/assets/logo/logo-dark.png" alt="AROX Logo" class="sidebar-logo-large" style="height: 52px; max-height: 56px; width: auto; max-width: 185px; object-fit: contain;">
        </div>
        <button id="employee-sidebar-toggle-btn" class="sidebar-toggle-btn" title="Pin Sidebar Open">
          <%- icon('sidebar-layers') %>
        </button>
      </div>

      <nav class="erp-sidebar-nav">
        <!-- 0. Overview Dashboard -->
        <a href="/employee/dashboard" class="erp-nav-item <%= activePath === '/employee/dashboard' ? 'active' : '' %>">
          <%- icon('layout-dashboard') %>
          <span>Overview</span>
        </a>

        <!-- 1. LEADS & REFERRED STUDENTS -->
        <div class="erp-nav-section" style="display: flex; align-items: center; justify-content: space-between;">
          <span>Leads &amp; Referrals</span>
          <span style="font-size: 10px; font-weight: 700; padding: 1px 6px; background: #000; color: #fff; border-radius: 4px; letter-spacing: 0.05em;">CRM</span>
        </div>
        <a href="/employee/students" class="erp-nav-item <%= activePath.startsWith('/employee/students') ? 'active' : '' %>">
          <%- icon('users') %>
          <span>Referred Students</span>
        </a>
        <a href="/employee/internships" class="erp-nav-item <%= (activePath.startsWith('/employee/internships') || activePath.startsWith('/employee/leads/internships')) ? 'active' : '' %>">
          <%- icon('graduation-cap') %>
          <span>Referred Internships</span>
        </a>
        <a href="/employee/clients" class="erp-nav-item <%= (activePath.startsWith('/employee/clients') || activePath.startsWith('/employee/leads/clients')) ? 'active' : '' %>">
          <%- icon('building-2') %>
          <span>Clients</span>
        </a>
        <a href="/employee/leads" class="erp-nav-item <%= (activePath === '/employee/leads') ? 'active' : '' %>">
          <%- icon('target') %>
          <span>Sales Pipeline</span>
        </a>
        <a href="/employee/tasks" class="erp-nav-item <%= activePath.startsWith('/employee/tasks') ? 'active' : '' %>">
          <%- icon('check-square') %>
          <span>Tasks &amp; Proofs</span>
        </a>

        <!-- 2. CALL REPORTS -->
        <div class="erp-nav-section">Communication</div>
        <a href="/employee/call-reports" class="erp-nav-item <%= activePath.startsWith('/employee/call-reports') ? 'active' : '' %>">
          <%- icon('phone-call') %>
          <span>Call Reports</span>
        </a>

        <!-- 3. CONTACTS -->
        <a href="/employee/contacts" class="erp-nav-item <%= activePath.startsWith('/employee/contacts') ? 'active' : '' %>">
          <%- icon('contact-2') %>
          <span>Contacts Directory</span>
        </a>

        <!-- 4. REVIEWS AND RATING -->
        <a href="/employee/reviews" class="erp-nav-item <%= activePath.startsWith('/employee/reviews') ? 'active' : '' %>">
          <%- icon('star') %>
          <span>Reviews &amp; Ratings</span>
        </a>

        <% 
          const empUser = typeof user !== 'undefined' && user ? user : (typeof locals !== 'undefined' && locals.user ? locals.user : { first_name: 'Employee', last_name: 'Staff', role: 'employee', email: 'employee@arox.com' });
        %>

        <!-- 5. SETTINGS -->
        <div class="erp-nav-section">Account</div>
        <a href="/employee/settings" class="erp-nav-item <%= (activePath.startsWith('/employee/settings') || activePath.startsWith('/employee/profile')) ? 'active' : '' %>">
          <%- icon('settings') %>
          <span>Settings &amp; Profile</span>
        </a>

        <% if (['admin', 'super_admin'].includes(empUser.role)) { %>
          <div class="erp-nav-section">Admin Switcher</div>
          <a href="/admin/dashboard" class="erp-nav-item" style="color: #2563EB;">
            <%- icon('shield') %>
            <span>Switch to Admin ERP</span>
          </a>
        <% } %>
      </nav>

      <div style="padding: 14px 10px; border-top: 1px solid #E2E8F0;">
        <form action="/api/auth/logout" method="POST">
          <button type="submit" class="erp-nav-item" style="width: 100%; border: none; background: transparent; cursor: pointer; text-align: left; color: #DC2626;" title="Logout">
            <%- icon('log-out') %>
            <span>Logout</span>
          </button>
        </form>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="erp-main" id="employee-main-content" role="main" aria-label="Employee portal content">
      <!-- Topbar (Desktop: Breadcrumb; Mobile: Logo / Current Page + Profile Icon, No Hamburger) -->
      <header class="erp-topbar">
        <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
          <div class="erp-mobile-nav-brand">
            <a href="/employee/dashboard" class="erp-mobile-logo-link" title="AROX Employee Dashboard">
              <img src="/erp-assets/assets/logo/logo-dark.png" alt="AROX Logo">
            </a>
            <span class="erp-mobile-nav-sep">/</span>
            <span class="erp-mobile-current-page"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></span>
          </div>
          <div class="erp-breadcrumb">
            <span style="color: var(--erp-text-secondary);">Employee</span>
            <i data-lucide="chevron-right" style="width: 14px; height: 14px; color: var(--erp-text-secondary);"></i>
            <span class="erp-breadcrumb-active"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></span>
          </div>
        </div>

        <div class="erp-topbar-right">
          <!-- Apple Dynamic / Google Live Sync Capsule -->
          <div class="sync-status-capsule hidden md:inline-flex" id="employee-sync-capsule" title="Triangular Sync Online across all panels">
            <span class="sync-dot"></span>
            <span>Live Sync</span>
          </div>

          <!-- Quick Add Button -->
          <div class="erp-quick-add hidden sm:flex items-center gap-2">
            <a href="/employee/leads" class="erp-btn erp-btn-sm erp-btn-primary" style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; font-size: 12px; font-weight: 600; border-radius: 6px; background: #000; color: #fff;">
              <i data-lucide="plus" style="width: 14px; height: 14px;"></i>
              <span>New Lead</span>
            </a>
          </div>

          <div class="erp-profile-wrapper">
            <button type="button" class="erp-profile erp-profile-trigger" aria-haspopup="true" aria-expanded="false" title="Account Menu">
              <div class="erp-profile-info">
                <span style="font-size: 13px; font-weight: 600;"><%= empUser.first_name || 'Staff' %> <%= empUser.last_name || '' %></span>
                <span style="font-size: 11px; color: var(--erp-text-secondary); text-transform: capitalize;"><%= empUser.role || 'Employee' %></span>
              </div>
              <div class="erp-avatar" style="background: #000000; color: #ffffff;">
                <%= (empUser.first_name || 'E').charAt(0).toUpperCase() %>
              </div>
            </button>
            <div class="erp-profile-dropdown">
              <div class="erp-profile-dropdown-header">
                <div style="font-size: 13px; font-weight: 700; color: #0F172A;"><%= empUser.first_name || 'Staff' %> <%= empUser.last_name || '' %></div>
                <div style="font-size: 11px; color: #64748B; text-transform: uppercase; letter-spacing: 0.04em;"><%= empUser.role || 'Employee' %> Portal</div>
              </div>
              <a href="/employee/profile" class="erp-profile-dropdown-item">
                <%- icon('user-circle') %>
                <span>My Profile &amp; Code</span>
              </a>
              <a href="/employee/settings" class="erp-profile-dropdown-item">
                <%- icon('settings') %>
                <span>Settings</span>
              </a>
              <form action="/api/auth/logout" method="POST" style="margin-top: 4px;">
                <button type="submit" class="erp-profile-dropdown-item danger">
                  <%- icon('log-out') %>
                  <span>Logout</span>
                </button>
              </form>
            </div>
          </div>
        </div>
      </header>

      <!-- Page Content -->
      <div class="erp-content">
        <%- body %>
      </div>

      <!-- Mobile App Bottom Navigation -->
      <nav class="erp-bottom-nav" aria-label="Employee Mobile Navigation">
        <a href="/employee/dashboard" class="erp-bottom-nav-item <%= activePath === '/employee/dashboard' ? 'active' : '' %>">
          <div class="nav-pill-box"><%- icon('layout-dashboard') %></div>
          <span>Home</span>
        </a>
        <a href="/employee/students" class="erp-bottom-nav-item <%= activePath.startsWith('/employee/students') ? 'active' : '' %>">
          <div class="nav-pill-box"><%- icon('users') %></div>
          <span>Referred</span>
        </a>
        <a href="/employee/leads" class="erp-bottom-nav-item <%= activePath === '/employee/leads' ? 'active' : '' %>">
          <div class="nav-pill-box"><%- icon('target') %></div>
          <span>Pipeline</span>
        </a>
        <a href="/employee/tasks" class="erp-bottom-nav-item <%= activePath.startsWith('/employee/tasks') ? 'active' : '' %>">
          <div class="nav-pill-box"><%- icon('check-square') %></div>
          <span>Tasks</span>
        </a>
        <button type="button" id="employee-bottom-menu-btn" class="erp-bottom-nav-item" aria-label="All Employee Modules">
          <div class="nav-pill-box"><%- icon('menu-more') %></div>
          <span>More</span>
        </button>
      </nav>
    </main>
  </div>

  <script src="/erp-assets/js/erp-shell.js?v=2"></script>

  <!-- Triangular Sync Client -->
  <script src="/erp-assets/js/sync-client.js"></script>
  <!-- Catalogue Filters & View Switcher -->
  <script src="/erp-assets/js/catalogue-controller.js"></script>
  <!-- SheetJS & Selected Details Excel Exporter -->
  <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
  <script src="/erp-assets/js/excel-export.js?v=4"></script>

  <%- typeof script !== 'undefined' ? script : '' %>
</body>
</html>
