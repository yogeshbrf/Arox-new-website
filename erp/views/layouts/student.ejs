<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="mobile-web-app-capable" content="yes">
  <title>
    <%= typeof title !== 'undefined' ? title : 'Student Portal | AROX ERP' %>
  </title>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="AROX Tech Student Portal">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Student Portal | AROX ERP' %>">
  <meta property="og:description" content="Access your enrolled courses, certificates, payments, and attendance records on the AROX Tech Student Portal.">
  <meta property="og:url" content="<%= org.website %><%= currentPath %>">
  <meta property="og:image" content="<%= org.website %>/assets/hero/home_light.png">
  <meta property="og:image:alt" content="AROX Tech Student Portal">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'Student Portal | AROX ERP' %>">
  <meta name="twitter:description" content="Access your enrolled courses, certificates, payments, and attendance records on the AROX Tech Student Portal.">

  <!-- SEO -->
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#155EEF">

  <!-- Google Fonts: Montserrat (unified brand font) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Montserrat', 'sans-serif'] },
          colors: {
            primary: { DEFAULT: '#155EEF', light: '#3B82F6', dark: '#0F4EBB' },
          }
        }
      }
    }
  </script>

  <!-- Chart.js for Dashboards -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- Lucide Icons + AROX Duotone Icon System -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="/erp-assets/js/arox-icons.js?v=1"></script>

  <!-- Multi-Panel Simultaneous Session Context -->
  <script>
    (function() {
      const origFetch = window.fetch;
      window.fetch = function(url, options = {}) {
        options = options || {};
        options.headers = options.headers || {};
        if (options.headers instanceof Headers) {
          options.headers.set('X-Role', 'student');
        } else {
          options.headers['X-Role'] = 'student';
        }
        return origFetch(url, options);
      };
    })();
  </script>

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/erp-assets/css/erp-theme.css?v=4.1">

  <style>
    @media (max-width: 768px) {
      .sync-status-capsule,
      #student-sync-capsule,
      .erp-topbar-right .sync-status-capsule,
      .erp-topbar-right button[title="Notifications"] {
        display: none !important;
      }
    }
  </style>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/erp-assets/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/erp-assets/assets/logo/logo-dark.png">

  <%- style %>
</head>
<body class="erp-body">

  <!-- Skip to content (accessibility) -->
  <a href="#student-main-content" style="position:absolute;top:-100%;left:16px;z-index:99999;padding:12px 24px;background:#000;color:#fff;font-weight:600;font-size:14px;border-radius:0 0 8px 8px;text-decoration:none;transition:top 0.2s ease;" onfocus="this.style.top='0'" onblur="this.style.top='-100%'">
    Skip to main content
  </a>

  <!-- Sidebar Overlay (mobile) -->
  <div class="erp-sidebar-overlay" id="student-sidebar-overlay" aria-hidden="true"></div>

  <div class="erp-layout">
    <% const activePath = typeof currentPath !== 'undefined' ? currentPath : ''; %>
    <!-- Sidebar -->
    <aside class="erp-sidebar" id="student-sidebar">
      <script>
        (function () {
          if (window.innerWidth > 768 && localStorage.getItem('arox-sidebar-pinned') === 'true') {
            var sb = document.currentScript.parentElement;
            sb.classList.add('sidebar-pinned');
            if (sb.parentElement) sb.parentElement.classList.add('sidebar-pinned');
          }
        })();
      </script>
      <div class="erp-sidebar-header">
        <% const icon = typeof erpIcon === 'function' ? erpIcon : ((n) => `<i data-lucide="${n}"></i>`); %>
        <div class="sidebar-logo-container">
          <img src="/erp-assets/assets/logo/logo-dark.png" alt="AROX Logo" class="sidebar-logo-large" style="height: 52px; max-height: 56px; width: auto; max-width: 185px; object-fit: contain;">
        </div>
        <button id="sidebar-toggle-btn" class="sidebar-toggle-btn" title="Pin Sidebar Open">
          <%- icon('sidebar-layers') %>
        </button>
      </div>

      <nav class="erp-sidebar-nav">
        <!-- 0. Overview Dashboard -->
        <a href="/student/dashboard" class="erp-nav-item <%= activePath === '/student/dashboard' ? 'active' : '' %>">
          <%- icon('layout-dashboard') %>
          <span>Overview</span>
        </a>

        <!-- 1. My Course -->
        <a href="/student/courses" class="erp-nav-item <%= activePath.startsWith('/student/courses') ? 'active' : '' %>">
          <%- icon('book-open') %>
          <span>My Course</span>
        </a>

        <!-- 2. Payment -->
        <a href="/student/payments" class="erp-nav-item <%= activePath.startsWith('/student/payments') ? 'active' : '' %>">
          <%- icon('wallet') %>
          <span>Payment</span>
        </a>

        <!-- 3. Attendance -->
        <a href="/student/attendance" class="erp-nav-item <%= activePath.startsWith('/student/attendance') ? 'active' : '' %>">
          <%- icon('calendar-check-2') %>
          <span>Attendance</span>
        </a>

        <!-- 4. Reviews and Rating -->
        <a href="/student/reviews" class="erp-nav-item <%= activePath.startsWith('/student/reviews') ? 'active' : '' %>">
          <%- icon('star') %>
          <span>Reviews &amp; Rating</span>
        </a>
        
        <!-- 5. Settings -->
        <div class="erp-nav-section">Account</div>
        <a href="/student/settings" class="erp-nav-item <%= (activePath.startsWith('/student/settings') || activePath.startsWith('/student/profile')) ? 'active' : '' %>">
          <%- icon('settings') %>
          <span>Settings</span>
        </a>
      </nav>

      <div style="padding: 14px 10px; border-top: 1px solid #E2E8F0;">
        <form action="/api/auth/logout" method="POST" id="logoutForm">
          <button type="submit" class="erp-nav-item" style="width: 100%; border: none; background: transparent; cursor: pointer; text-align: left; color: #DC2626;" title="Logout">
            <%- icon('log-out') %>
            <span>Logout</span>
          </button>
        </form>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="erp-main" id="student-main-content" role="main" aria-label="Student portal content">
      <% const stuDisplayName = (typeof student !== 'undefined' && student) ? `${student.first_name} ${student.last_name}` : ((typeof user !== 'undefined' && user && user.email) ? user.email.split('@')[0] : 'Student'); %>
      <!-- Topbar (Desktop: Breadcrumb; Mobile: Logo / Current Page + Profile Icon, No Hamburger) -->
      <header class="erp-topbar">
        <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
          <div class="erp-mobile-nav-brand">
            <a href="/student/dashboard" class="erp-mobile-logo-link" title="AROX Student Dashboard">
              <img src="/erp-assets/assets/logo/logo-dark.png" alt="AROX Logo">
            </a>
            <span class="erp-mobile-nav-sep">/</span>
            <span class="erp-mobile-current-page"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Overview' %></span>
          </div>
          <div class="erp-breadcrumb">
            <span style="color: var(--erp-text-secondary);">Portal</span>
            <i data-lucide="chevron-right" style="width: 14px; height: 14px; color: var(--erp-text-secondary);"></i>
            <span class="erp-breadcrumb-active"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Overview' %></span>
          </div>
        </div>

        <div class="erp-topbar-right">
          <!-- Apple Dynamic / Google Live Sync Capsule -->
          <div class="sync-status-capsule hidden md:inline-flex" id="student-sync-capsule" title="Triangular Sync Online across all panels">
            <span class="sync-dot"></span>
            <span>Live Sync</span>
          </div>

          <div class="erp-notif-wrapper hidden md:inline-flex" style="position: relative;">
            <button type="button" class="erp-notif-trigger" style="background: transparent; border: none; cursor: pointer; color: var(--erp-text-secondary); padding: 6px; border-radius: 8px;" title="Notifications" aria-haspopup="true" aria-expanded="false">
              <i data-lucide="bell" style="width: 20px; height: 20px;"></i>
            </button>
            <div class="erp-notif-dropdown" aria-label="Live ERP Notifications">
              <div class="erp-notif-header">
                <span>Live ERP Activity</span>
                <span class="erp-notif-status">Synced</span>
              </div>
              <div class="erp-notif-list">
                <div class="erp-notif-empty">Loading notifications...</div>
              </div>
            </div>
          </div>

          <div class="erp-profile-wrapper">
            <button type="button" class="erp-profile erp-profile-trigger" aria-haspopup="true" aria-expanded="false" title="Account Menu">
              <div class="erp-profile-info">
                <span style="font-size: 13px; font-weight: 600;"><%= stuDisplayName %></span>
                <span style="font-size: 11px; color: var(--erp-text-secondary);">Student</span>
              </div>
              <div class="erp-avatar">
                <% if (typeof student !== 'undefined' && student && student.photo) { %>
                  <img src="<%= student.photo %>" alt="Avatar" style="width:100%; height:100%; object-fit:cover; border-radius:50%;">
                <% } else { %>
                  <%= (typeof user !== 'undefined' && user && user.email) ? user.email.charAt(0).toUpperCase() : 'S' %>
                <% } %>
              </div>
            </button>
            <div class="erp-profile-dropdown">
              <div class="erp-profile-dropdown-header">
                <div style="font-size: 13px; font-weight: 700; color: #0F172A;"><%= stuDisplayName %></div>
                <div style="font-size: 11px; color: #64748B; text-transform: uppercase; letter-spacing: 0.04em;">Student Portal</div>
              </div>
              <a href="/student/settings" class="erp-profile-dropdown-item">
                <%- icon('settings') %>
                <span>Profile &amp; Settings</span>
              </a>
              <a href="/student/payments" class="erp-profile-dropdown-item">
                <%- icon('wallet') %>
                <span>Payments &amp; UPI QR</span>
              </a>
              <form action="/api/auth/logout" method="POST" style="margin-top: 4px;">
                <button type="submit" class="erp-profile-dropdown-item danger">
                  <%- icon('log-out') %>
                  <span>Logout</span>
                </button>
              </form>
            </div>
          </div>
        </div>
      </header>

      <!-- Page Content -->
      <div class="erp-content">
        <%- body %>
      </div>

      <!-- Mobile App Bottom Navigation -->
      <nav class="erp-bottom-nav" aria-label="Student Mobile Navigation">
        <a href="/student/dashboard" class="erp-bottom-nav-item <%= activePath === '/student/dashboard' ? 'active' : '' %>">
          <div class="nav-pill-box"><%- icon('layout-dashboard') %></div>
          <span>Home</span>
        </a>
        <a href="/student/courses" class="erp-bottom-nav-item <%= activePath.startsWith('/student/courses') ? 'active' : '' %>">
          <div class="nav-pill-box"><%- icon('book-open') %></div>
          <span>Course</span>
        </a>
        <a href="/student/payments" class="erp-bottom-nav-item <%= activePath.startsWith('/student/payments') ? 'active' : '' %>">
          <div class="nav-pill-box"><%- icon('wallet') %></div>
          <span>Pay</span>
        </a>
        <a href="/student/attendance" class="erp-bottom-nav-item <%= activePath.startsWith('/student/attendance') ? 'active' : '' %>">
          <div class="nav-pill-box"><%- icon('calendar-check-2') %></div>
          <span>Attend</span>
        </a>
        <button type="button" id="student-bottom-menu-btn" class="erp-bottom-nav-item" aria-label="All Student Modules">
          <div class="nav-pill-box"><%- icon('menu-more') %></div>
          <span>More</span>
        </button>
      </nav>
    </main>
  </div>

  <script src="/erp-assets/js/erp-shell.js?v=2"></script>

  <!-- Triangular Sync Client -->
  <script src="/erp-assets/js/sync-client.js"></script>
  <!-- Catalogue Filters & View Switcher -->
  <script src="/erp-assets/js/catalogue-controller.js"></script>

  <%- script %>
</body>
</html>