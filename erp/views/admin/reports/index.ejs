<div class="erp-h1" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>
    <div style="font-size: 26px; font-weight: 750;">Employee Performance Reports</div>
    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 4px;">
      Visual reports based on tasks, client calls, sales leads, and conversions with date and employee filters.
    </div>
  </div>
</div>

<!-- Filter Bar -->
<div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 18px 20px; border-radius: 12px; margin-bottom: 24px;">
  <form method="GET" action="/admin/reports" style="display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-end;">
    <!-- Employee Filter -->
    <div style="flex: 1; min-width: 200px;">
      <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748B; margin-bottom: 4px;">Employee</label>
      <select name="employee_id" style="width: 100%; height: 40px; padding: 0 12px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 13px; background: #fff;">
        <option value="">All Employees & Staff</option>
        <% if (employees && employees.length > 0) { %>
          <% employees.forEach(emp => { %>
            <option value="<%= emp.id %>" <%= filters.employee_id == emp.id ? 'selected' : '' %>>
              <%= emp.first_name %> <%= emp.last_name %> (<%= emp.designation || 'Staff' %>)
            </option>
          <% }); %>
        <% } %>
      </select>
    </div>

    <!-- Start Date -->
    <div style="min-width: 150px;">
      <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748B; margin-bottom: 4px;">From Date</label>
      <input type="date" name="startDate" value="<%= filters.startDate || '' %>" style="width: 100%; height: 40px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 13px;">
    </div>

    <!-- End Date -->
    <div style="min-width: 150px;">
      <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748B; margin-bottom: 4px;">To Date</label>
      <input type="date" name="endDate" value="<%= filters.endDate || '' %>" style="width: 100%; height: 40px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 13px;">
    </div>

    <div style="display: flex; gap: 8px;">
      <button type="submit" class="erp-btn" style="height: 40px; padding: 0 18px; background: #000; color: #fff; font-weight: 600; font-size: 13px; border-radius: 8px; border: none; cursor: pointer;">
        Apply Filters
      </button>
      <a href="/admin/reports" class="erp-btn erp-btn-secondary" style="height: 40px; padding: 0 14px; border: 1px solid #CBD5E1; font-weight: 600; font-size: 13px; border-radius: 8px; display: inline-flex; align-items: center; text-decoration: none; color: #000;">
        Reset
      </a>
    </div>
  </form>
</div>

<!-- KPI Metrics Summary Cards -->
<div class="erp-grid-4" style="margin-bottom: 24px;">
  <!-- Total Calls Logged -->
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="phone-call"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Call Reports Logged</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= callStats.totalCalls %></div>
    <div class="erp-p" style="margin-top: 6px; color: #16A34A; font-weight: 600; font-size: 12px;">
      <%= callStats.connected %> Connected • <%= callStats.converted %> Converted
    </div>
  </div>

  <!-- Tasks Completion -->
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="check-square"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Tasks Completed</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= taskStats.completed %> / <%= taskStats.total %></div>
    <div class="erp-p" style="margin-top: 6px; color: #000000; font-weight: 600; font-size: 12px;">
      <%= taskStats.total > 0 ? Math.round((taskStats.completed / taskStats.total) * 100) : 0 %>% Completion Rate
    </div>
  </div>

  <!-- Deals Won -->
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="target"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Deals Won</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= leadStats.won %></div>
    <div class="erp-p" style="margin-top: 6px; color: #64748B; font-size: 12px;"><%= leadStats.total %> total pipeline deals</div>
  </div>

  <!-- Conversion Rate -->
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="trending-up"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Lead Conversion</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= leadStats.conversionRate %>%</div>
    <div class="erp-p" style="margin-top: 6px; color: #16A34A; font-weight: 600; font-size: 12px;">Lead to Won efficiency</div>
  </div>
</div>

<!-- Visual Reports Charts (2 Columns) -->
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 28px;" class="reports-charts-wrapper">
  <!-- Tasks Performance Chart -->
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <h3 style="margin: 0 0 16px 0; font-size: 16px; font-weight: 700; color: #000;">Tasks Status Breakdown</h3>
    <div style="height: 240px; position: relative;">
      <canvas id="tasksChart"></canvas>
    </div>
  </div>

  <!-- Call Outcomes Chart -->
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <h3 style="margin: 0 0 16px 0; font-size: 16px; font-weight: 700; color: #000;">Call Outcomes Distribution</h3>
    <div style="height: 240px; position: relative;">
      <canvas id="callsChart"></canvas>
    </div>
  </div>
</div>

<!-- Detailed Call Reports Log (Feeds Admin > Employees > Reports) -->
<div class="erp-card" style="padding: 0; background: #FFFFFF; border: 1px solid #E2E8F0; overflow: hidden; margin-bottom: 24px;">
  <div style="padding: 18px 24px; border-bottom: 1px solid #E2E8F0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
    <div>
      <h3 style="margin: 0; font-size: 16px; font-weight: 700; color: #000;">
        Logged Call Reports <%= selectedEmployee ? `for ${selectedEmployee.first_name} ${selectedEmployee.last_name}` : '' %>
      </h3>
      <p style="margin: 2px 0 0; font-size: 12px; color: #64748B;">Synchronized in real-time from employee submissions.</p>
    </div>
  </div>

  <div class="erp-table-container" style="border: none; border-radius: 0; margin-bottom: 0;">
    <table class="erp-table">
      <thead>
        <tr>
          <th style="color: #000;">Date & Time</th>
          <th style="color: #000;">Employee</th>
          <th style="color: #000;">Contact Person</th>
          <th style="color: #000;">Contact Type</th>
          <th style="color: #000;">Outcome</th>
          <th style="color: #000;">Notes & Observations</th>
          <th style="color: #000;">Next Follow-up</th>
        </tr>
      </thead>
      <tbody>
        <% if (callReports && callReports.length > 0) { %>
          <% callReports.forEach(call => { %>
            <tr>
              <td>
                <div style="font-weight: 600; font-size: 12px; color: #000;">
                  <%= new Date(call.call_date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                </div>
                <div style="font-size: 11px; color: #64748B;">
                  <%= new Date(call.call_date).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %>
                </div>
              </td>
              <td>
                <div style="font-weight: 600; color: #000;"><%= call.employee_first_name %> <%= call.employee_last_name %></div>
                <div style="font-size: 11px; color: #64748B;"><%= call.employee_email %></div>
              </td>
              <td>
                <div style="font-weight: 700; color: #000;"><%= call.contact_name %></div>
                <div style="font-size: 11px; color: #64748B;"><%= call.contact_phone || call.contact_email || '—' %></div>
              </td>
              <td>
                <span style="font-size: 11px; text-transform: uppercase; font-weight: 700; padding: 2px 6px; border-radius: 4px; background: <%= call.contact_type === 'student' ? '#E0E7FF; color: #3730A3;' : '#DCFCE7; color: #166534;' %>">
                  <%= call.contact_type %>
                </span>
              </td>
              <td>
                <% if (call.outcome === 'converted') { %>
                  <span style="display: inline-block; padding: 2px 8px; background: #000; color: #fff; border-radius: 99px; font-size: 11px; font-weight: 600;">Converted</span>
                <% } else if (call.outcome === 'connected' || call.outcome === 'interested') { %>
                  <span style="display: inline-block; padding: 2px 8px; background: #DCFCE7; color: #166534; border-radius: 99px; font-size: 11px; font-weight: 600;"><%= call.outcome %></span>
                <% } else { %>
                  <span style="display: inline-block; padding: 2px 8px; background: #F1F5F9; color: #000; border-radius: 99px; font-size: 11px; font-weight: 600;"><%= call.outcome %></span>
                <% } %>
              </td>
              <td style="max-width: 250px; font-size: 12px; color: #334155;">
                <%= call.notes || 'No notes logged.' %>
              </td>
              <td>
                <% if (call.next_followup) { %>
                  <span style="font-size: 12px; font-weight: 600; color: #000;">
                    <%= new Date(call.next_followup).toLocaleDateString('en-IN') %>
                  </span>
                <% } else { %>
                  <span style="color: #94A3B8; font-size: 12px;">None scheduled</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align: center; padding: 36px; color: #64748B;">No call reports found matching current filters.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // 1. Tasks Chart
    const tasksCtx = document.getElementById('tasksChart');
    if (tasksCtx && window.Chart) {
      new Chart(tasksCtx, {
        type: 'doughnut',
        data: {
          labels: ['Completed', 'In Progress', 'To-Do'],
          datasets: [{
            data: [<%= taskStats.completed %>, <%= taskStats.in_progress %>, <%= taskStats.todo %>],
            backgroundColor: ['#000000', '#64748B', '#E2E8F0'],
            borderWidth: 2,
            borderColor: '#FFFFFF'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' }
          }
        }
      });
    }

    // 2. Call Outcomes Chart
    const callsCtx = document.getElementById('callsChart');
    if (callsCtx && window.Chart) {
      new Chart(callsCtx, {
        type: 'bar',
        data: {
          labels: ['Connected', 'Converted', 'Interested', 'Follow-up Needed', 'Busy / Failed'],
          datasets: [{
            label: 'Total Calls',
            data: [
              <%= callStats.connected %>,
              <%= callStats.converted %>,
              <%= callStats.interested %>,
              <%= callStats.followUpNeeded %>,
              <%= callStats.failed %>
            ],
            backgroundColor: ['#000000', '#16A34A', '#3B82F6', '#F59E0B', '#EF4444'],
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: { beginAtZero: true, ticks: { precision: 0 } }
          },
          plugins: {
            legend: { display: false }
          }
        }
      });
    }
  });
</script>

