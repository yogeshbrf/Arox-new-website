<div class="erp-h1" style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>
    <div style="font-size: 24px; font-weight: 750;">Students Directory</div>
    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 2px;">Manage student cohort, educational backgrounds, enrolled programs and full records</div>
  </div>
  <button onclick="openCreateStudentModal()" class="erp-btn erp-btn-primary" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #000; color: #fff; border-radius: 8px; font-weight: 600; font-size: 13px; border: none; cursor: pointer;">
    <i data-lucide="user-plus" style="width: 16px; height: 16px;"></i> Add New Student
  </button>
</div>

<!-- Interactive Catalogue Filter Toolbar (Apple + Google Material 3) -->
<!-- Summary Metric Cards -->
<%
  const totalStudents = students ? students.length : 0;
  const activeStudents = students ? students.filter(s => (s.status || 'active').toLowerCase() === 'active').length : 0;
  const enrolledStudents = students ? students.filter(s => Number(s.course_count || 0) > 0).length : 0;
  const collegesCount = students ? new Set(students.map(s => (s.college_name || s.college || '').trim()).filter(Boolean)).size : 0;
%>
<div class="erp-grid-4" style="margin-bottom: 24px;">
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="users"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Total Students</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= totalStudents %></div>
    <div class="erp-p" style="margin-top: 6px; color: #64748B; font-size: 12px;">Registered cohort</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="user-check"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Active Learners</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= activeStudents %></div>
    <div class="erp-p" style="margin-top: 6px; color: #16A34A; font-weight: 600; font-size: 12px;">In good standing</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="graduation-cap"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Enrolled in Programs</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= enrolledStudents %></div>
    <div class="erp-p" style="margin-top: 6px; color: #2563EB; font-weight: 600; font-size: 12px;">Active course batches</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="building-2"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Partner Institutions</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= collegesCount %></div>
    <div class="erp-p" style="margin-top: 6px; color: #000000; font-weight: 600; font-size: 12px;">Colleges & Universities</div>
  </div>
</div>
<div class="catalogue-toolbar" data-catalogue="students">
  <div class="catalogue-search-wrap">
    <i data-lucide="search" class="catalogue-search-icon"></i>
    <input type="text" class="catalogue-search-input" placeholder="Search by name, ID, email, college...">
  </div>

  <div class="catalogue-filters-group">
    <!-- Status Filter -->
    <select class="catalogue-select" data-filter="status" title="Filter by Status">
      <option value="all">All Status</option>
      <option value="active">Active</option>
      <option value="inactive">Inactive</option>
      <option value="pending">Pending</option>
    </select>

    <!-- Department Filter -->
    <select class="catalogue-select" data-filter="department" title="Filter by Department">
      <option value="all">All Departments</option>
      <option value="computer science">Computer Science</option>
      <option value="information technology">Information Technology</option>
      <option value="electronics">Electronics</option>
      <option value="mechanical">Mechanical</option>
      <option value="management">Management</option>
    </select>

    <!-- Sort Dropdown -->
    <select class="catalogue-select" data-filter="sort" title="Sort records">
      <option value="name">Name (A - Z)</option>
      <option value="name_desc">Name (Z - A)</option>
      <option value="newest">Newest First</option>
    </select>

    <!-- Reset Button -->
    <button type="button" class="catalogue-reset-btn" title="Reset all filters">
      <i data-lucide="rotate-ccw" style="width: 13px; height: 13px;"></i>
      <span>Reset</span>
    </button>
  </div>

  <!-- Segmented View Switcher: List vs Kanban/Grid -->
  <div class="catalogue-view-switcher">
    <button type="button" class="view-btn active" data-view="list" title="Table List View">
      <i data-lucide="list"></i>
      <span>List</span>
    </button>
    <button type="button" class="view-btn" data-view="kanban" title="Kanban Card Grid View">
      <i data-lucide="layout-grid"></i>
      <span>Kanban</span>
    </button>
  </div>

  <!-- Result Counter -->
  <div class="catalogue-count-badge">Showing <%= students ? students.length : 0 %> students</div>
</div>

<!-- 1. LIST VIEW (Data Table) -->
<div class="catalogue-list-view" data-catalogue="students">
  <div class="erp-card" style="padding: 0; background: #FFFFFF; border: 1px solid #E2E8F0; overflow: hidden; margin-bottom: 24px;">
    <div class="erp-table-container" style="border: none; border-radius: 0; margin-bottom: 0;">
      <table class="erp-table">
        <thead>
          <tr>
            <th style="color: #000;">Student ID & Name</th>
            <th style="color: #000;">Contact</th>
            <th style="color: #000;">Education</th>
            <th style="color: #000;">Department & Year</th>
            <th style="text-align: center; color: #000;">Courses</th>
            <th style="color: #000;">Status</th>
            <th style="text-align: right; color: #000;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (students && students.length > 0) { %>
            <% students.forEach(s => { 
              const fullName = `${s.first_name || ''} ${s.last_name || ''}`.trim();
              const deptStr = (s.department || '').toLowerCase();
            %>
              <tr id="student-row-<%= s.id %>"
                  data-search="<%= (fullName + ' ' + (s.student_id || '') + ' ' + s.email + ' ' + (s.whatsapp_no || s.phone || '') + ' ' + (s.college_name || s.college || '') + ' ' + deptStr).toLowerCase() %>"
                  data-status="<%= (s.status || 'active').toLowerCase() %>"
                  data-department="<%= deptStr %>"
                  data-name="<%= fullName.toLowerCase() %>"
                  data-newest="<%= s.id %>">
                <td>
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <div style="width: 36px; height: 36px; border-radius: 50%; background: #000; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px;">
                      <%= (s.first_name || 'S').charAt(0).toUpperCase() %>
                    </div>
                    <div>
                      <div style="font-weight: 700; color: #000; font-size: 14px;"><%= fullName %></div>
                      <div style="font-size: 11px; font-family: monospace; color: #64748B;"><%= s.student_id || `#ID-${s.id}` %></div>
                    </div>
                  </div>
                </td>
                <td>
                  <div style="font-size: 13px; color: #000;"><%= s.email %></div>
                  <div style="font-size: 11px; color: #64748B;"><%= s.whatsapp_no || s.phone || '—' %></div>
                </td>
                <td>
                  <div style="font-size: 13px; font-weight: 600; color: #000;"><%= s.college_name || s.college || '—' %></div>
                  <div style="font-size: 11px; color: #64748B;"><%= s.degree || 'B.Tech' %></div>
                </td>
                <td>
                  <div style="font-size: 12px; color: #000;"><%= s.department || 'Computer Science' %></div>
                  <div style="font-size: 11px; color: #64748B;">Year: <%= s.year_of_study || '3' %></div>
                </td>
                <td style="text-align: center;">
                  <span style="display: inline-block; padding: 2px 8px; border-radius: 99px; background: #000; color: #fff; font-size: 11px; font-weight: 700;">
                    <%= s.course_count || 0 %>
                  </span>
                </td>
                <td>
                  <% if (s.status === 'active') { %>
                    <span style="display: inline-block; padding: 2px 8px; background: #DCFCE7; color: #166534; border-radius: 99px; font-size: 11px; font-weight: 600;">Active</span>
                  <% } else { %>
                    <span style="display: inline-block; padding: 2px 8px; background: #F1F5F9; color: #64748B; border-radius: 99px; font-size: 11px; font-weight: 600;"><%= s.status || 'Active' %></span>
                  <% } %>
                </td>
                <td style="text-align: right;">
                  <div style="display: inline-flex; gap: 6px;">
                    <a href="/admin/students/<%= s.id %>" class="erp-btn erp-btn-secondary" style="padding: 4px 8px; font-size: 11px; border: 1px solid #CBD5E1; color: #000; text-decoration: none;">
                      View
                    </a>
                    <button type="button" onclick="openEditStudentById('<%= s.id %>')" class="erp-btn erp-btn-secondary" style="padding: 4px 8px; font-size: 11px; border: 1px solid #CBD5E1; color: #000; cursor: pointer;">
                      Edit
                    </button>
                    <button type="button" onclick="deleteStudent('<%= s.id %>', '<%= fullName %>')" class="erp-btn" style="padding: 4px 8px; font-size: 11px; border: 1px solid #FECACA; background: #FEF2F2; color: #DC2626; cursor: pointer;">
                      Delete
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
          <tr class="empty-state-row" style="display: <%= (!students || students.length === 0) ? '' : 'none' %>;">
            <td colspan="7" style="text-align: center; padding: 36px; color: #64748B;">No students found matching your criteria.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- 2. KANBAN / GRID VIEW (Apple + Google Cards) -->
<div class="catalogue-kanban-view" data-catalogue="students">
  <% if (students && students.length > 0) { %>
    <% students.forEach(s => { 
      const fullName = `${s.first_name || ''} ${s.last_name || ''}`.trim();
      const deptStr = (s.department || '').toLowerCase();
    %>
      <div class="kanban-item-card"
           data-search="<%= (fullName + ' ' + (s.student_id || '') + ' ' + s.email + ' ' + (s.whatsapp_no || s.phone || '') + ' ' + (s.college_name || s.college || '') + ' ' + deptStr).toLowerCase() %>"
           data-status="<%= (s.status || 'active').toLowerCase() %>"
           data-department="<%= deptStr %>"
           data-name="<%= fullName.toLowerCase() %>"
           data-newest="<%= s.id %>">
        <div class="kanban-card-top">
          <div style="display: flex; align-items: center; gap: 10px;">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: #000; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px;">
              <%= (s.first_name || 'S').charAt(0).toUpperCase() %>
            </div>
            <div>
              <div class="kanban-card-title"><%= fullName %></div>
              <div class="kanban-card-subtitle"><%= s.student_id || `#ID-${s.id}` %></div>
            </div>
          </div>
          <% if (s.status === 'active') { %>
            <span style="padding: 3px 8px; background: #DCFCE7; color: #166534; border-radius: 99px; font-size: 11px; font-weight: 700;">Active</span>
          <% } else { %>
            <span style="padding: 3px 8px; background: #F1F5F9; color: #64748B; border-radius: 99px; font-size: 11px; font-weight: 700;"><%= s.status || 'Active' %></span>
          <% } %>
        </div>

        <div class="kanban-card-body">
          <div class="kanban-chip-row">
            <span class="kanban-chip"><i data-lucide="building"></i> <%= s.college_name || s.college || 'College N/A' %></span>
            <span class="kanban-chip"><i data-lucide="graduation-cap"></i> <%= s.department || 'CS' %> (Yr <%= s.year_of_study || '3' %>)</span>
            <span class="kanban-chip" style="background: #000; color: #fff;"><i data-lucide="book-open" style="color:#fff;"></i> <%= s.course_count || 0 %> Courses</span>
          </div>
          <div style="margin-top: 6px; font-size: 12px; color: #475569; display: flex; flex-direction: column; gap: 3px;">
            <div><i data-lucide="mail" style="width: 12px; height: 12px; display: inline-block; vertical-align: middle;"></i> <%= s.email %></div>
            <div><i data-lucide="phone" style="width: 12px; height: 12px; display: inline-block; vertical-align: middle;"></i> <%= s.whatsapp_no || s.phone || 'No phone' %></div>
          </div>
        </div>

        <div class="kanban-card-footer">
          <a href="/admin/students/<%= s.id %>" class="erp-btn erp-btn-secondary" style="padding: 6px 12px; font-size: 12px; border: 1px solid #CBD5E1; color: #000; text-decoration: none; border-radius: 8px;">
            View Profile
          </a>
          <div style="display: inline-flex; gap: 6px;">
            <button type="button" onclick="openEditStudentById('<%= s.id %>')" class="erp-btn erp-btn-secondary" style="padding: 6px 12px; font-size: 12px; border: 1px solid #CBD5E1; color: #000; border-radius: 8px; cursor: pointer;">
              Edit
            </button>
            <button type="button" onclick="deleteStudent('<%= s.id %>', '<%= fullName %>')" class="erp-btn" style="padding: 6px 12px; font-size: 12px; border: 1px solid #FECACA; background: #FEF2F2; color: #DC2626; border-radius: 8px; cursor: pointer;">
              Delete
            </button>
          </div>
        </div>
      </div>
    <% }); %>
  <% } %>
  <div class="kanban-empty-state" style="display: <%= (!students || students.length === 0) ? 'block' : 'none' %>;">
    <i data-lucide="users" style="width: 32px; height: 32px; margin-bottom: 8px; color: #94A3B8;"></i>
    <div>No students found in current directory view.</div>
  </div>
</div>

<!-- Modal: Create / Edit Student -->
<div id="studentModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 99999; align-items: center; justify-content: center; padding: 16px;">
  <div style="background: #FFFFFF; border-radius: 12px; width: 100%; max-width: 520px; max-height: 90vh; overflow-y: auto; padding: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.2);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h3 id="studentModalTitle" style="margin: 0; font-size: 18px; font-weight: 700; color: #000;">Add New Student</h3>
      <button onclick="closeStudentModal()" style="border: none; background: transparent; font-size: 20px; cursor: pointer; color: #64748B;">&times;</button>
    </div>

    <form id="studentForm" onsubmit="handleStudentSubmit(event)">
      <input type="hidden" id="modalStudentId" value="">
      
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">First Name *</label>
          <input type="text" id="modalStudentFirst" required style="width: 100%; padding: 8px 12px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">Last Name *</label>
          <input type="text" id="modalStudentLast" required style="width: 100%; padding: 8px 12px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">Email Address *</label>
          <input type="email" id="modalStudentEmail" required style="width: 100%; padding: 8px 12px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">WhatsApp / Phone</label>
          <input type="text" id="modalStudentPhone" style="width: 100%; padding: 8px 12px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
      </div>

      <div style="margin-bottom: 12px;">
        <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">College / Institution</label>
        <input type="text" id="modalStudentCollege" placeholder="e.g. PSG College of Technology" style="width: 100%; padding: 8px 12px; border: 1px solid #CBD5E1; border-radius: 6px;">
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">Department</label>
          <input type="text" id="modalStudentDept" placeholder="e.g. Computer Science" style="width: 100%; padding: 8px 12px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">Degree</label>
          <input type="text" id="modalStudentDegree" value="B.Tech" style="width: 100%; padding: 8px 12px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
      </div>

      <div style="margin-bottom: 16px;">
        <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">Year of Study</label>
        <select id="modalStudentYear" style="width: 100%; padding: 8px 12px; border: 1px solid #CBD5E1; border-radius: 6px; background: #fff;">
          <option value="1">1st Year</option>
          <option value="2">2nd Year</option>
          <option value="3" selected>3rd Year</option>
          <option value="4">Final Year (4th)</option>
          <option value="Graduated">Graduated / Alumni</option>
        </select>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" onclick="closeStudentModal()" class="erp-btn erp-btn-secondary" style="padding: 8px 16px; border: 1px solid #CBD5E1; color: #000; cursor: pointer;">Cancel</button>
        <button type="submit" id="studentSubmitBtn" class="erp-btn erp-btn-primary" style="padding: 8px 20px; background: #000; color: #fff; border-radius: 6px; font-weight: 600; cursor: pointer;">Save Record</button>
      </div>
    </form>
  </div>
</div>

<script>
  const allStudentsMap = <%- JSON.stringify((students || []).reduce((acc, s) => Object.assign(acc, { [s.id]: s }), {})) %>;

  function openCreateStudentModal() {
    document.getElementById('studentModalTitle').textContent = 'Add New Student';
    document.getElementById('modalStudentId').value = '';
    document.getElementById('modalStudentFirst').value = '';
    document.getElementById('modalStudentLast').value = '';
    document.getElementById('modalStudentEmail').value = '';
    document.getElementById('modalStudentPhone').value = '';
    document.getElementById('modalStudentCollege').value = '';
    document.getElementById('modalStudentDept').value = '';
    document.getElementById('modalStudentDegree').value = 'B.Tech';
    document.getElementById('modalStudentYear').value = '3';
    document.getElementById('studentModal').style.display = 'flex';
  }

  function openEditStudentById(id) {
    const s = allStudentsMap[id];
    if (!s) return;
    document.getElementById('studentModalTitle').textContent = `Edit Student: ${s.first_name} ${s.last_name}`;
    document.getElementById('modalStudentId').value = id;
    document.getElementById('modalStudentFirst').value = s.first_name || '';
    document.getElementById('modalStudentLast').value = s.last_name || '';
    document.getElementById('modalStudentEmail').value = s.email || '';
    document.getElementById('modalStudentPhone').value = s.whatsapp_no || s.phone || '';
    document.getElementById('modalStudentCollege').value = s.college_name || s.college || '';
    document.getElementById('modalStudentDept').value = s.department || '';
    document.getElementById('modalStudentDegree').value = s.degree || 'B.Tech';
    document.getElementById('modalStudentYear').value = s.year_of_study || '3';
    document.getElementById('studentModal').style.display = 'flex';
  }

  function closeStudentModal() {
    document.getElementById('studentModal').style.display = 'none';
  }

  async function handleStudentSubmit(e) {
    e.preventDefault();
    const id = document.getElementById('modalStudentId').value;
    const first_name = document.getElementById('modalStudentFirst').value.trim();
    const last_name = document.getElementById('modalStudentLast').value.trim();
    const email = document.getElementById('modalStudentEmail').value.trim();
    const phone = document.getElementById('modalStudentPhone').value.trim();
    const college = document.getElementById('modalStudentCollege').value.trim();
    const department = document.getElementById('modalStudentDept').value.trim();
    const degree = document.getElementById('modalStudentDegree').value.trim();
    const year_of_study = document.getElementById('modalStudentYear').value;

    const payload = { first_name, last_name, email, phone, college, department, degree, year_of_study };
    const btn = document.getElementById('studentSubmitBtn');
    btn.disabled = true;

    try {
      const url = id ? `/admin/students/${id}` : '/admin/students';
      const method = id ? 'PUT' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json', 'X-Role': 'admin' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Operation failed');

      closeStudentModal();
      window.location.reload();
    } catch (err) {
      alert(err.message);
    } finally {
      btn.disabled = false;
    }
  }

  async function deleteStudent(id, name) {
    if (!confirm(`Are you sure you want to remove ${name}? (Safe soft-delete preserves references)`)) return;
    try {
      const res = await fetch(`/admin/students/${id}`, { 
        method: 'DELETE',
        headers: { 'X-Role': 'admin' }
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to delete');
      window.location.reload();
    } catch (err) {
      alert(err.message);
    }
  }
</script>
