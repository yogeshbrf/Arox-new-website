<div class="erp-h1" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>
    <div style="font-size: 26px; font-weight: 750;">Employee Task Delegation & Workflows</div>
    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 4px;">Assign outreach tasks, monitor project deliverables, and track staff completion</div>
  </div>
  <button onclick="openAdminCreateTaskModal()" class="erp-btn erp-btn-sm" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #000; color: #fff; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; border: none;">
    <i data-lucide="plus" style="width: 15px; height: 15px;"></i>
    <span>Assign Task</span>
  </button>
</div>

<!-- Unified Catalogue Toolbar with View Switcher & Multi-Filters -->
<!-- Summary Metric Cards -->
<%
  const totalTasks = tasks ? tasks.length : 0;
  const completedTasks = tasks ? tasks.filter(t => t.status === 'completed').length : 0;
  const inProgressTasks = tasks ? tasks.filter(t => t.status === 'in_progress' || t.status === 'todo' || t.status === 'review').length : 0;
  const highPriorityTasks = tasks ? tasks.filter(t => (t.priority || '').toLowerCase() === 'high').length : 0;
%>
<div class="erp-grid-4" style="margin-bottom: 24px;">
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="check-square"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Total Tasks</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= totalTasks %></div>
    <div class="erp-p" style="margin-top: 6px; color: #64748B; font-size: 12px;">Delegated assignments</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="check-circle-2"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Completed</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= completedTasks %></div>
    <div class="erp-p" style="margin-top: 6px; color: #16A34A; font-weight: 600; font-size: 12px;">Successfully resolved</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="clock"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">In Progress</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= inProgressTasks %></div>
    <div class="erp-p" style="margin-top: 6px; color: #D97706; font-weight: 600; font-size: 12px;">Active queue</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="alert-circle"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">High Priority</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= highPriorityTasks %></div>
    <div class="erp-p" style="margin-top: 6px; color: #DC2626; font-weight: 600; font-size: 12px;">Urgent deliverables</div>
  </div>
</div>
<div class="catalogue-toolbar" data-catalogue="admin_tasks">
  <div class="catalogue-search-wrap">
    <i data-lucide="search" class="catalogue-search-icon"></i>
    <input type="text" class="catalogue-search-input" placeholder="Search tasks, staff, descriptions...">
  </div>

  <div class="catalogue-filters-group">
    <select class="catalogue-select" data-filter="status" title="Filter by Status">
      <option value="all">All Statuses (<%= stats ? stats.total : 0 %>)</option>
      <option value="todo">To Do (<%= stats ? stats.todo : 0 %>)</option>
      <option value="in_progress">In Progress (<%= stats ? stats.in_progress : 0 %>)</option>
      <option value="completed">Completed (<%= stats ? stats.completed : 0 %>)</option>
    </select>

    <select class="catalogue-select" data-filter="priority" title="Filter by Priority">
      <option value="all">All Priorities</option>
      <option value="high">High Priority</option>
      <option value="medium">Medium Priority</option>
      <option value="low">Low Priority</option>
    </select>

    <select class="catalogue-select" data-filter="assignee" title="Filter by Assignee">
      <option value="all">All Staff Members</option>
      <% if (employees && employees.length > 0) { %>
        <% employees.forEach(emp => { %>
          <option value="<%= (emp.first_name + ' ' + (emp.last_name || '')).toLowerCase().trim() %>">
            <%= emp.first_name %> <%= emp.last_name %>
          </option>
        <% }) %>
      <% } %>
    </select>

    <select class="catalogue-select" data-filter="sort" title="Sort by">
      <option value="newest">Sort: Newest First</option>
      <option value="title">Sort: Title (A-Z)</option>
      <option value="due_date">Sort: Due Date</option>
    </select>

    <button type="button" class="catalogue-reset-btn" title="Reset all filters">
      <i data-lucide="rotate-ccw"></i> Reset
    </button>
  </div>

  <div class="catalogue-view-switcher">
    <button type="button" class="view-btn active" data-view="list" title="Table / List View">
      <i data-lucide="list"></i> List
    </button>
    <button type="button" class="view-btn" data-view="kanban" title="Kanban / Grid View">
      <i data-lucide="layout-grid"></i> Kanban
    </button>
  </div>

  <div class="catalogue-count-badge">
    Showing <%= tasks ? tasks.length : 0 %> tasks
  </div>
</div>

<!-- 1. LIST VIEW (Responsive Data Table) -->
<div class="catalogue-list-view" data-catalogue="admin_tasks">
  <div class="erp-card" style="background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; overflow-x: auto; padding: 0;">
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
      <thead>
        <tr style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0; font-size: 11px; text-transform: uppercase; color: #64748B; font-weight: 700;">
          <th style="padding: 12px 16px;">Task Title</th>
          <th style="padding: 12px 16px;">Assigned Staff</th>
          <th style="padding: 12px 16px;">Category</th>
          <th style="padding: 12px 16px;">Priority</th>
          <th style="padding: 12px 16px;">Due Date</th>
          <th style="padding: 12px 16px;">Status</th>
          <th style="padding: 12px 16px; text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (tasks && tasks.length > 0) { %>
          <% tasks.forEach(task => { 
            const staffName = (task.assignee_first_name || 'Staff') + ' ' + (task.assignee_last_name || '');
          %>
            <tr style="border-bottom: 1px solid #E2E8F0;"
                data-search="<%= (task.title + ' ' + (task.description || '') + ' ' + staffName + ' ' + task.category).toLowerCase() %>"
                data-status="<%= task.status.toLowerCase() %>"
                data-priority="<%= (task.priority || 'medium').toLowerCase() %>"
                data-assignee="<%= staffName.toLowerCase().trim() %>"
                data-title="<%= task.title.toLowerCase() %>"
                data-newest="<%= task.id %>"
                data-due_date="<%= task.due_date || '9999-99-99' %>">
              <td style="padding: 12px 16px;">
                <% if (task.status === 'completed') { %>
                  <div style="font-weight: 700; color: #64748B; text-decoration: line-through;">
                    <%= task.title %>
                  </div>
                <% } else { %>
                  <div style="font-weight: 700; color: #000;">
                    <%= task.title %>
                  </div>
                <% } %>
                <% if (task.description) { %>
                  <div style="font-size: 11px; color: #64748B; margin-top: 2px;"><%= task.description %></div>
                <% } %>
              </td>
              <td style="padding: 12px 16px; font-weight: 600; color: #000;">
                <div style="display: inline-flex; align-items: center; gap: 6px;">
                  <div style="width: 24px; height: 24px; border-radius: 50%; background: #000; color: #fff; font-size: 10px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center;">
                    <%= (task.assignee_first_name ? task.assignee_first_name[0] : 'S') %>
                  </div>
                  <span><%= staffName %></span>
                </div>
              </td>
              <td style="padding: 12px 16px; text-transform: uppercase; font-size: 11px; font-weight: 600; color: #475569;">
                <%= (task.category || 'task').replace('_', ' ') %>
              </td>
              <td style="padding: 12px 16px;">
                <% if (task.priority === 'high') { %>
                  <span style="font-size: 10px; font-weight: 700; padding: 3px 8px; background: #FEE2E2; color: #B91C1C; border-radius: 4px; text-transform: uppercase;">High</span>
                <% } else if (task.priority === 'medium') { %>
                  <span style="font-size: 10px; font-weight: 700; padding: 3px 8px; background: #FEF3C7; color: #B45309; border-radius: 4px; text-transform: uppercase;">Medium</span>
                <% } else { %>
                  <span style="font-size: 10px; font-weight: 700; padding: 3px 8px; background: #F1F5F9; color: #475569; border-radius: 4px; text-transform: uppercase;">Low</span>
                <% } %>
              </td>
              <td style="padding: 12px 16px; font-size: 12px; color: #475569;">
                <i data-lucide="calendar" style="width: 12px; height: 12px; display: inline-block; vertical-align: middle;"></i>
                <%= task.due_date || 'No deadline' %>
              </td>
              <td style="padding: 12px 16px;">
                <% if (task.status === 'completed') { %>
                  <span style="font-size: 11px; font-weight: 700; padding: 3px 8px; background: #DCFCE7; color: #166534; border-radius: 99px; text-transform: uppercase;">
                    Completed
                  </span>
                <% } else if (task.status === 'in_progress') { %>
                  <span style="font-size: 11px; font-weight: 700; padding: 3px 8px; background: #E0E7FF; color: #3730A3; border-radius: 99px; text-transform: uppercase;">
                    In Progress
                  </span>
                <% } else { %>
                  <span style="font-size: 11px; font-weight: 700; padding: 3px 8px; background: #F1F5F9; color: #000; border-radius: 99px; text-transform: uppercase;">
                    To Do
                  </span>
                <% } %>
              </td>
              <td style="padding: 12px 16px; text-align: right;">
                <div style="display: inline-flex; align-items: center; gap: 6px;">
                  <button type="button" onclick="openEditTaskModal('<%= task.id %>')" class="erp-btn erp-btn-secondary" style="padding: 3px 8px; font-size: 11px; border: 1px solid #CBD5E1; color: #000; border-radius: 6px; cursor: pointer;">
                    Edit
                  </button>
                  <select onchange="updateTaskStatusQuick('<%= task.id %>', this.value)" style="padding: 3px 6px; font-size: 11px; font-weight: 600; border: 1px solid #CBD5E1; border-radius: 6px; background: #fff; cursor: pointer;">
                    <option value="pending" <%= task.status === 'pending' ? 'selected' : '' %>>To Do</option>
                    <option value="in_progress" <%= task.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                    <option value="completed" <%= task.status === 'completed' ? 'selected' : '' %>>Completed</option>
                  </select>
                  <button onclick="deleteTaskRecord('<%= task.id %>')" class="erp-btn" style="padding: 3px 8px; font-size: 11px; border: 1px solid #FECACA; background: #FEF2F2; color: #DC2626; border-radius: 6px; cursor: pointer;">
                    Delete
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } %>
        <tr class="empty-state-row" style="display: <%= (!tasks || tasks.length === 0) ? '' : 'none' %>;">
          <td colspan="7" style="padding: 32px; text-align: center; color: #64748B;">No matching tasks found.</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<!-- 2. KANBAN / GRID VIEW (Material 3 Cards) -->
<div class="catalogue-kanban-view" data-catalogue="admin_tasks">
  <% if (tasks && tasks.length > 0) { %>
    <% tasks.forEach(task => { 
      const staffName = (task.assignee_first_name || 'Staff') + ' ' + (task.assignee_last_name || '');
    %>
      <div class="kanban-item-card"
           data-search="<%= (task.title + ' ' + (task.description || '') + ' ' + staffName + ' ' + task.category).toLowerCase() %>"
           data-status="<%= task.status.toLowerCase() %>"
           data-priority="<%= (task.priority || 'medium').toLowerCase() %>"
           data-assignee="<%= staffName.toLowerCase().trim() %>"
           data-title="<%= task.title.toLowerCase() %>"
           data-newest="<%= task.id %>"
           data-due_date="<%= task.due_date || '9999-99-99' %>">
        <div class="kanban-card-top">
          <div>
            <div class="kanban-card-title <%= task.status === 'completed' ? 'style="text-decoration: line-through; color: #64748B;"' : '' %>">
              <%= task.title %>
            </div>
            <div class="kanban-card-subtitle">
              <i data-lucide="tag" style="width: 12px; height: 12px; display: inline-block;"></i>
              <%= (task.category || 'task').replace('_', ' ').toUpperCase() %>
            </div>
          </div>
          <% if (task.status === 'completed') { %>
            <span style="font-size: 10px; font-weight: 700; padding: 2px 8px; background: #DCFCE7; color: #166534; border-radius: 99px; text-transform: uppercase;">Done</span>
          <% } else if (task.status === 'in_progress') { %>
            <span style="font-size: 10px; font-weight: 700; padding: 2px 8px; background: #E0E7FF; color: #3730A3; border-radius: 99px; text-transform: uppercase;">In Progress</span>
          <% } else { %>
            <span style="font-size: 10px; font-weight: 700; padding: 2px 8px; background: #F1F5F9; color: #000; border-radius: 99px; text-transform: uppercase;">To Do</span>
          <% } %>
        </div>

        <div class="kanban-card-body">
          <% if (task.description) { %>
            <p style="margin: 0; font-size: 12px; color: #475569; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
              <%= task.description %>
            </p>
          <% } %>

          <div class="kanban-chip-row" style="margin-top: 10px;">
            <div class="kanban-chip">
              <div style="width: 18px; height: 18px; border-radius: 50%; background: #000; color: #fff; font-size: 9px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; margin-right: 4px;">
                <%= (task.assignee_first_name ? task.assignee_first_name[0] : 'S') %>
              </div>
              <%= staffName %>
            </div>

            <% if (task.priority === 'high') { %>
              <div class="kanban-chip" style="background: #FEE2E2; color: #B91C1C; font-weight: 700;">
                <i data-lucide="alert-circle" style="width: 11px; height: 11px;"></i> HIGH
              </div>
            <% } else if (task.priority === 'medium') { %>
              <div class="kanban-chip" style="background: #FEF3C7; color: #B45309; font-weight: 700;">
                MED
              </div>
            <% } else { %>
              <div class="kanban-chip" style="background: #F1F5F9; color: #64748B;">
                LOW
              </div>
            <% } %>

            <div class="kanban-chip">
              <i data-lucide="clock" style="width: 11px; height: 11px;"></i>
              <%= task.due_date || 'No due date' %>
            </div>
          </div>
        </div>

        <div class="kanban-card-footer">
          <div style="display: flex; align-items: center; gap: 6px;">
            <span style="font-size: 11px; color: #64748B;">Status:</span>
            <select onchange="updateTaskStatusQuick('<%= task.id %>', this.value)" style="padding: 2px 6px; font-size: 11px; font-weight: 600; border: 1px solid #CBD5E1; border-radius: 6px; background: #fff; cursor: pointer;">
              <option value="pending" <%= task.status === 'pending' ? 'selected' : '' %>>To Do</option>
              <option value="in_progress" <%= task.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
              <option value="completed" <%= task.status === 'completed' ? 'selected' : '' %>>Completed</option>
            </select>
          </div>
          <div style="display: inline-flex; gap: 4px;">
            <button type="button" onclick="openEditTaskModal('<%= task.id %>')" class="erp-btn erp-btn-secondary" style="padding: 3px 8px; font-size: 11px; border: 1px solid #CBD5E1; color: #000; border-radius: 6px; cursor: pointer;">
              Edit
            </button>
            <button type="button" onclick="deleteTaskRecord('<%= task.id %>')" class="erp-btn" style="padding: 3px 8px; font-size: 11px; border: 1px solid #FECACA; background: #FEF2F2; color: #DC2626; border-radius: 6px; cursor: pointer;">
              Delete
            </button>
          </div>
        </div>
      </div>
    <% }) %>
  <% } %>
  <div class="kanban-empty-state" style="display: <%= (!tasks || tasks.length === 0) ? 'block' : 'none' %>;">
    <i data-lucide="check-square" style="width: 36px; height: 36px; margin: 0 auto 10px; color: #94A3B8;"></i>
    <div style="font-weight: 700; font-size: 15px; color: #000;">No Tasks Found</div>
    <div style="font-size: 12px; color: #64748B; margin-top: 4px;">No deliverables matching current filters.</div>
  </div>
</div>

<!-- Employee Work Proofs Review Section (Uploaded PDF/PPTX/XLSX/DOCX up to 10MB) -->
<div class="erp-card" style="margin-top: 28px; padding: 0; overflow: hidden; border: 1px solid #E2E8F0; border-radius: 12px; background: #fff;">
  <div style="padding: 16px 20px; border-bottom: 1px solid #E2E8F0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
    <div>
      <h3 style="margin: 0; font-size: 16px; font-weight: 800; color: #0F172A; display: flex; align-items: center; gap: 8px;">
        <i data-lucide="file-check-2" style="width: 18px; height: 18px; color: #155EEF;"></i>
        Employee Work Proofs &amp; Deliverables (<%= (typeof proofs !== 'undefined' && proofs) ? proofs.length : 0 %>)
      </h3>
      <p style="margin: 2px 0 0; font-size: 12px; color: #64748B;">Uploaded .pdf, .pptx, .xlsx, .docx documents submitted by employees from their portal.</p>
    </div>
  </div>
  <div style="overflow-x: auto;">
    <table class="erp-table" style="width: 100%;">
      <thead>
        <tr>
          <th>Employee</th>
          <th>Category / Linked Task</th>
          <th>Document</th>
          <th>Remarks</th>
          <th>Review Status</th>
          <th style="text-align: right;">Admin Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof proofs !== 'undefined' && proofs && proofs.length > 0) { %>
          <% proofs.forEach(function(pf) { %>
            <tr>
              <td>
                <div style="font-weight: 700; color: #0F172A;"><%= pf.employee_name %></div>
                <div style="font-size: 11px; color: #64748B;"><%= pf.employee_email %></div>
              </td>
              <td>
                <span class="erp-badge"><%= pf.category %></span>
                <% if (pf.task_title) { %>
                  <div style="font-size: 11px; color: #334155; margin-top: 4px;">Task: <strong><%= pf.task_title %></strong></div>
                <% } %>
              </td>
              <td>
                <a href="<%= pf.file_path %>" target="_blank" style="font-weight: 700; color: #155EEF; text-decoration: none; display: inline-flex; align-items: center; gap: 5px;">
                  <i data-lucide="download" style="width: 14px; height: 14px;"></i>
                  <%= pf.title || pf.original_name %>
                </a>
                <div style="font-size: 11px; color: #64748B; text-transform: uppercase;">
                  <%= pf.file_ext %> · <%= (Number(pf.file_size || 0) / (1024 * 1024)).toFixed(2) %> MB
                </div>
              </td>
              <td style="font-size: 12px; color: #475569;"><%= pf.remarks || '—' %></td>
              <td>
                <% if (pf.status === 'approved') { %>
                  <span style="padding: 3px 9px; border-radius: 99px; font-size: 11px; font-weight: 700; background: #DCFCE7; color: #166534;">APPROVED</span>
                <% } else if (pf.status === 'rejected') { %>
                  <span style="padding: 3px 9px; border-radius: 99px; font-size: 11px; font-weight: 700; background: #FEE2E2; color: #B91C1C;">REJECTED</span>
                <% } else if (pf.status === 'needs_revision') { %>
                  <span style="padding: 3px 9px; border-radius: 99px; font-size: 11px; font-weight: 700; background: #FEF3C7; color: #92400E;">NEEDS REVISION</span>
                <% } else { %>
                  <span style="padding: 3px 9px; border-radius: 99px; font-size: 11px; font-weight: 700; background: #DBEAFE; color: #1E40AF;">SUBMITTED</span>
                <% } %>
              </td>
              <td style="text-align: right; white-space: nowrap;">
                <button type="button" onclick="reviewEmployeeProof(<%= pf.id %>, 'approved')" class="erp-btn erp-btn-sm" style="background: #DCFCE7; color: #166534; font-weight: 700;">Approve</button>
                <button type="button" onclick="reviewEmployeeProof(<%= pf.id %>, 'needs_revision')" class="erp-btn erp-btn-sm" style="background: #FEF3C7; color: #92400E; font-weight: 700;">Revision</button>
                <button type="button" onclick="reviewEmployeeProof(<%= pf.id %>, 'rejected')" class="erp-btn erp-btn-sm" style="background: #FEE2E2; color: #B91C1C; font-weight: 700;">Reject</button>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" style="text-align: center; padding: 28px; color: #64748B;">No employee proofs uploaded yet.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Modal: Assign Task -->
<div id="adminCreateTaskModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center; padding: 16px;">
  <div style="background: #fff; border-radius: 14px; width: 100%; max-width: 520px; max-height: 92vh; overflow-y: auto; padding: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h3 style="font-size: 18px; font-weight: 750; color: #000; margin: 0;">Assign Task to Employee(s)</h3>
      <button onclick="closeAdminCreateTaskModal()" style="background: none; border: none; font-size: 20px; cursor: pointer; color: #64748B;">&times;</button>
    </div>

    <form id="adminTaskForm" onsubmit="handleAdminCreateTask(event)">
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <div>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
            <label style="font-size: 12px; font-weight: 700; color: #334155;">Assign To Employees * <span id="selectedEmpCount" style="color: #155EEF;">(0 selected)</span></label>
            <label style="font-size: 11px; font-weight: 700; color: #0F172A; display: inline-flex; align-items: center; gap: 5px; cursor: pointer;">
              <input type="checkbox" id="selectAllTaskEmployees" onchange="toggleSelectAllTaskEmployees(this)"> Select All
            </label>
          </div>
          <div style="border: 1px solid #CBD5E1; border-radius: 8px; padding: 10px 12px; max-height: 150px; overflow-y: auto; background: #F8FAFC; display: grid; grid-template-columns: 1fr; gap: 6px;">
            <% if (employees && employees.length > 0) { %>
              <% employees.forEach(emp => { %>
                <label style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: #0F172A; cursor: pointer; padding: 4px 6px; border-radius: 6px; background: #fff; border: 1px solid #E2E8F0;">
                  <input type="checkbox" class="task-assignee-checkbox" value="<%= emp.id %>" onchange="updateSelectedEmpCount()" style="accent-color: #000; width: 15px; height: 15px;">
                  <span><strong><%= emp.first_name %> <%= emp.last_name %></strong> <span style="font-size: 11px; color: #64748B;">(<%= emp.email %><% if (emp.referral_code) { %> · <%= emp.referral_code %><% } %>)</span></span>
                </label>
              <% }) %>
            <% } %>
          </div>
          <div style="font-size: 11px; color: #64748B; margin-top: 4px;">Select one or multiple employees to assign this exact task in bulk.</div>
        </div>

        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Task Title *</label>
          <input type="text" name="title" required placeholder="e.g. Follow up on corporate training quotation" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
        </div>

        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Description / Instructions</label>
          <textarea name="description" rows="2" placeholder="Actionable steps for employee..." style="width: 100%; padding: 8px 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; resize: vertical;"></textarea>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Priority</label>
            <select name="priority" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; background: #fff;">
              <option value="high">High Priority</option>
              <option value="medium" selected>Medium Priority</option>
              <option value="low">Low Priority</option>
            </select>
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Due Date</label>
            <input type="date" name="due_date" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
          </div>
        </div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 18px;">
        <button type="button" onclick="closeAdminCreateTaskModal()" style="padding: 8px 16px; background: #F1F5F9; color: #334155; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">Cancel</button>
        <button type="submit" id="saveAdminTaskBtn" style="padding: 8px 18px; background: #000; color: #fff; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">Assign Task</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Edit Task -->
<div id="adminEditTaskModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center; padding: 16px;">
  <div style="background: #fff; border-radius: 14px; width: 100%; max-width: 500px; padding: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h3 style="font-size: 18px; font-weight: 750; color: #000; margin: 0;">Edit Task Details</h3>
      <button onclick="closeEditTaskModal()" style="background: none; border: none; font-size: 20px; cursor: pointer; color: #64748B;">&times;</button>
    </div>

    <form id="adminEditTaskForm" onsubmit="handleEditTaskSubmit(event)">
      <input type="hidden" id="editTaskId" name="id">
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Assign To Employee *</label>
          <select id="editTaskAssignee" name="assigned_to" required style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; background: #fff;">
            <% if (employees && employees.length > 0) { %>
              <% employees.forEach(emp => { %>
                <option value="<%= emp.id %>"><%= emp.first_name %> <%= emp.last_name %> (<%= emp.email %>)</option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Task Title *</label>
          <input type="text" id="editTaskTitle" name="title" required style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
        </div>

        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Category</label>
          <input type="text" id="editTaskCategory" name="category" placeholder="e.g. follow_up, proposal, support" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
        </div>

        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Description / Instructions</label>
          <textarea id="editTaskDesc" name="description" rows="2" style="width: 100%; padding: 8px 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; resize: vertical;"></textarea>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Priority</label>
            <select id="editTaskPriority" name="priority" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; background: #fff;">
              <option value="high">High Priority</option>
              <option value="medium">Medium Priority</option>
              <option value="low">Low Priority</option>
            </select>
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Due Date</label>
            <input type="date" id="editTaskDueDate" name="due_date" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
          </div>
        </div>

        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Status</label>
          <select id="editTaskStatus" name="status" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; background: #fff;">
            <option value="pending">To Do</option>
            <option value="in_progress">In Progress</option>
            <option value="completed">Completed</option>
          </select>
        </div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 18px;">
        <button type="button" onclick="closeEditTaskModal()" style="padding: 8px 16px; background: #F1F5F9; color: #334155; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">Cancel</button>
        <button type="submit" id="saveEditTaskBtn" style="padding: 8px 18px; background: #000; color: #fff; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<script>
  const allTasksMap = <%- JSON.stringify((tasks || []).reduce((acc, t) => Object.assign(acc, { [t.id]: t }), {})) %>;

  function openAdminCreateTaskModal() {
    document.getElementById('adminCreateTaskModal').style.display = 'flex';
  }
  function closeAdminCreateTaskModal() {
    document.getElementById('adminCreateTaskModal').style.display = 'none';
  }

  function openEditTaskModal(id) {
    const t = allTasksMap[id];
    if (!t) return console.warn('Task not found:', id);

    document.getElementById('editTaskId').value = t.id;
    document.getElementById('editTaskTitle').value = t.title || '';
    document.getElementById('editTaskDesc').value = t.description || '';
    document.getElementById('editTaskCategory').value = t.category || 'task';
    document.getElementById('editTaskPriority').value = t.priority || 'medium';
    document.getElementById('editTaskStatus').value = t.status || 'pending';
    document.getElementById('editTaskAssignee').value = t.assigned_to || '';
    document.getElementById('editTaskDueDate').value = t.due_date ? t.due_date.slice(0, 10) : '';

    document.getElementById('adminEditTaskModal').style.display = 'flex';
  }

  function closeEditTaskModal() {
    document.getElementById('adminEditTaskModal').style.display = 'none';
  }

  async function handleEditTaskSubmit(e) {
    e.preventDefault();
    const id = document.getElementById('editTaskId').value;
    const btn = document.getElementById('saveEditTaskBtn');
    btn.disabled = true;
    btn.textContent = 'Saving...';

    const payload = {
      title: document.getElementById('editTaskTitle').value.trim(),
      description: document.getElementById('editTaskDesc').value.trim(),
      category: document.getElementById('editTaskCategory').value.trim(),
      priority: document.getElementById('editTaskPriority').value,
      status: document.getElementById('editTaskStatus').value,
      assigned_to: document.getElementById('editTaskAssignee').value,
      due_date: document.getElementById('editTaskDueDate').value || null
    };

    try {
      const res = await fetch(`/api/employee/tasks/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const result = await res.json();
      if (result.success) {
        window.location.reload();
      } else {
        alert(result.message || 'Failed to update task');
        btn.disabled = false;
        btn.textContent = 'Save Changes';
      }
    } catch (err) {
      alert('Error updating task: ' + err.message);
      btn.disabled = false;
      btn.textContent = 'Save Changes';
    }
  }

  function toggleSelectAllTaskEmployees(masterCb) {
    document.querySelectorAll('.task-assignee-checkbox').forEach(cb => { cb.checked = masterCb.checked; });
    updateSelectedEmpCount();
  }

  function updateSelectedEmpCount() {
    const count = document.querySelectorAll('.task-assignee-checkbox:checked').length;
    const label = document.getElementById('selectedEmpCount');
    if (label) label.textContent = `(${count} selected)`;
  }

  async function reviewEmployeeProof(proofId, status) {
    const notes = prompt(`Add optional admin note for marking proof as "${status}":`, '') || '';
    const res = await fetch(`/api/admin/proofs/${proofId}/review`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status, review_notes: notes })
    });
    const data = await res.json();
    if (!data.success) return alert(data.message || 'Failed to review proof');
    window.location.reload();
  }

  async function handleAdminCreateTask(e) {
    e.preventDefault();
    const checkedIds = Array.from(document.querySelectorAll('.task-assignee-checkbox:checked')).map(cb => parseInt(cb.value, 10));
    if (checkedIds.length === 0) {
      return alert('Please select at least one employee to assign this task.');
    }

    const btn = document.getElementById('saveAdminTaskBtn');
    btn.disabled = true;
    btn.textContent = 'Assigning...';

    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());
    data.assigned_to_ids = checkedIds;
    data.assigned_to = checkedIds[0];

    try {
      const res = await fetch('/api/employee/tasks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json();
      if (result.success) {
        window.location.reload();
      } else {
        alert(result.message || 'Failed to assign task');
        btn.disabled = false;
        btn.textContent = 'Assign Task';
      }
    } catch (err) {
      alert('Error assigning task');
      btn.disabled = false;
      btn.textContent = 'Assign Task';
    }
  }

  async function updateTaskStatusQuick(id, status) {
    try {
      const res = await fetch(`/api/employee/tasks/${id}/status`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      });
      const result = await res.json();
      if (result.success) {
        window.location.reload();
      } else {
        alert(result.message || 'Failed to update task status');
      }
    } catch (err) {
      alert('Error updating task status');
    }
  }

  async function deleteTaskRecord(id) {
    if (!confirm('Are you sure you want to delete this task?')) return;
    try {
      const res = await fetch(`/api/employee/tasks/${id}`, { method: 'DELETE' });
      const result = await res.json();
      if (result.success) {
        window.location.reload();
      } else {
        alert(result.message || 'Failed to delete task');
      }
    } catch (err) {
      alert('Error deleting task');
    }
  }
</script>
