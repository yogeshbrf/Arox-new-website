<div class="erp-h1" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>Referral Codes & Student Affiliations</div>
  <button onclick="openCreateReferralModal()" class="erp-btn erp-btn-primary" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #000; color: #fff; border-radius: 8px; font-weight: 600; font-size: 13px; border: none; cursor: pointer;">
    <i data-lucide="plus" style="width: 16px; height: 16px;"></i> Create Referral Code
  </button>
</div>

<!-- Referral Metric Cards -->
<% 
  let totalCodes = referrals ? referrals.length : 0;
  let totalUsed = referrals ? referrals.reduce((sum, r) => sum + (Number(r.times_used) || 0), 0) : 0;
  let activeCodes = referrals ? referrals.filter(r => r.is_active).length : 0;
%>
<div class="erp-grid-4" style="margin-bottom: 24px;">
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="ticket"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Total Promo Codes</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= totalCodes %></div>
    <div class="erp-p" style="margin-top: 6px; color: #64748B; font-size: 12px;">All registered codes</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="zap"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Active Campaigns</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= activeCodes %></div>
    <div class="erp-p" style="margin-top: 6px; color: #16A34A; font-weight: 600; font-size: 12px;">Currently valid & active</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="users"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Referred Students</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= totalUsed %></div>
    <div class="erp-p" style="margin-top: 6px; color: #0284C7; font-weight: 600; font-size: 12px;">Website registrations tracked</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="percent"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Avg Discount</div>
    </div>
    <div class="erp-card-value" style="color: #000000;">
      <%= totalCodes > 0 ? (referrals.reduce((sum, r) => sum + (Number(r.discount_percent) || 0), 0) / totalCodes).toFixed(0) : 0 %>%
    </div>
    <div class="erp-p" style="margin-top: 6px; color: #64748B; font-size: 12px;">Incentive structure</div>
  </div>
</div>

<!-- Unified Catalogue Toolbar with View Switcher & Multi-Filters -->
<div class="catalogue-toolbar" data-catalogue="admin_referrals">
  <div class="catalogue-search-wrap">
    <i data-lucide="search" class="catalogue-search-icon"></i>
    <input type="text" class="catalogue-search-input" placeholder="Search by referral code, campaign, email...">
  </div>

  <div class="catalogue-filters-group">
    <select class="catalogue-select" data-filter="status" title="Filter by Status">
      <option value="all">All Statuses (<%= totalCodes %>)</option>
      <option value="active">Active Codes (<%= activeCodes %>)</option>
      <option value="inactive">Inactive Codes</option>
    </select>

    <select class="catalogue-select" data-filter="sort" title="Sort by">
      <option value="newest">Sort: Newest First</option>
      <option value="code">Sort: Code (A-Z)</option>
      <option value="redeemed_desc">Sort: Most Redeemed</option>
      <option value="discount_desc">Sort: Highest Discount</option>
    </select>

    <button type="button" class="catalogue-reset-btn" title="Reset all filters">
      <i data-lucide="rotate-ccw"></i> Reset
    </button>
  </div>

  <div class="catalogue-view-switcher">
    <button type="button" class="view-btn active" data-view="list" title="Table / List View">
      <i data-lucide="list"></i> List
    </button>
    <button type="button" class="view-btn" data-view="kanban" title="Kanban / Grid View">
      <i data-lucide="layout-grid"></i> Kanban
    </button>
  </div>

  <div class="catalogue-count-badge">
    Showing <%= totalCodes %> referral codes
  </div>
</div>

<!-- 1. LIST VIEW (Responsive Data Table) -->
<div class="catalogue-list-view" data-catalogue="admin_referrals">
  <div class="erp-card" style="padding: 0; background: #FFFFFF; border: 1px solid #E2E8F0; overflow: hidden; margin-bottom: 24px;">
    <div class="erp-table-container" style="border: none; border-radius: 0; margin-bottom: 0;">
      <table class="erp-table">
        <thead>
          <tr>
            <th style="color: #000;">Code</th>
            <th style="color: #000;">Referrer / Campaign</th>
            <th style="color: #000;">Contact Email</th>
            <th style="color: #000;">Discount</th>
            <th style="color: #000;">Usage Limit</th>
            <th style="color: #000;">Redeemed</th>
            <th style="color: #000;">Status</th>
            <th style="text-align: right; color: #000;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (referrals && referrals.length > 0) { %>
            <% referrals.forEach(ref => { 
              const rStatus = ref.is_active ? 'active' : 'inactive';
              const timesUsed = Number(ref.times_used || 0);
              const discountNum = Number(ref.discount_percent || 0);
            %>
              <tr data-search="<%= (ref.code + ' ' + (ref.referrer_name || '') + ' ' + (ref.referrer_email || '')).toLowerCase() %>"
                  data-status="<%= rStatus %>"
                  data-code="<%= ref.code.toLowerCase() %>"
                  data-redeemed_desc="<%= timesUsed %>"
                  data-discount_desc="<%= discountNum %>"
                  data-newest="<%= ref.id %>">
                <td>
                  <span style="font-family: monospace; font-size: 13px; font-weight: 800; background: #F1F5F9; color: #000; padding: 4px 8px; border-radius: 6px; border: 1px solid #CBD5E1; letter-spacing: 0.05em;">
                    <%= ref.code %>
                  </span>
                </td>
                <td style="font-weight: 700; color: #000;"><%= ref.referrer_name %></td>
                <td style="color: #64748B; font-size: 12px;"><%= ref.referrer_email || '—' %></td>
                <td style="font-weight: 750; color: #000;"><%= ref.discount_percent %>% OFF</td>
                <td><%= ref.max_uses > 0 ? ref.max_uses : 'Unlimited' %></td>
                <td>
                  <button onclick="viewReferredStudents('<%= ref.id %>', '<%= ref.code %>')" class="erp-btn erp-btn-sm" style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; background: #000; color: #fff; border-radius: 6px; font-size: 11px; font-weight: 600; border: none; cursor: pointer;">
                    <i data-lucide="users" style="width: 12px; height: 12px;"></i> <%= timesUsed %> Students &rarr;
                  </button>
                </td>
                <td>
                  <% if (ref.is_active) { %>
                    <span style="display: inline-block; padding: 3px 8px; background: #DCFCE7; color: #166534; border-radius: 99px; font-size: 11px; font-weight: 700;">Active</span>
                  <% } else { %>
                    <span style="display: inline-block; padding: 3px 8px; background: #F1F5F9; color: #64748B; border-radius: 99px; font-size: 11px; font-weight: 700;">Inactive</span>
                  <% } %>
                </td>
                <td style="text-align: right;">
                  <div style="display: inline-flex; gap: 6px;">
                    <button onclick="openEditReferralModal('<%= ref.id %>', '<%= ref.code %>', '<%= ref.referrer_name %>', '<%= ref.referrer_email || '' %>', '<%= ref.discount_percent %>', '<%= ref.max_uses %>', '<%= ref.is_active %>')" class="erp-btn erp-btn-secondary" style="padding: 4px 8px; font-size: 11px; border: 1px solid #CBD5E1; color: #000; cursor: pointer;">
                      Edit
                    </button>
                    <button onclick="deleteReferralCode('<%= ref.id %>', '<%= ref.code %>')" class="erp-btn" style="padding: 4px 8px; font-size: 11px; border: 1px solid #FECACA; background: #FEF2F2; color: #DC2626; cursor: pointer;">
                      Delete
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
          <tr class="empty-state-row" style="display: <%= (!referrals || referrals.length === 0) ? '' : 'none' %>;">
            <td colspan="8" style="text-align: center; padding: 36px; color: #64748B;">
              No matching referral codes found.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- 2. KANBAN / GRID VIEW (Material 3 Cards) -->
<div class="catalogue-kanban-view" data-catalogue="admin_referrals">
  <% if (referrals && referrals.length > 0) { %>
    <% referrals.forEach(ref => { 
      const rStatus = ref.is_active ? 'active' : 'inactive';
      const timesUsed = Number(ref.times_used || 0);
      const discountNum = Number(ref.discount_percent || 0);
    %>
      <div class="kanban-item-card"
           data-search="<%= (ref.code + ' ' + (ref.referrer_name || '') + ' ' + (ref.referrer_email || '')).toLowerCase() %>"
           data-status="<%= rStatus %>"
           data-code="<%= ref.code.toLowerCase() %>"
           data-redeemed_desc="<%= timesUsed %>"
           data-discount_desc="<%= discountNum %>"
           data-newest="<%= ref.id %>">
        <div class="kanban-card-top">
          <div>
            <span style="font-family: monospace; font-size: 15px; font-weight: 800; background: #000; color: #fff; padding: 3px 8px; border-radius: 6px; letter-spacing: 0.05em; display: inline-block;">
              <%= ref.code %>
            </span>
            <div class="kanban-card-title" style="margin-top: 8px;"><%= ref.referrer_name %></div>
          </div>
          <% if (ref.is_active) { %>
            <span style="font-size: 10px; font-weight: 750; padding: 2px 8px; border-radius: 99px; text-transform: uppercase; background: #DCFCE7; color: #166534;">Active</span>
          <% } else { %>
            <span style="font-size: 10px; font-weight: 750; padding: 2px 8px; border-radius: 99px; text-transform: uppercase; background: #F1F5F9; color: #64748B;">Inactive</span>
          <% } %>
        </div>

        <div class="kanban-card-body">
          <div class="kanban-chip-row">
            <div class="kanban-chip" style="font-weight: 750; color: #000;">
              <%= ref.discount_percent %>% DISCOUNT
            </div>
            <div class="kanban-chip">
              <i data-lucide="user-check" style="width: 11px; height: 11px;"></i>
              <%= ref.max_uses > 0 ? `${timesUsed} / ${ref.max_uses} used` : `${timesUsed} redeemed` %>
            </div>
            <% if (ref.referrer_email) { %>
              <div class="kanban-chip">
                <i data-lucide="mail" style="width: 11px; height: 11px;"></i>
                <%= ref.referrer_email %>
              </div>
            <% } %>
          </div>
        </div>

        <div class="kanban-card-footer">
          <button onclick="viewReferredStudents('<%= ref.id %>', '<%= ref.code %>')" class="erp-btn erp-btn-sm" style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; background: #000; color: #fff; border-radius: 6px; font-size: 11px; font-weight: 600; border: none; cursor: pointer;">
            <i data-lucide="users" style="width: 12px; height: 12px;"></i> <%= timesUsed %> Students &rarr;
          </button>

          <div style="display: inline-flex; gap: 6px;">
            <button onclick="openEditReferralModal('<%= ref.id %>', '<%= ref.code %>', '<%= ref.referrer_name %>', '<%= ref.referrer_email || '' %>', '<%= ref.discount_percent %>', '<%= ref.max_uses %>', '<%= ref.is_active %>')" class="erp-btn erp-btn-secondary" style="padding: 4px 8px; font-size: 11px; border: 1px solid #CBD5E1; color: #000; cursor: pointer;">
              Edit
            </button>
            <button onclick="deleteReferralCode('<%= ref.id %>', '<%= ref.code %>')" class="erp-btn" style="padding: 4px 8px; font-size: 11px; border: 1px solid #FECACA; background: #FEF2F2; color: #DC2626; cursor: pointer;">
              Delete
            </button>
          </div>
        </div>
      </div>
    <% }) %>
  <% } %>
  <div class="kanban-empty-state" style="display: <%= (!referrals || referrals.length === 0) ? 'block' : 'none' %>;">
    <i data-lucide="ticket" style="width: 36px; height: 36px; margin: 0 auto 10px; color: #94A3B8;"></i>
    <div style="font-weight: 700; font-size: 15px; color: #000;">No Referral Codes Found</div>
    <div style="font-size: 12px; color: #64748B; margin-top: 4px;">Create an alphanumeric code or clear filter parameters.</div>
  </div>
</div>

<!-- Modal: Create / Edit Referral Code -->
<div id="referralModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 99999; align-items: center; justify-content: center; padding: 16px;">
  <div style="background: #FFFFFF; border-radius: 12px; width: 100%; max-width: 480px; padding: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.2);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h3 id="referralModalTitle" style="margin: 0; font-size: 18px; font-weight: 700; color: #000;">Create Referral Code</h3>
      <button onclick="closeReferralModal()" style="border: none; background: transparent; font-size: 20px; cursor: pointer; color: #64748B;">&times;</button>
    </div>

    <form id="referralForm" onsubmit="handleReferralSubmit(event)">
      <input type="hidden" id="modalReferralId" value="">
      
      <div style="margin-bottom: 14px;">
        <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">Referral Code * (Alphanumeric)</label>
        <input type="text" id="modalReferralCode" required style="width: 100%; padding: 8px 12px; border: 1px solid #CBD5E1; border-radius: 6px; font-family: monospace; font-weight: 700; text-transform: uppercase;" placeholder="e.g. CAMPUS2026">
        <span style="font-size: 11px; color: #64748B;">Normalized to uppercase letters, numbers, and dashes.</span>
      </div>

      <div style="margin-bottom: 14px;">
        <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">Referrer / Campaign Name *</label>
        <input type="text" id="modalReferrerName" required style="width: 100%; padding: 8px 12px; border: 1px solid #CBD5E1; border-radius: 6px;" placeholder="e.g. Campus Ambassador Program">
      </div>

      <div style="margin-bottom: 14px;">
        <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">Referrer Contact Email</label>
        <input type="email" id="modalReferrerEmail" style="width: 100%; padding: 8px 12px; border: 1px solid #CBD5E1; border-radius: 6px;" placeholder="ambassador@college.edu">
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">Discount %</label>
          <input type="number" id="modalDiscountPercent" min="0" max="100" value="10" style="width: 100%; padding: 8px 12px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
        <div>
          <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 4px;">Max Uses (0 = unlimited)</label>
          <input type="number" id="modalMaxUses" min="0" value="100" style="width: 100%; padding: 8px 12px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
      </div>

      <div style="margin-bottom: 20px;">
        <label style="display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; cursor: pointer;">
          <input type="checkbox" id="modalIsActive" checked>
          <span>Referral Code is Active</span>
        </label>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" onclick="closeReferralModal()" class="erp-btn erp-btn-secondary" style="padding: 8px 16px; border: 1px solid #CBD5E1; color: #000; cursor: pointer;">Cancel</button>
        <button type="submit" id="modalSubmitBtn" class="erp-btn erp-btn-primary" style="padding: 8px 20px; background: #000; color: #fff; border-radius: 6px; font-weight: 600; cursor: pointer;">Save Code</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: View Referred Students -->
<div id="referredStudentsModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 99999; align-items: center; justify-content: center; padding: 16px;">
  <div style="background: #FFFFFF; border-radius: 12px; width: 100%; max-width: 760px; max-height: 85vh; display: flex; flex-direction: column; padding: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.2);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid #E2E8F0; padding-bottom: 12px;">
      <div>
        <h3 id="referredCodeHeading" style="margin: 0; font-size: 18px; font-weight: 700; color: #000;">Referred Students for Code</h3>
        <p style="margin: 2px 0 0; font-size: 12px; color: #64748B;">Students who registered with this code on the website.</p>
      </div>
      <button onclick="closeReferredStudentsModal()" style="border: none; background: transparent; font-size: 22px; cursor: pointer; color: #64748B;">&times;</button>
    </div>

    <div style="flex: 1; overflow-y: auto;">
      <div id="referredStudentsLoading" style="text-align: center; padding: 24px; color: #64748B;">Loading referred students...</div>
      <table id="referredStudentsTable" class="erp-table" style="display: none; width: 100%;">
        <thead>
          <tr>
            <th style="color: #000;">Student Name</th>
            <th style="color: #000;">Contact</th>
            <th style="color: #000;">College</th>
            <th style="color: #000;">Course</th>
            <th style="color: #000;">Date</th>
            <th style="color: #000;">Total Fee</th>
          </tr>
        </thead>
        <tbody id="referredStudentsTbody"></tbody>
      </table>
    </div>
  </div>
</div>

<script>
  function openCreateReferralModal() {
    document.getElementById('referralModalTitle').textContent = 'Create Referral Code';
    document.getElementById('modalReferralId').value = '';
    document.getElementById('modalReferralCode').value = '';
    document.getElementById('modalReferralCode').readOnly = false;
    document.getElementById('modalReferrerName').value = '';
    document.getElementById('modalReferrerEmail').value = '';
    document.getElementById('modalDiscountPercent').value = '10';
    document.getElementById('modalMaxUses').value = '100';
    document.getElementById('modalIsActive').checked = true;
    document.getElementById('referralModal').style.display = 'flex';
  }

  function openEditReferralModal(id, code, name, email, discount, maxUses, isActive) {
    document.getElementById('referralModalTitle').textContent = `Edit Referral Code: ${code}`;
    document.getElementById('modalReferralId').value = id;
    document.getElementById('modalReferralCode').value = code;
    document.getElementById('modalReferralCode').readOnly = true;
    document.getElementById('modalReferrerName').value = name;
    document.getElementById('modalReferrerEmail').value = email;
    document.getElementById('modalDiscountPercent').value = discount;
    document.getElementById('modalMaxUses').value = maxUses;
    document.getElementById('modalIsActive').checked = isActive == 1;
    document.getElementById('referralModal').style.display = 'flex';
  }

  function closeReferralModal() {
    document.getElementById('referralModal').style.display = 'none';
  }

  async function handleReferralSubmit(e) {
    e.preventDefault();
    const id = document.getElementById('modalReferralId').value;
    const code = document.getElementById('modalReferralCode').value.trim();
    const referrer_name = document.getElementById('modalReferrerName').value.trim();
    const referrer_email = document.getElementById('modalReferrerEmail').value.trim();
    const discount_percent = document.getElementById('modalDiscountPercent').value;
    const max_uses = document.getElementById('modalMaxUses').value;
    const is_active = document.getElementById('modalIsActive').checked ? 1 : 0;

    const payload = { code, referrer_name, referrer_email, discount_percent, max_uses, is_active };
    const btn = document.getElementById('modalSubmitBtn');
    btn.disabled = true;

    try {
      const url = id ? `/api/referrals/${id}` : '/api/referrals';
      const method = id ? 'PUT' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || 'Failed to save referral code');

      closeReferralModal();
      window.location.reload();
    } catch (err) {
      alert(err.message);
    } finally {
      btn.disabled = false;
    }
  }

  async function deleteReferralCode(id, code) {
    if (!confirm(`Are you sure you want to delete referral code "${code}"?`)) return;
    try {
      const res = await fetch(`/api/referrals/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || 'Failed to delete');
      window.location.reload();
    } catch (err) {
      alert(err.message);
    }
  }

  async function viewReferredStudents(id, code) {
    document.getElementById('referredCodeHeading').textContent = `Referred Students for "${code}"`;
    document.getElementById('referredStudentsModal').style.display = 'flex';
    document.getElementById('referredStudentsLoading').style.display = 'block';
    document.getElementById('referredStudentsTable').style.display = 'none';

    try {
      const res = await fetch(`/api/referrals/${id}/students`);
      const data = await res.json();
      document.getElementById('referredStudentsLoading').style.display = 'none';
      const tbody = document.getElementById('referredStudentsTbody');
      tbody.innerHTML = '';

      if (data.data && data.data.length > 0) {
        data.data.forEach(s => {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td style="font-weight: 600; color: #000;">${s.first_name} ${s.last_name}</td>
            <td style="font-size: 12px; color: #64748B;">${s.email}<br>${s.phone || ''}</td>
            <td style="font-size: 12px; color: #000;">${s.college || '—'}</td>
            <td style="font-weight: 600; font-size: 12px; color: #000;">${s.course_title}</td>
            <td style="font-size: 12px; color: #64748B;">${new Date(s.registered_at).toLocaleDateString('en-IN')}</td>
            <td style="font-weight: 700; color: #000;">₹${Number(s.total_amount || 0).toLocaleString('en-IN')}</td>
          `;
          tbody.appendChild(tr);
        });
        document.getElementById('referredStudentsTable').style.display = 'table';
      } else {
        document.getElementById('referredStudentsLoading').style.display = 'block';
        document.getElementById('referredStudentsLoading').textContent = `No students have registered with "${code}" yet.`;
      }
    } catch (err) {
      document.getElementById('referredStudentsLoading').textContent = 'Failed to load students: ' + err.message;
    }
  }

  function closeReferredStudentsModal() {
    document.getElementById('referredStudentsModal').style.display = 'none';
  }
</script>
