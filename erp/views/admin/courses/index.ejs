<div class="erp-h1" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>Courses & Internships Management</div>
  <div style="display: flex; align-items: center; gap: 12px;">
    <button type="button" class="erp-btn erp-btn-primary" onclick="openAddCourseModal()" style="background: #000000; color: #FFFFFF; font-weight: 600; padding: 9px 16px; border-radius: 8px;">
      <i data-lucide="plus-circle" style="width: 15px; height: 15px;"></i> Add New Program
    </button>
  </div>
</div>

<!-- Courses Overview Stats Cards -->
<%
  let totalPrograms = courses ? courses.length : 0;
  let activePrograms = courses ? courses.filter(c => c.status === 'active' || c.is_active == 1).length : 0;
  let internshipCount = courses ? courses.filter(c => (c.category === 'internship' || c.type === 'internship')).length : 0;
  let trainingCount = courses ? courses.filter(c => (c.category === 'training' || c.type === 'training')).length : 0;
  let totalEnrolledCount = courses ? courses.reduce((acc, c) => acc + (parseInt(c.enrolled_count) || 0), 0) : 0;
%>
<div class="erp-grid-4" style="margin-bottom: 28px;">
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="book-open"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Total Programs</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= totalPrograms %></div>
    <div class="erp-p" style="margin-top: 8px; color: #64748B; font-size: 12px;"><%= activePrograms %> Active & Enrolling</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="briefcase"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Internship Tracks</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= internshipCount %></div>
    <div class="erp-p" style="margin-top: 8px; color: #64748B; font-size: 12px;">Industry Internships</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="graduation-cap"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Training Programs</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= trainingCount %></div>
    <div class="erp-p" style="margin-top: 8px; color: #64748B; font-size: 12px;">Professional Trainings</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="users"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Total Enrollments</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= totalEnrolledCount %></div>
    <div class="erp-p" style="margin-top: 8px; color: #000000; font-weight: 600; font-size: 12px;">Across all batches</div>
  </div>
</div>

<!-- Unified Catalogue Toolbar with View Switcher & Multi-Filters -->
<div class="catalogue-toolbar" data-catalogue="admin_courses">
  <div class="catalogue-search-wrap">
    <i data-lucide="search" class="catalogue-search-icon"></i>
    <input type="text" class="catalogue-search-input" placeholder="Search by title, batch, slug, description...">
  </div>

  <div class="catalogue-filters-group">
    <select class="catalogue-select" data-filter="category" title="Filter by Program Category">
      <option value="all">All Programs (<%= totalPrograms %>)</option>
      <option value="internship">Internships (<%= internshipCount %>)</option>
      <option value="training">Trainings (<%= trainingCount %>)</option>
    </select>

    <select class="catalogue-select" data-filter="status" title="Filter by Status">
      <option value="all">All Statuses</option>
      <option value="active">Active</option>
      <option value="draft">Draft</option>
      <option value="completed">Completed</option>
    </select>

    <select class="catalogue-select" data-filter="sort" title="Sort by">
      <option value="newest">Sort: Newest First</option>
      <option value="title">Sort: Title (A-Z)</option>
      <option value="price_desc">Sort: Fee (High to Low)</option>
      <option value="price_asc">Sort: Fee (Low to High)</option>
      <option value="enrolled_desc">Sort: Most Enrolled</option>
    </select>

    <button type="button" class="catalogue-reset-btn" title="Reset all filters">
      <i data-lucide="rotate-ccw"></i> Reset
    </button>
  </div>

  <div class="catalogue-view-switcher">
    <button type="button" class="view-btn active" data-view="list" title="Table / List View">
      <i data-lucide="list"></i> List
    </button>
    <button type="button" class="view-btn" data-view="kanban" title="Kanban / Grid View">
      <i data-lucide="layout-grid"></i> Kanban
    </button>
  </div>

  <div class="catalogue-count-badge">
    Showing <%= totalPrograms %> programs
  </div>
</div>

<!-- 1. LIST VIEW (Responsive Data Table) -->
<div class="catalogue-list-view" data-catalogue="admin_courses">
  <div class="erp-card" style="padding: 0; background: #FFFFFF; border: 1px solid #E2E8F0; overflow: hidden;">
    <div class="erp-table-container" style="border: none; border-radius: 0; margin-bottom: 0;">
      <table class="erp-table" id="coursesTable">
        <thead>
          <tr>
            <th style="width: 260px; color: #000000;">Program Title & Batch</th>
            <th style="width: 110px; color: #000000;">Type</th>
            <th style="width: 140px; color: #000000;">Schedule & Duration</th>
            <th style="width: 110px; color: #000000;">Fee (₹)</th>
            <th style="width: 150px; text-align: center; color: #000000;">Enrollment Capacity</th>
            <th style="width: 120px; text-align: center; color: #000000;">Status</th>
            <th style="width: 140px; text-align: right; color: #000000;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (courses && courses.length > 0) { %>
            <% courses.forEach(c => { 
              const catType = (c.category || c.type || 'training').toLowerCase();
              const cStatus = (c.status || (c.is_active == 1 ? 'active' : 'draft')).toLowerCase();
              const priceVal = Number(c.price || c.fee || 0);
              const maxSt = c.max_students || 50;
              const enrolledSt = c.enrolled_count || 0;
              const percent = Math.min(100, Math.round((enrolledSt / maxSt) * 100));
            %>
              <tr class="course-row" 
                  data-search="<%= (c.title + ' ' + (c.batch_name || '') + ' ' + (c.slug || '') + ' ' + (c.description || '') + ' ' + catType).toLowerCase() %>"
                  data-category="<%= catType %>"
                  data-status="<%= cStatus %>"
                  data-title="<%= c.title.toLowerCase() %>"
                  data-price_desc="<%= priceVal %>"
                  data-price_asc="<%= priceVal %>"
                  data-enrolled_desc="<%= enrolledSt %>"
                  data-newest="<%= c.id %>">
                <td>
                  <div style="font-weight: 700; font-size: 13.5px; color: #000000;"><%= c.title %></div>
                  <div class="erp-small" style="color: #64748B; margin-top: 2px;">
                    Batch: <span style="color: #000000; font-weight: 600;"><%= c.batch_name || 'General' %></span>
                  </div>
                </td>
                <td>
                  <span style="text-transform: uppercase; font-size: 11px; font-weight: 700; background: #F1F5F9; color: #000000; padding: 3px 8px; border-radius: 4px; border: 1px solid #E2E8F0;">
                    <%= catType %>
                  </span>
                </td>
                <td>
                  <div style="font-size: 12px; color: #000000; font-weight: 600;">
                    <%= c.start_date ? new Date(c.start_date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'Flexible' %>
                  </div>
                  <div class="erp-small" style="color: #64748B;"><%= c.duration || 'N/A' %></div>
                </td>
                <td>
                  <div style="font-weight: 750; font-size: 14px; color: #000000;">
                    ₹<%= priceVal.toLocaleString('en-IN') %>
                  </div>
                </td>
                <td style="text-align: center;">
                  <div style="font-size: 12px; font-weight: 700; color: #000000; margin-bottom: 4px;">
                    <%= enrolledSt %> / <%= maxSt %>
                  </div>
                  <div style="width: 100%; height: 6px; background: #E2E8F0; border-radius: 99px; overflow: hidden;">
                    <div style="height: 100%; background: #000000; transition: width 0.3s ease; width: <%= percent + '%' %>;"></div>
                  </div>
                </td>
                <td style="text-align: center;">
                  <select class="erp-input" style="padding: 4px 8px; font-size: 11px; font-weight: 700; width: auto; border-color: #CBD5E1; cursor: pointer;" onchange="handleCourseStatusChange('<%= c.id %>', this.value)">
                    <option value="active" <%= cStatus === 'active' ? 'selected' : '' %>>Active</option>
                    <option value="draft" <%= cStatus === 'draft' ? 'selected' : '' %>>Draft</option>
                    <option value="completed" <%= cStatus === 'completed' ? 'selected' : '' %>>Completed</option>
                  </select>
                </td>
                <td style="text-align: right;">
                  <div style="display: inline-flex; gap: 4px; justify-content: flex-end;">
                    <a href="/course/<%= c.slug %>" target="_blank" class="erp-btn erp-btn-ghost" style="padding: 6px; color: #000000;" title="View Public Course Page">
                      <i data-lucide="external-link" style="width: 15px; height: 15px;"></i>
                    </a>
                    <button type="button" onclick="openEditCourseById('<%= c.id %>')" class="erp-btn erp-btn-ghost" style="padding: 6px; color: #000000;" title="Edit Course Details">
                      <i data-lucide="edit-3" style="width: 15px; height: 15px;"></i>
                    </button>
                    <button type="button" onclick="deleteCourse('<%= c.id %>', '<%= c.title %>')" class="erp-btn erp-btn-ghost" style="padding: 6px; color: #DC2626;" title="Delete Program">
                      <i data-lucide="trash-2" style="width: 15px; height: 15px;"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
          <tr class="empty-state-row" style="display: <%= (!courses || courses.length === 0) ? '' : 'none' %>;">
            <td colspan="7" style="text-align: center; padding: 48px; color: #64748B;">
              <div style="font-size: 24px; margin-bottom: 8px; color: #94A3B8;"><i data-lucide="book-open"></i></div>
              <div style="font-weight: 700; color: #000000;">No programs matching current criteria</div>
              <div style="font-size: 13px; color: #64748B; margin-top: 4px;">Adjust your filters or add a new program.</div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- 2. KANBAN / GRID VIEW (Material 3 Cards) -->
<div class="catalogue-kanban-view" data-catalogue="admin_courses">
  <% if (courses && courses.length > 0) { %>
    <% courses.forEach(c => { 
      const catType = (c.category || c.type || 'training').toLowerCase();
      const cStatus = (c.status || (c.is_active == 1 ? 'active' : 'draft')).toLowerCase();
      const priceVal = Number(c.price || c.fee || 0);
      const maxSt = c.max_students || 50;
      const enrolledSt = c.enrolled_count || 0;
      const percent = Math.min(100, Math.round((enrolledSt / maxSt) * 100));
    %>
      <div class="kanban-item-card"
           data-search="<%= (c.title + ' ' + (c.batch_name || '') + ' ' + (c.slug || '') + ' ' + (c.description || '') + ' ' + catType).toLowerCase() %>"
           data-category="<%= catType %>"
           data-status="<%= cStatus %>"
           data-title="<%= c.title.toLowerCase() %>"
           data-price_desc="<%= priceVal %>"
           data-price_asc="<%= priceVal %>"
           data-enrolled_desc="<%= enrolledSt %>"
           data-newest="<%= c.id %>">
        <div class="kanban-card-top">
          <div>
            <div class="kanban-card-title"><%= c.title %></div>
            <div class="kanban-card-subtitle">
              <i data-lucide="<%= catType === 'internship' ? 'briefcase' : 'graduation-cap' %>" style="width: 12px; height: 12px; display: inline-block;"></i>
              <%= catType.toUpperCase() %> • <%= c.batch_name || 'General Batch' %>
            </div>
          </div>
          <span style="font-size: 10px; font-weight: 750; padding: 2px 8px; border-radius: 99px; text-transform: uppercase; <%= cStatus === 'active' ? 'background: #DCFCE7; color: #166534;' : (cStatus === 'draft' ? 'background: #FEF3C7; color: #B45309;' : 'background: #F1F5F9; color: #000;') %>">
            <%= cStatus %>
          </span>
        </div>

        <div class="kanban-card-body">
          <p style="margin: 0; font-size: 12px; color: #475569; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
            <%= c.description || 'Program curriculum, live sessions, project deliverables, and certification.' %>
          </p>

          <div class="kanban-chip-row" style="margin-top: 12px;">
            <div class="kanban-chip" style="font-weight: 750; color: #000;">
              ₹<%= priceVal.toLocaleString('en-IN') %>
            </div>
            <div class="kanban-chip">
              <i data-lucide="clock" style="width: 11px; height: 11px;"></i>
              <%= c.duration || 'Flexible' %>
            </div>
            <div class="kanban-chip">
              <i data-lucide="calendar" style="width: 11px; height: 11px;"></i>
              <%= c.start_date ? new Date(c.start_date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) : 'Open' %>
            </div>
          </div>

          <!-- Capacity Bar -->
          <div style="margin-top: 14px;">
            <div style="display: flex; justify-content: space-between; font-size: 11px; font-weight: 600; color: #64748B; margin-bottom: 4px;">
              <span>Enrolled Students</span>
              <span style="color: #000; font-weight: 700;"><%= enrolledSt %> / <%= maxSt %> (<%= percent %>%)</span>
            </div>
            <div style="width: 100%; height: 6px; background: #E2E8F0; border-radius: 99px; overflow: hidden;">
              <div style="height: 100%; background: #000000; transition: width 0.3s ease; width: <%= percent + '%' %>;"></div>
            </div>
          </div>
        </div>

        <div class="kanban-card-footer">
          <select style="padding: 4px 8px; font-size: 11px; font-weight: 700; border-radius: 6px; border: 1px solid #CBD5E1; background: #fff; cursor: pointer;" onchange="handleCourseStatusChange('<%= c.id %>', this.value)">
            <option value="active" <%= cStatus === 'active' ? 'selected' : '' %>>Active</option>
            <option value="draft" <%= cStatus === 'draft' ? 'selected' : '' %>>Draft</option>
            <option value="completed" <%= cStatus === 'completed' ? 'selected' : '' %>>Completed</option>
          </select>

          <div style="display: inline-flex; gap: 4px;">
            <a href="/course/<%= c.slug %>" target="_blank" class="erp-btn erp-btn-ghost" style="padding: 6px; color: #000;" title="View Public Page">
              <i data-lucide="external-link" style="width: 14px; height: 14px;"></i>
            </a>
            <button type="button" onclick="openEditCourseById('<%= c.id %>')" class="erp-btn erp-btn-ghost" style="padding: 6px; color: #000;" title="Edit Program">
              <i data-lucide="edit-3" style="width: 14px; height: 14px;"></i>
            </button>
            <button type="button" onclick="deleteCourse('<%= c.id %>', '<%= c.title %>')" class="erp-btn erp-btn-ghost" style="padding: 6px; color: #DC2626;" title="Delete Program">
              <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
            </button>
          </div>
        </div>
      </div>
    <% }) %>
  <% } %>
  <div class="kanban-empty-state" style="display: <%= (!courses || courses.length === 0) ? 'block' : 'none' %>;">
    <i data-lucide="book-open" style="width: 36px; height: 36px; margin: 0 auto 10px; color: #94A3B8;"></i>
    <div style="font-weight: 700; font-size: 15px; color: #000;">No Programs Found</div>
    <div style="font-size: 12px; color: #64748B; margin-top: 4px;">No courses or internships matching selected filters.</div>
  </div>
</div>

<!-- Add / Edit Course Modal -->
<div id="courseModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 9999; align-items: center; justify-content: center; padding: 20px; backdrop-filter: blur(4px);">
  <div style="position: relative; width: 100%; max-width: 640px; max-height: 90vh; background: #FFFFFF; border-radius: 12px; border: 1px solid #E2E8F0; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);">
    
    <!-- Modal Header -->
    <div style="padding: 18px 24px; border-bottom: 1px solid #E2E8F0; display: flex; justify-content: space-between; align-items: center; background: #FFFFFF;">
      <div>
        <h3 style="font-size: 16px; font-weight: 700; margin: 0; color: #000000;" id="courseModalTitle">Add New Program</h3>
        <p style="font-size: 12px; color: #64748B; margin: 2px 0 0 0;">Fill in the details for the training or internship curriculum.</p>
      </div>
      <button onclick="closeCourseModal()" style="background: none; border: none; font-size: 22px; cursor: pointer; color: #64748B; padding: 4px; line-height: 1;">&times;</button>
    </div>

    <!-- Modal Form Body -->
    <form id="courseForm" onsubmit="handleCourseSubmit(event)" style="padding: 24px; overflow-y: auto; max-height: calc(90vh - 140px); display: flex; flex-direction: column; gap: 16px;">
      <input type="hidden" id="courseFormId" value="">

      <div>
        <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">Program Title *</label>
        <input type="text" id="courseTitle" name="title" class="erp-input" placeholder="e.g. Full Stack Web Development" required>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">Program Category *</label>
          <select id="courseType" name="type" class="erp-input" required>
            <option value="training">Training Program</option>
            <option value="internship">Internship Track</option>
          </select>
        </div>

        <div>
          <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">Batch Name *</label>
          <input type="text" id="courseBatch" name="batch_name" class="erp-input" placeholder="e.g. Summer 2026 Batch" required>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">Duration *</label>
          <input type="text" id="courseDuration" name="duration" class="erp-input" placeholder="e.g. 1 Month / 4 Weeks" required>
        </div>

        <div>
          <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">Course Fee (₹) *</label>
          <input type="number" id="courseFee" name="fee" class="erp-input" min="0" placeholder="e.g. 3500" required>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px;">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">Start Date</label>
          <input type="date" id="courseStartDate" name="start_date" class="erp-input">
        </div>
        <div>
          <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">End Date</label>
          <input type="date" id="courseEndDate" name="end_date" class="erp-input">
        </div>
        <div>
          <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">Max Students</label>
          <input type="number" id="courseMaxStudents" name="max_students" class="erp-input" min="1" value="50" required>
        </div>
      </div>

      <div>
        <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">Program Description *</label>
        <textarea id="courseDescription" name="description" class="erp-input" rows="3" placeholder="Key skills learned, curriculum highlights, and prerequisites..." required></textarea>
      </div>

      <div>
        <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">Publish Status</label>
        <select id="courseStatus" name="status" class="erp-input">
          <option value="active">Active (Visible & Open for Enrollment)</option>
          <option value="draft">Draft (Internal Only)</option>
          <option value="completed">Completed (Archived)</option>
        </select>
      </div>

      <!-- Modal Footer -->
      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 8px; padding-top: 14px; border-top: 1px solid #E2E8F0;">
        <button type="button" onclick="closeCourseModal()" class="erp-btn erp-btn-ghost" style="color: #64748B; font-size: 13px;">Cancel</button>
        <button type="submit" id="btnCourseSubmit" class="erp-btn erp-btn-primary" style="background: #000000; color: #FFFFFF; font-weight: 600; padding: 8px 18px; border-radius: 6px;">
          Save Program
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openAddCourseModal() {
    document.getElementById('courseModalTitle').textContent = 'Add New Program';
    document.getElementById('courseFormId').value = '';
    document.getElementById('courseForm').reset();
    document.getElementById('courseModal').style.display = 'flex';
  }

  const allCoursesMap = <%- JSON.stringify((courses || []).reduce((acc, c) => Object.assign(acc, { [c.id]: c }), {})) %>;

  function openEditCourseById(id) {
    const course = allCoursesMap[id];
    if (course) openEditCourseModal(course);
  }

  function openEditCourseModal(course) {
    document.getElementById('courseModalTitle').textContent = 'Edit Program: ' + course.title;
    document.getElementById('courseFormId').value = course.id;
    document.getElementById('courseTitle').value = course.title || '';
    document.getElementById('courseType').value = course.category || course.type || 'training';
    document.getElementById('courseBatch').value = course.batch_name || '';
    document.getElementById('courseDuration').value = course.duration || '';
    document.getElementById('courseFee').value = course.price || course.fee || 0;
    
    if (course.start_date) {
      document.getElementById('courseStartDate').value = new Date(course.start_date).toISOString().split('T')[0];
    } else {
      document.getElementById('courseStartDate').value = '';
    }

    if (course.end_date) {
      document.getElementById('courseEndDate').value = new Date(course.end_date).toISOString().split('T')[0];
    } else {
      document.getElementById('courseEndDate').value = '';
    }

    document.getElementById('courseMaxStudents').value = course.max_students || 50;
    document.getElementById('courseDescription').value = course.description || '';
    document.getElementById('courseStatus').value = course.status || (course.is_active == 1 ? 'active' : 'draft');
    
    document.getElementById('courseModal').style.display = 'flex';
  }

  function closeCourseModal() {
    document.getElementById('courseModal').style.display = 'none';
  }

  async function handleCourseSubmit(e) {
    e.preventDefault();
    const courseId = document.getElementById('courseFormId').value;
    const btn = document.getElementById('btnCourseSubmit');
    const origText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = 'Saving...';

    const payload = {
      title: document.getElementById('courseTitle').value,
      type: document.getElementById('courseType').value,
      batch_name: document.getElementById('courseBatch').value,
      duration: document.getElementById('courseDuration').value,
      fee: document.getElementById('courseFee').value,
      start_date: document.getElementById('courseStartDate').value,
      end_date: document.getElementById('courseEndDate').value,
      max_students: document.getElementById('courseMaxStudents').value,
      description: document.getElementById('courseDescription').value,
      status: document.getElementById('courseStatus').value
    };

    try {
      const url = courseId ? `/admin/courses/${courseId}` : '/admin/courses';
      const method = courseId ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method: method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await res.json();
      if (res.ok && data.success) {
        alert(courseId ? 'Program updated successfully!' : 'Program created successfully!');
        window.location.reload();
      } else {
        alert(data.error || 'Failed to save course.');
        btn.disabled = false;
        btn.innerHTML = origText;
      }
    } catch (err) {
      console.error(err);
      alert('Network error.');
      btn.disabled = false;
      btn.innerHTML = origText;
    }
  }

  async function handleCourseStatusChange(courseId, status) {
    try {
      const res = await fetch(`/admin/courses/${courseId}/status`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        // Success
      } else {
        alert('Failed to update status.');
        window.location.reload();
      }
    } catch (err) {
      console.error(err);
      alert('Network error.');
      window.location.reload();
    }
  }

  async function deleteCourse(courseId, title) {
    if (!confirm(`Are you sure you want to delete the program "${title}"?`)) return;

    try {
      const res = await fetch(`/admin/courses/${courseId}`, {
        method: 'DELETE'
      });
      const data = await res.json();
      if (res.ok && data.success) {
        alert('Program deleted successfully.');
        window.location.reload();
      } else {
        alert(data.error || 'Failed to delete program.');
      }
    } catch (err) {
      console.error(err);
      alert('Network error.');
    }
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeCourseModal();
  });

  const modalEl = document.getElementById('courseModal');
  if (modalEl) {
    modalEl.addEventListener('click', (e) => {
      if (e.target.id === 'courseModal') closeCourseModal();
    });
  }
</script>
