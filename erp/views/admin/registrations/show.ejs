<div class="animate-fade-slide-up" style="display: flex; flex-direction: column; gap: 24px;">
  <!-- Header Bar -->
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
    <div>
      <a href="/admin/internships" class="erp-btn erp-btn-secondary" style="font-size: 0.82rem; padding: 6px 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 8px;">
        ← Back to Registrations & Internships
      </a>
      <h1 style="font-size: 1.5rem; font-weight: 700; margin: 0; color: #0f172a;">Registration Details</h1>
    </div>
    <div style="display: flex; gap: 10px;">
      <button type="button" onclick="openEditRegModal()" class="erp-btn erp-btn-primary" style="display: inline-flex; align-items: center; gap: 8px; font-weight: 600;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15.2 4.2a2 2 0 0 1 2.8 0l1.2 1.2a2 2 0 0 1 0 2.8L9 18.4l-4.5.8.8-4.5L15.2 4.2Z" fill="currentColor" fill-opacity="0.2"/><path d="M13 20h7.5"/></svg>
        Edit Registration & Fee
      </button>
    </div>
  </div>

  <div class="grid-3" style="gap: 24px;">
    <!-- Main Registration Details (2 Columns) -->
    <div style="grid-column: span 2; display: flex; flex-direction: column; gap: 24px;">
      
      <!-- Student Profile Card -->
      <div class="erp-card" style="padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; flex-wrap: wrap; gap: 16px;">
          <div style="display: flex; gap: 16px; align-items: center;">
            <div style="width: 58px; height: 58px; border-radius: 50%; background: #0f172a; color: white; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; font-weight: 800; flex-shrink: 0;">
              <%= (reg.first_name || 'S').charAt(0).toUpperCase() %>
            </div>
            <div>
              <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0 0 4px 0; color: #0f172a;"><%= reg.first_name %> <%= reg.last_name %></h2>
              <a href="/admin/students/<%= reg.student_id %>" style="color: #0284c7; text-decoration: none; font-size: 0.85rem; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                View Student Profile →
              </a>
            </div>
          </div>
          
          <div style="text-align: right;">
            <div style="font-size: 0.72rem; text-transform: uppercase; color: #64748b; font-weight: 700; margin-bottom: 4px; letter-spacing: 0.04em;">Registration Code</div>
            <code style="font-size: 1rem; font-weight: 700; color: #0f172a; background: #f1f5f9; padding: 4px 10px; border-radius: 6px; border: 1px solid #e2e8f0;"><%= reg.registration_id %></code>
          </div>
        </div>

        <div class="grid-2" style="gap: 16px;">
          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px 16px;">
            <div style="font-size: 0.72rem; text-transform: uppercase; color: #64748b; font-weight: 700; margin-bottom: 4px;">Email Address</div>
            <div style="font-weight: 600; color: #0f172a; font-size: 0.92rem;"><%= reg.email %></div>
            <div style="font-size: 0.72rem; text-transform: uppercase; color: #64748b; font-weight: 700; margin-top: 12px; margin-bottom: 4px;">Phone / WhatsApp</div>
            <div style="font-weight: 600; color: #0f172a; font-size: 0.92rem;"><%= reg.whatsapp_no || reg.phone || 'N/A' %></div>
          </div>
          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px 16px;">
            <div style="font-size: 0.72rem; text-transform: uppercase; color: #64748b; font-weight: 700; margin-bottom: 4px;">College / Institution</div>
            <div style="font-weight: 600; color: #0f172a; font-size: 0.92rem;"><%= reg.college_name || reg.college || 'N/A' %></div>
            <div style="font-size: 0.72rem; text-transform: uppercase; color: #64748b; font-weight: 700; margin-top: 12px; margin-bottom: 4px;">Degree & Department</div>
            <div style="font-weight: 600; color: #0f172a; font-size: 0.92rem;">
              <%= reg.degree || 'Degree N/A' %><%= reg.department ? ' • ' + reg.department : '' %>
              <% if (reg.year_of_study) { %> (Year <%= reg.year_of_study %>)<% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Course & Enrollment Details -->
      <div class="erp-card" style="padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px; margin-bottom: 16px;">
          <h3 style="font-size: 1.1rem; font-weight: 700; margin: 0; color: #0f172a;">Program & Batch Details</h3>
          <span class="erp-badge erp-badge-secondary" style="text-transform: capitalize;"><%= reg.mode || 'Online' %></span>
        </div>

        <div class="grid-2" style="gap: 16px;">
          <div>
            <div style="font-size: 0.75rem; text-transform: uppercase; color: #64748b; font-weight: 700; margin-bottom: 4px;">Enrolled Program</div>
            <div style="font-weight: 700; font-size: 1.15rem; color: #0f172a; margin-bottom: 8px;"><%= reg.course_title || 'Internship / Course' %></div>
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
              <span class="erp-badge erp-badge-secondary">Batch: <%= reg.batch_name || 'General' %></span>
              <% if (reg.course_type) { %>
                <span class="erp-badge erp-badge-primary" style="text-transform: capitalize;"><%= reg.course_type %></span>
              <% } %>
            </div>
          </div>
          <div>
            <div style="font-size: 0.75rem; text-transform: uppercase; color: #64748b; font-weight: 700; margin-bottom: 4px;">Duration & Timeline</div>
            <div style="font-weight: 600; font-size: 0.95rem; color: #0f172a; margin-bottom: 4px;">
              <%= reg.duration || 'Flexible Timeline' %>
            </div>
            <div style="font-size: 0.82rem; color: #64748b;">
              <% if (reg.start_date) { %>
                Starts: <%= new Date(reg.start_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
              <% } %>
              <% if (reg.end_date) { %>
                • Ends: <%= new Date(reg.end_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Financial Summary Banner -->
        <div style="margin-top: 20px; padding: 16px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;">
          <% if (Number(reg.total_amount || reg.fee || 0) <= 0) { %>
            <div style="display: flex; align-items: center; justify-content: space-between; background: #FEF3C7; border: 1px solid #FCD34D; padding: 14px 18px; border-radius: 8px; flex-wrap: wrap; gap: 12px;">
              <div style="display: flex; align-items: center; gap: 12px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #D97706; flex-shrink: 0;"><circle cx="12" cy="12" r="9.5" fill="currentColor" fill-opacity="0.16"/><path d="M9.4 9.2a2.7 2.7 0 0 1 5.2.9c0 1.8-2.6 2.3-2.6 3.7"/><circle cx="12" cy="17.2" r="1.2" fill="currentColor" stroke="none"/></svg>
                <div>
                  <div style="font-weight: 700; color: #92400E; font-size: 14px;">Fee Structure Not Assigned</div>
                  <div style="font-size: 12px; color: #B45309; margin-top: 2px;">Initial registration submitted without pre-set fee. Assign fee structure so the student can view dues and submit payments.</div>
                </div>
              </div>
              <button type="button" onclick="openEditRegModal()" class="erp-btn" style="background: #D97706; color: #ffffff; border: none; padding: 6px 16px; font-weight: 700; font-size: 12px; border-radius: 6px; cursor: pointer; white-space: nowrap;">
                + Assign Fee
              </button>
            </div>
          <% } else { %>
            <div class="grid-3" style="gap: 16px; text-align: center;">
              <div>
                <div style="font-size: 0.72rem; text-transform: uppercase; color: #64748b; font-weight: 700; margin-bottom: 4px;">Total Program Fee</div>
                <div style="font-weight: 800; font-size: 1.25rem; color: #0f172a;">₹<%= (reg.total_amount || reg.fee || 0).toLocaleString('en-IN') %></div>
              </div>
              <div>
                <div style="font-size: 0.72rem; text-transform: uppercase; color: #64748b; font-weight: 700; margin-bottom: 4px;">Paid to Date</div>
                <div style="font-weight: 800; font-size: 1.25rem; color: #15803d;">₹<%= (reg.paid_amount || 0).toLocaleString('en-IN') %></div>
              </div>
              <div>
                <div style="font-size: 0.72rem; text-transform: uppercase; color: #64748b; font-weight: 700; margin-bottom: 4px;">Balance Due</div>
                <div style="font-weight: 800; font-size: 1.25rem; color: <%= (reg.balance_amount || 0) > 0 ? '#b91c1c' : '#15803d' %>;">
                  ₹<%= (reg.balance_amount || 0).toLocaleString('en-IN') %>
                </div>
              </div>
            </div>
          <% } %>
          <% if (reg.referral_code) { %>
            <div style="margin-top: 12px; padding-top: 10px; border-top: 1px dashed #e2e8f0; font-size: 0.8rem; color: #64748b; text-align: center;">
              Applied Referral Code: <strong style="color: #0f172a;"><%= reg.referral_code %></strong>
            </div>
          <% } %>
          <% if (reg.notes) { %>
            <div style="margin-top: 8px; font-size: 0.8rem; color: #64748b; text-align: center; font-style: italic;">
              Note: "<%= reg.notes %>"
            </div>
          <% } %>
        </div>
      </div>

      <!-- Payment Records Table -->
      <div class="erp-card" style="padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px; margin-bottom: 16px;">
          <h3 style="font-size: 1.1rem; font-weight: 700; margin: 0; color: #0f172a;">Payment Transactions</h3>
          <span class="erp-badge erp-badge-secondary"><%= payments ? payments.length : 0 %> Records</span>
        </div>

        <% if (payments && payments.length > 0) { %>
          <div style="overflow-x: auto;">
            <table class="erp-table">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Receipt / Txn ID</th>
                  <th>Amount</th>
                  <th>Payment Method</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% payments.forEach(p => { %>
                  <tr>
                    <td style="white-space: nowrap; font-size: 0.85rem;"><%= new Date(p.created_at || p.paid_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                    <td style="font-family: monospace; font-size: 0.85rem; font-weight: 600;"><%= p.transaction_id || p.invoice_number || 'TRX-DEFAULT' %></td>
                    <td style="font-weight: 700; font-size: 0.92rem; color: #0f172a;">₹<%= (p.amount || 0).toLocaleString('en-IN') %></td>
                    <td style="text-transform: capitalize; font-size: 0.85rem;"><%= p.method || p.payment_method || 'UPI / Gateway' %></td>
                    <td>
                      <span class="erp-badge <%= (p.status === 'completed' || p.status === 'success') ? 'erp-badge-success' : ((p.status === 'pending') ? 'erp-badge-warning' : 'erp-badge-danger') %>">
                        <%= p.status || 'completed' %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div style="text-align: center; padding: 32px 16px; color: #64748b; background: #f8fafc; border-radius: 8px; border: 1px dashed #cbd5e1;">
            <p style="margin: 0; font-weight: 600; color: #334155;">No Payment Transactions Found</p>
            <p style="margin: 4px 0 0 0; font-size: 0.82rem;">No online or manual receipts are currently linked to this registration.</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Registration Status & Actions Sidebar (1 Column) -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
      <div class="erp-card" style="padding: 24px;">
        <h3 style="font-size: 1.1rem; font-weight: 700; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px; margin-bottom: 20px; color: #0f172a;">Registration Status</h3>
        
        <div style="margin-bottom: 20px;">
          <div style="font-size: 0.75rem; text-transform: uppercase; color: #64748b; font-weight: 700; margin-bottom: 6px;">Current Status</div>
          <div>
            <% if (reg.status === 'completed' || reg.status === 'active') { %>
              <span class="erp-badge erp-badge-success" style="font-size: 0.85rem; padding: 4px 10px;">Active / Completed</span>
            <% } else if (reg.status === 'pending_payment' || reg.status === 'pending') { %>
              <span class="erp-badge erp-badge-warning" style="font-size: 0.85rem; padding: 4px 10px;">Pending Payment</span>
            <% } else if (reg.status === 'rejected' || reg.status === 'cancelled') { %>
              <span class="erp-badge erp-badge-danger" style="font-size: 0.85rem; padding: 4px 10px;"><%= reg.status %></span>
            <% } else { %>
              <span class="erp-badge erp-badge-secondary" style="font-size: 0.85rem; padding: 4px 10px;"><%= reg.status %></span>
            <% } %>
          </div>
        </div>

        <div style="margin-bottom: 20px;">
          <div style="font-size: 0.75rem; text-transform: uppercase; color: #64748b; font-weight: 700; margin-bottom: 6px;">Enrolled On</div>
          <div style="font-weight: 600; font-size: 0.92rem; color: #0f172a;">
            <%= reg.created_at ? new Date(reg.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'N/A' %>
          </div>
        </div>

        <div style="border-top: 1px solid #e2e8f0; padding-top: 16px;">
          <label style="font-size: 0.8rem; font-weight: 600; color: #334155; display: block; margin-bottom: 8px;">Quick Status Update</label>
          <select id="statusSelect" class="erp-input" style="margin-bottom: 12px; width: 100%;">
            <option value="pending_payment" <%= reg.status === 'pending_payment' || reg.status === 'pending' ? 'selected' : '' %>>Pending Payment</option>
            <option value="completed" <%= reg.status === 'completed' || reg.status === 'active' ? 'selected' : '' %>>Completed / Active</option>
            <option value="cancelled" <%= reg.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
            <option value="rejected" <%= reg.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
          </select>
          <button type="button" id="quickStatusBtn" onclick="updateRegistrationStatus('<%= reg.id %>')" class="erp-btn erp-btn-primary" style="width: 100%; justify-content: center;">
            Update Status
          </button>
        </div>

        <div style="border-top: 1px solid #e2e8f0; padding-top: 16px; margin-top: 16px;">
          <button type="button" onclick="openEditRegModal()" class="erp-btn erp-btn-secondary" style="width: 100%; justify-content: center; font-weight: 600;">
            Edit All Record Details
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Edit Registration Modal -->
<div id="editRegModal" class="modal-overlay" style="display: none;">
  <div class="modal" style="max-width: 680px;">
    <div class="modal-header">
      <h3 class="modal-title">Edit Registration & Enrollment</h3>
      <button type="button" class="modal-close" onclick="closeEditRegModal()">&times;</button>
    </div>
    <form id="editRegForm" onsubmit="handleEditRegSubmit(event)">
      <div class="modal-body" style="display: flex; flex-direction: column; gap: 16px;">
        
        <!-- Student Info Header -->
        <div style="font-size: 0.82rem; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.04em;">Student Details</div>
        <div class="grid-2" style="gap: 14px;">
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 5px; color: #334155;">First Name *</label>
            <input type="text" name="first_name" id="regEditFirstName" required class="erp-input" value="<%= reg.first_name || '' %>">
          </div>
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 5px; color: #334155;">Last Name *</label>
            <input type="text" name="last_name" id="regEditLastName" required class="erp-input" value="<%= reg.last_name || '' %>">
          </div>
        </div>

        <div class="grid-2" style="gap: 14px;">
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 5px; color: #334155;">Email *</label>
            <input type="email" name="email" id="regEditEmail" required class="erp-input" value="<%= reg.email || '' %>">
          </div>
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 5px; color: #334155;">Phone / WhatsApp</label>
            <input type="text" name="phone" id="regEditPhone" class="erp-input" value="<%= reg.whatsapp_no || reg.phone || '' %>">
          </div>
        </div>

        <div class="grid-2" style="gap: 14px;">
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 5px; color: #334155;">College</label>
            <input type="text" name="college" id="regEditCollege" class="erp-input" value="<%= reg.college_name || reg.college || '' %>">
          </div>
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 5px; color: #334155;">Department / Major</label>
            <input type="text" name="department" id="regEditDepartment" class="erp-input" value="<%= reg.department || '' %>">
          </div>
        </div>

        <!-- Enrollment Info -->
        <div style="font-size: 0.82rem; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.04em; margin-top: 8px;">Program & Schedule</div>
        <div class="grid-2" style="gap: 14px;">
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 5px; color: #334155;">Batch Name</label>
            <input type="text" name="batch_name" id="regEditBatch" class="erp-input" value="<%= reg.batch_name || 'General' %>">
          </div>
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 5px; color: #334155;">Mode</label>
            <select name="mode" id="regEditMode" class="erp-input">
              <option value="online" <%= (reg.mode === 'online') ? 'selected' : '' %>>Online</option>
              <option value="offline" <%= (reg.mode === 'offline') ? 'selected' : '' %>>Offline / On-Campus</option>
              <option value="hybrid" <%= (reg.mode === 'hybrid') ? 'selected' : '' %>>Hybrid</option>
            </select>
          </div>
        </div>

        <div class="grid-2" style="gap: 14px;">
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 5px; color: #334155;">Start Date</label>
            <input type="date" name="start_date" id="regEditStartDate" class="erp-input" value="<%= reg.start_date ? reg.start_date.split('T')[0] : '' %>">
          </div>
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 5px; color: #334155;">End Date</label>
            <input type="date" name="end_date" id="regEditEndDate" class="erp-input" value="<%= reg.end_date ? reg.end_date.split('T')[0] : '' %>">
          </div>
        </div>

        <!-- Financial Info -->
        <div style="font-size: 0.82rem; font-weight: 700; text-transform: uppercase; color: #64748b; letter-spacing: 0.04em; margin-top: 8px;">Fee & Payment Details</div>
        <div class="grid-3" style="gap: 14px;">
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 5px; color: #334155;">Total Amount (₹)</label>
            <input type="number" step="0.01" name="total_amount" id="regEditTotalAmount" oninput="calculateBalance()" class="erp-input" value="<%= reg.total_amount || reg.fee || 0 %>">
          </div>
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 5px; color: #334155;">Paid Amount (₹)</label>
            <input type="number" step="0.01" name="paid_amount" id="regEditPaidAmount" oninput="calculateBalance()" class="erp-input" value="<%= reg.paid_amount || 0 %>">
          </div>
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 5px; color: #334155;">Balance Due (₹)</label>
            <input type="number" step="0.01" name="balance_amount" id="regEditBalanceAmount" readonly class="erp-input" style="background: #f1f5f9;" value="<%= reg.balance_amount || 0 %>">
          </div>
        </div>

        <div class="grid-2" style="gap: 14px;">
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 5px; color: #334155;">Status</label>
            <select name="status" id="regEditStatus" class="erp-input">
              <option value="pending_payment" <%= reg.status === 'pending_payment' || reg.status === 'pending' ? 'selected' : '' %>>Pending Payment</option>
              <option value="completed" <%= reg.status === 'completed' || reg.status === 'active' ? 'selected' : '' %>>Completed / Active</option>
              <option value="cancelled" <%= reg.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
              <option value="rejected" <%= reg.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
            </select>
          </div>
          <div>
            <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 5px; color: #334155;">Referral Code</label>
            <input type="text" name="referral_code" id="regEditReferral" class="erp-input" value="<%= reg.referral_code || '' %>" style="text-transform: uppercase; font-family: monospace;">
            <div id="regEditReferralFeedback" style="font-size: 0.75rem; font-weight: 600; margin-top: 4px; display: none;"></div>
          </div>
        </div>

        <div>
          <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 5px; color: #334155;">Internal Notes</label>
          <textarea name="notes" id="regEditNotes" rows="2" class="erp-input" style="resize: vertical;"><%= reg.notes || '' %></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="erp-btn erp-btn-secondary" onclick="closeEditRegModal()">Cancel</button>
        <button type="submit" id="saveRegBtn" class="erp-btn erp-btn-primary">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<div id="erpToast" class="erp-toast"></div>

<script>
  function showToast(msg, type = 'success') {
    const toast = document.getElementById('erpToast');
    if (!toast) return;
    toast.textContent = msg;
    toast.className = `erp-toast show ${type}`;
    setTimeout(() => {
      toast.className = 'erp-toast';
    }, 3500);
  }

  function openEditRegModal() {
    document.getElementById('editRegModal').style.display = 'flex';
  }

  function closeEditRegModal() {
    document.getElementById('editRegModal').style.display = 'none';
  }

  function calculateBalance() {
    const total = parseFloat(document.getElementById('regEditTotalAmount').value) || 0;
    const paid = parseFloat(document.getElementById('regEditPaidAmount').value) || 0;
    const bal = Math.max(0, total - paid);
    document.getElementById('regEditBalanceAmount').value = bal.toFixed(2);
  }

  async function updateRegistrationStatus(id) {
    const status = document.getElementById('statusSelect').value;
    const btn = document.getElementById('quickStatusBtn');
    btn.disabled = true;
    btn.textContent = 'Updating...';

    try {
      const res = await fetch(`/admin/registrations/${id}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      });
      const data = await res.json();
      if (res.ok && (data.success || !data.error)) {
        showToast('Registration status updated!', 'success');
        setTimeout(() => location.reload(), 800);
      } else {
        throw new Error(data.error || data.message || 'Failed to update status');
      }
    } catch (err) {
      showToast(err.message, 'error');
      btn.disabled = false;
      btn.textContent = 'Update Status';
    }
  }

  async function handleEditRegSubmit(e) {
    e.preventDefault();
    const btn = document.getElementById('saveRegBtn');
    const originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Saving...';

    const payload = {
      first_name: document.getElementById('regEditFirstName').value.trim(),
      last_name: document.getElementById('regEditLastName').value.trim(),
      email: document.getElementById('regEditEmail').value.trim(),
      phone: document.getElementById('regEditPhone').value.trim(),
      college: document.getElementById('regEditCollege').value.trim(),
      department: document.getElementById('regEditDepartment').value.trim(),
      batch_name: document.getElementById('regEditBatch').value.trim(),
      mode: document.getElementById('regEditMode').value,
      start_date: document.getElementById('regEditStartDate').value || null,
      end_date: document.getElementById('regEditEndDate').value || null,
      total_amount: parseFloat(document.getElementById('regEditTotalAmount').value) || 0,
      paid_amount: parseFloat(document.getElementById('regEditPaidAmount').value) || 0,
      balance_amount: parseFloat(document.getElementById('regEditBalanceAmount').value) || 0,
      status: document.getElementById('regEditStatus').value,
      referral_code: document.getElementById('regEditReferral').value.trim(),
      notes: document.getElementById('regEditNotes').value.trim()
    };

    try {
      const res = await fetch('/admin/registrations/<%= reg.id %>', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (res.ok && (data.success || !data.error)) {
        showToast(data.message || 'Registration details updated successfully!', 'success');
        closeEditRegModal();
        setTimeout(() => location.reload(), 800);
      } else {
        throw new Error(data.error || data.message || 'Failed to update registration.');
      }
    } catch (err) {
      showToast(err.message, 'error');
      btn.disabled = false;
      btn.textContent = originalText;
    }
  }

  // Live referral code validation in registration edit modal
  let regRefTimer = null;
  const regRefInput = document.getElementById('regEditReferral');
  const regRefFeedback = document.getElementById('regEditReferralFeedback');
  if (regRefInput && regRefFeedback) {
    if (regRefInput.value.trim()) {
      regRefFeedback.style.display = 'block';
      regRefFeedback.style.color = '#16a34a';
      regRefFeedback.textContent = `Current assigned code: ${regRefInput.value.trim().toUpperCase()}`;
    }

    regRefInput.addEventListener('input', function() {
      clearTimeout(regRefTimer);
      const code = this.value.trim().toUpperCase();
      this.value = code;

      if (!code) {
        regRefFeedback.style.display = 'none';
        regRefFeedback.textContent = '';
        return;
      }

      regRefFeedback.style.display = 'block';
      regRefFeedback.style.color = '#64748b';
      regRefFeedback.textContent = 'Validating code...';

      regRefTimer = setTimeout(async () => {
        try {
          const res = await fetch(`/api/referrals/validate/${encodeURIComponent(code)}`);
          const json = await res.json();
          if (res.ok && json.valid) {
            regRefFeedback.style.color = '#16a34a';
            regRefFeedback.textContent = `✓ Valid: ${json.referrerName} (${json.discountPercent}% discount)`;
          } else {
            regRefFeedback.style.color = '#dc2626';
            regRefFeedback.textContent = `✕ ${json.message || 'Invalid or inactive code'}`;
          }
        } catch (e) {
          regRefFeedback.style.color = '#d97706';
          regRefFeedback.textContent = '⚠ Network check error';
        }
      }, 300);
    });
  }

  // Close modal when clicking outside
  document.getElementById('editRegModal')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('editRegModal')) {
      closeEditRegModal();
    }
  });
</script>
