<div class="erp-h1" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>Payment Verifications & Records</div>
  <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 10px;">
    <% const adminPayUpi = (typeof paymentConfig !== 'undefined' && paymentConfig && paymentConfig.upi_id) ? paymentConfig.upi_id : '6379000598@amazonpay'; %>
    <div style="display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 8px; font-size: 12px; font-weight: 600; color: #1E40AF;">
      <i data-lucide="qr-code" style="width: 15px; height: 15px;"></i>
      <span>UPI: <strong style="font-family: monospace;"><%= adminPayUpi %></strong></span>
      <a href="/api/payments/qr" target="_blank" style="color: #155EEF; text-decoration: underline; font-weight: 700;">View QR</a>
    </div>
    <a href="/admin/settings" style="font-size: 12px; color: #64748B; text-decoration: none; font-weight: 600;">Payment Settings</a>
  </div>
</div>

<!-- Unified Catalogue Toolbar with View Switcher & Multi-Filters -->
<!-- Summary Metric Cards -->
<%
  const totalPayments = payments ? payments.length : 0;
  const verifiedPayments = payments ? payments.filter(p => p.status === 'completed').length : 0;
  const pendingPayments = payments ? payments.filter(p => p.status === 'pending').length : 0;
  const totalAmountCleared = payments ? payments.filter(p => p.status === 'completed').reduce((sum, p) => sum + Number(p.amount || 0), 0) : 0;
%>
<div class="erp-grid-4" style="margin-bottom: 24px;">
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="indian-rupee"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Total Verified Fee</div>
    </div>
    <div class="erp-card-value" style="color: #000000;">₹<%= totalAmountCleared.toLocaleString('en-IN') %></div>
    <div class="erp-p" style="margin-top: 6px; color: #16A34A; font-weight: 600; font-size: 12px;">Cleared collections</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="receipt"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Transactions</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= totalPayments %></div>
    <div class="erp-p" style="margin-top: 6px; color: #64748B; font-size: 12px;">Total receipts logged</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="check-circle-2"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Verified Cleared</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= verifiedPayments %></div>
    <div class="erp-p" style="margin-top: 6px; color: #16A34A; font-weight: 600; font-size: 12px;">UTR confirmed</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="clock"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Pending Verification</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= pendingPayments %></div>
    <div class="erp-p" style="margin-top: 6px; color: #D97706; font-weight: 600; font-size: 12px;">Needs review</div>
  </div>
</div>
<div class="catalogue-toolbar" data-catalogue="admin_payments">
  <div class="catalogue-search-wrap">
    <i data-lucide="search" class="catalogue-search-icon"></i>
    <input type="text" class="catalogue-search-input" placeholder="Search UTR, student name, course, ID...">
  </div>

  <div class="catalogue-filters-group">
    <select class="catalogue-select" data-filter="status" title="Filter by Status">
      <option value="all">All Statuses (<%= payments ? payments.length : 0 %>)</option>
      <option value="completed">Verified / Cleared</option>
      <option value="pending">Pending Review</option>
      <option value="failed">Rejected / Failed</option>
    </select>

    <select class="catalogue-select" data-filter="method" title="Filter by Payment Method">
      <option value="all">All Methods</option>
      <option value="upi">UPI</option>
      <option value="bank">Bank Transfer</option>
      <option value="cash">Cash</option>
      <option value="card">Card</option>
    </select>

    <select class="catalogue-select" data-filter="sort" title="Sort by">
      <option value="newest">Sort: Newest First</option>
      <option value="oldest">Sort: Oldest First</option>
      <option value="amount_desc">Sort: Amount (High to Low)</option>
      <option value="amount_asc">Sort: Amount (Low to High)</option>
      <option value="name">Sort: Student Name (A-Z)</option>
    </select>

    <button type="button" class="catalogue-reset-btn" title="Reset all filters">
      <i data-lucide="rotate-ccw"></i> Reset
    </button>
  </div>

  <div class="catalogue-view-switcher">
    <button type="button" class="view-btn active" data-view="list" title="Table / List View">
      <i data-lucide="list"></i> List
    </button>
    <button type="button" class="view-btn" data-view="kanban" title="Kanban / Grid View">
      <i data-lucide="layout-grid"></i> Kanban
    </button>
  </div>

  <div class="catalogue-count-badge">
    Showing <%= payments ? payments.length : 0 %> payments
  </div>
</div>

<!-- 1. LIST VIEW (Responsive Data Table) -->
<div class="catalogue-list-view" data-catalogue="admin_payments">
  <div class="erp-card" style="padding: 0; background: #FFFFFF; border: 1px solid #E2E8F0; overflow: hidden;">
    <div class="erp-table-container" style="border: none; border-radius: 0; margin-bottom: 0;">
      <table class="erp-table" id="paymentsTable">
        <thead>
          <tr>
            <th style="width: 140px; color: #000000;">Date & ID</th>
            <th style="width: 160px; color: #000000;">UTR / Trans. ID</th>
            <th style="color: #000000;">Student & Course</th>
            <th style="width: 120px; color: #000000;">Amount</th>
            <th style="width: 100px; color: #000000;">Method</th>
            <th style="width: 120px; text-align: center; color: #000000;">Screenshot</th>
            <th style="width: 130px; text-align: center; color: #000000;">Status</th>
            <th style="width: 160px; text-align: right; color: #000000;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (payments && payments.length > 0) { %>
            <% payments.forEach(p => { 
              const studentName = `${p.first_name || ''} ${p.last_name || ''}`.trim();
              const amt = Number(p.total_amount || p.amount || 0);
              const pStatus = (p.status || 'pending').toLowerCase();
              const pMethod = (p.payment_method || 'upi').toLowerCase();
            %>
              <tr class="payment-row"
                  data-search="<%= (studentName + ' ' + (p.transaction_id || '') + ' ' + (p.payment_id || p.id || '') + ' ' + (p.course_title || '') + ' ' + (p.email || '') + ' ' + pMethod).toLowerCase() %>"
                  data-status="<%= pStatus %>"
                  data-method="<%= pMethod %>"
                  data-name="<%= studentName.toLowerCase() %>"
                  data-amount_desc="<%= amt %>"
                  data-amount_asc="<%= amt %>"
                  data-newest="<%= new Date(p.created_at).getTime() %>"
                  data-oldest="<%= new Date(p.created_at).getTime() %>">
                <td>
                  <div style="font-weight: 600; font-size: 13px; color: #000000;">
                    <%= new Date(p.created_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                  </div>
                  <div class="erp-small" style="font-family: monospace; color: #64748B;"><%= p.payment_id || p.id %></div>
                </td>
                <td>
                  <div style="font-family: monospace; font-weight: 700; font-size: 13px; color: #000000; word-break: break-all;">
                    <%= p.transaction_id || 'N/A' %>
                  </div>
                </td>
                <td>
                  <div style="font-weight: 700; font-size: 13px; color: #000000;"><%= studentName %></div>
                  <div class="erp-small" style="color: #64748B;"><%= p.course_title || p.email %></div>
                </td>
                <td>
                  <div style="font-weight: 750; font-size: 14px; color: #000000;">
                    ₹<%= amt.toLocaleString('en-IN') %>
                  </div>
                </td>
                <td>
                  <span style="text-transform: uppercase; font-size: 11px; font-weight: 700; background: #F1F5F9; color: #000000; padding: 3px 8px; border-radius: 4px; border: 1px solid #E2E8F0;">
                    <%= p.payment_method || 'UPI' %>
                  </span>
                </td>
                <td style="text-align: center;">
                  <% if (p.receipt_path) { %>
                    <button type="button" onclick="previewProofModal('<%= p.receipt_path %>', '<%= p.transaction_id %>', '<%= studentName %>', '<%= amt %>', '<%= p.id %>', '<%= p.status %>')" class="erp-btn erp-btn-secondary" style="padding: 5px 10px; font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px; border: 1px solid #CBD5E1; color: #000000;">
                      <i data-lucide="image" style="width: 13px; height: 13px;"></i> View Proof
                    </button>
                  <% } else { %>
                    <span style="color: #94A3B8; font-size: 12px;">No proof</span>
                  <% } %>
                </td>
                <td style="text-align: center;">
                  <% if (pStatus === 'completed' || pStatus === 'confirmed') { %>
                    <span style="display: inline-block; padding: 3px 10px; background: #DCFCE7; color: #166534; border-radius: 99px; font-size: 11px; font-weight: 700;">
                      Verified
                    </span>
                  <% } else if (pStatus === 'failed' || pStatus === 'rejected') { %>
                    <span style="display: inline-block; padding: 3px 10px; background: #FEE2E2; color: #B91C1C; border-radius: 99px; font-size: 11px; font-weight: 700;">
                      Rejected
                    </span>
                  <% } else { %>
                    <span style="display: inline-block; padding: 3px 10px; background: #FEF3C7; color: #B45309; border-radius: 99px; font-size: 11px; font-weight: 700;">
                      Pending
                    </span>
                  <% } %>
                </td>
                <td style="text-align: right;">
                  <% if (pStatus === 'pending') { %>
                    <div style="display: inline-flex; gap: 6px; justify-content: flex-end;">
                      <button type="button" onclick="verifyPaymentAdmin('<%= p.id %>', 'completed')" class="erp-btn erp-btn-primary" style="padding: 5px 10px; font-size: 12px; font-weight: 600; background: #000000; color: #FFFFFF; border-radius: 6px;" title="Approve Payment & Confirm Registration">
                        <i data-lucide="check" style="width: 13px; height: 13px;"></i> Approve
                      </button>
                      <button type="button" onclick="verifyPaymentAdmin('<%= p.id %>', 'failed')" class="erp-btn erp-btn-secondary" style="padding: 5px 8px; font-size: 12px; font-weight: 600; color: #000000; border: 1px solid #CBD5E1; border-radius: 6px;" title="Reject Payment">
                        <i data-lucide="x" style="width: 13px; height: 13px;"></i> Reject
                      </button>
                    </div>
                  <% } else if (pStatus === 'completed' || pStatus === 'confirmed') { %>
                    <span style="font-size: 12px; color: #166534; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;">
                      <i data-lucide="check-circle-2" style="width: 14px; height: 14px;"></i> Cleared
                    </span>
                  <% } else { %>
                    <button type="button" onclick="verifyPaymentAdmin('<%= p.id %>', 'completed')" class="erp-btn erp-btn-ghost" style="padding: 4px 8px; font-size: 12px; color: #000000; font-weight: 600;">
                      Re-approve
                    </button>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } %>
          <tr class="empty-state-row" style="display: <%= (!payments || payments.length === 0) ? '' : 'none' %>;">
            <td colspan="8" style="text-align: center; padding: 48px; color: #64748B;">
              <div style="font-size: 24px; margin-bottom: 8px; color: #94A3B8;"><i data-lucide="credit-card"></i></div>
              <div style="font-weight: 700; color: #000000;">No payment records found</div>
              <div style="font-size: 13px; color: #64748B; margin-top: 4px;">Uploaded student payment proofs will appear here for verification.</div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- 2. KANBAN / GRID VIEW (Material 3 Cards) -->
<div class="catalogue-kanban-view" data-catalogue="admin_payments">
  <% if (payments && payments.length > 0) { %>
    <% payments.forEach(p => { 
      const studentName = `${p.first_name || ''} ${p.last_name || ''}`.trim();
      const amt = Number(p.total_amount || p.amount || 0);
      const pStatus = (p.status || 'pending').toLowerCase();
      const pMethod = (p.payment_method || 'upi').toLowerCase();
    %>
      <div class="kanban-item-card"
           data-search="<%= (studentName + ' ' + (p.transaction_id || '') + ' ' + (p.payment_id || p.id || '') + ' ' + (p.course_title || '') + ' ' + (p.email || '') + ' ' + pMethod).toLowerCase() %>"
           data-status="<%= pStatus %>"
           data-method="<%= pMethod %>"
           data-name="<%= studentName.toLowerCase() %>"
           data-amount_desc="<%= amt %>"
           data-amount_asc="<%= amt %>"
           data-newest="<%= new Date(p.created_at).getTime() %>"
           data-oldest="<%= new Date(p.created_at).getTime() %>">
        <div class="kanban-card-top">
          <div>
            <div class="kanban-card-title"><%= studentName %></div>
            <div class="kanban-card-subtitle">
              <i data-lucide="book-open" style="width: 12px; height: 12px; display: inline-block;"></i>
              <%= p.course_title || 'Enrolled Program' %>
            </div>
          </div>
          <% if (pStatus === 'completed' || pStatus === 'confirmed') { %>
            <span style="font-size: 10px; font-weight: 750; padding: 2px 8px; border-radius: 99px; text-transform: uppercase; background: #DCFCE7; color: #166534;">
              Verified
            </span>
          <% } else if (pStatus === 'failed' || pStatus === 'rejected') { %>
            <span style="font-size: 10px; font-weight: 750; padding: 2px 8px; border-radius: 99px; text-transform: uppercase; background: #FEE2E2; color: #B91C1C;">
              Rejected
            </span>
          <% } else { %>
            <span style="font-size: 10px; font-weight: 750; padding: 2px 8px; border-radius: 99px; text-transform: uppercase; background: #FEF3C7; color: #B45309;">
              Pending
            </span>
          <% } %>
        </div>

        <div class="kanban-card-body">
          <div style="font-size: 22px; font-weight: 800; color: #000; margin: 4px 0 10px;">
            ₹<%= amt.toLocaleString('en-IN') %>
          </div>

          <div class="kanban-chip-row">
            <div class="kanban-chip" style="font-family: monospace; font-size: 11px;">
              UTR: <%= p.transaction_id || 'N/A' %>
            </div>
            <div class="kanban-chip" style="text-transform: uppercase;">
              <%= p.payment_method || 'UPI' %>
            </div>
            <div class="kanban-chip">
              <i data-lucide="calendar" style="width: 11px; height: 11px;"></i>
              <%= new Date(p.created_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) %>
            </div>
          </div>
        </div>

        <div class="kanban-card-footer">
          <% if (p.receipt_path) { %>
            <button type="button" onclick="previewProofModal('<%= p.receipt_path %>', '<%= p.transaction_id %>', '<%= studentName %>', '<%= amt %>', '<%= p.id %>', '<%= p.status %>')" class="erp-btn erp-btn-secondary" style="padding: 4px 10px; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px; border: 1px solid #CBD5E1;">
              <i data-lucide="image" style="width: 12px; height: 12px;"></i> View Proof
            </button>
          <% } else { %>
            <span style="font-size: 11px; color: #94A3B8;">No Proof</span>
          <% } %>

          <div style="display: inline-flex; gap: 6px;">
            <% if (pStatus === 'pending') { %>
              <button type="button" onclick="verifyPaymentAdmin('<%= p.id %>', 'completed')" class="erp-btn erp-btn-primary" style="padding: 4px 10px; font-size: 11px; font-weight: 600; background: #000; color: #fff;">
                <i data-lucide="check" style="width: 12px; height: 12px;"></i> Approve
              </button>
              <button type="button" onclick="verifyPaymentAdmin('<%= p.id %>', 'failed')" class="erp-btn erp-btn-secondary" style="padding: 4px 8px; font-size: 11px; font-weight: 600; color: #000; border: 1px solid #CBD5E1;">
                <i data-lucide="x" style="width: 12px; height: 12px;"></i> Reject
              </button>
            <% } else { %>
              <button type="button" onclick="verifyPaymentAdmin('<%= p.id %>', 'completed')" class="erp-btn erp-btn-ghost" style="padding: 4px 8px; font-size: 11px; font-weight: 600;">
                Re-verify
              </button>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  <% } %>
  <div class="kanban-empty-state" style="display: <%= (!payments || payments.length === 0) ? 'block' : 'none' %>;">
    <i data-lucide="credit-card" style="width: 36px; height: 36px; margin: 0 auto 10px; color: #94A3B8;"></i>
    <div style="font-weight: 700; font-size: 15px; color: #000;">No Payments Found</div>
    <div style="font-size: 12px; color: #64748B; margin-top: 4px;">No transaction records matching filter criteria.</div>
  </div>
</div>

<!-- Payment Proof Inspection Modal -->
<div id="proofModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.75); z-index: 9999; align-items: center; justify-content: center; padding: 20px; backdrop-filter: blur(4px);">
  <div style="position: relative; width: 100%; max-width: 600px; max-height: 90vh; background: #FFFFFF; border-radius: 12px; border: 1px solid #E2E8F0; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);">
    <div style="padding: 16px 20px; border-bottom: 1px solid #E2E8F0; display: flex; justify-content: space-between; align-items: center; background: #FFFFFF;">
      <div>
        <h3 style="font-size: 15px; font-weight: 700; margin: 0; color: #000000;" id="proofModalStudent">Payment Proof Verification</h3>
        <p style="font-size: 12px; color: #64748B; margin: 2px 0 0 0;" id="proofModalDetails">UTR Reference • Amount</p>
      </div>
      <button onclick="closeProofModal()" style="background: none; border: none; font-size: 22px; cursor: pointer; color: #64748B; padding: 4px; line-height: 1; border-radius: 4px;">&times;</button>
    </div>

    <div style="padding: 20px; text-align: center; overflow-y: auto; max-height: calc(90vh - 140px); background: #F8FAFC; display: flex; flex-direction: column; align-items: center; justify-content: center;">
      <img id="proofModalImage" src="" alt="Payment Screenshot Proof" style="max-width: 100%; max-height: 480px; border-radius: 8px; border: 1px solid #E2E8F0; object-fit: contain; background: #FFFFFF;">
      <div id="proofModalPdfLink" style="display: none; padding: 24px; text-align: center;">
        <a id="proofPdfHref" href="" target="_blank" class="erp-btn erp-btn-primary" style="background: #000000; color: #FFFFFF; padding: 10px 18px;">
          <i data-lucide="external-link" style="width: 14px; height: 14px;"></i> Open PDF Proof in New Tab
        </a>
      </div>
    </div>

    <div id="proofModalActions" style="padding: 14px 20px; border-top: 1px solid #E2E8F0; background: #FFFFFF; display: flex; justify-content: space-between; align-items: center;">
      <button type="button" onclick="closeProofModal()" class="erp-btn erp-btn-ghost" style="color: #64748B; font-size: 13px;">Close</button>
      <div id="proofModalButtons" style="display: flex; gap: 8px;">
      </div>
    </div>
  </div>
</div>

<script>
  let activeProofPaymentId = null;

  function previewProofModal(path, utr, studentName, amount, paymentId, status) {
    activeProofPaymentId = paymentId;
    document.getElementById('proofModal').style.display = 'flex';
    document.getElementById('proofModalStudent').textContent = `Payment Proof: ${studentName}`;
    document.getElementById('proofModalDetails').textContent = `UTR: ${utr || 'N/A'} • Amount: ₹${Number(amount || 0).toLocaleString('en-IN')}`;
    
    if (path.endsWith('.pdf')) {
      document.getElementById('proofModalImage').style.display = 'none';
      document.getElementById('proofModalPdfLink').style.display = 'block';
      document.getElementById('proofPdfHref').href = path;
    } else {
      document.getElementById('proofModalPdfLink').style.display = 'none';
      document.getElementById('proofModalImage').style.display = 'block';
      document.getElementById('proofModalImage').src = path;
    }

    const btnContainer = document.getElementById('proofModalButtons');
    if (status === 'pending') {
      btnContainer.innerHTML = `
        <button type="button" onclick="verifyPaymentAdmin('${paymentId}', 'failed'); closeProofModal();" class="erp-btn erp-btn-secondary" style="border: 1px solid #CBD5E1; color: #000000; font-size: 13px; font-weight: 600;">
          <i data-lucide="x" style="width: 14px; height: 14px;"></i> Reject
        </button>
        <button type="button" onclick="verifyPaymentAdmin('${paymentId}', 'completed'); closeProofModal();" class="erp-btn erp-btn-primary" style="background: #000000; color: #FFFFFF; font-size: 13px; font-weight: 600;">
          <i data-lucide="check" style="width: 14px; height: 14px;"></i> Approve & Confirm
        </button>
      `;
    } else {
      btnContainer.innerHTML = `
        <button type="button" onclick="verifyPaymentAdmin('${paymentId}', 'completed'); closeProofModal();" class="erp-btn erp-btn-secondary" style="font-size: 13px; font-weight: 600;">
          Re-approve
        </button>
      `;
    }

    if (window.lucide) lucide.createIcons();
  }

  function closeProofModal() {
    document.getElementById('proofModal').style.display = 'none';
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeProofModal();
  });

  const pModalEl = document.getElementById('proofModal');
  if (pModalEl) {
    pModalEl.addEventListener('click', (e) => {
      if (e.target.id === 'proofModal') closeProofModal();
    });
  }

  async function verifyPaymentAdmin(paymentId, status) {
    const actionText = status === 'completed' ? 'Approve & Confirm' : 'Reject';
    if (!confirm(`Are you sure you want to ${actionText} this payment proof?`)) return;

    try {
      const res = await fetch(`/api/payments/${paymentId}/verify`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        alert(data.message || 'Payment updated successfully.');
        window.location.reload();
      } else {
        alert(data.message || 'Failed to process verification.');
      }
    } catch (err) {
      console.error(err);
      alert('Network error.');
    }
  }
</script>
