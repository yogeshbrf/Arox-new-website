<div class="erp-h1" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>Student & Employee Reviews</div>
  <div style="font-size: 13px; color: #64748B; font-weight: 500;">
    <i data-lucide="shield-check" style="width: 14px; height: 14px; display: inline-block; vertical-align: middle;"></i>
    Verified Institutional Feedback System
  </div>
</div>

<!-- Review Stats Cards -->
<div class="erp-grid-4" style="margin-bottom: 24px;">
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="star"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Average Rating</div>
    </div>
    <div class="erp-card-value" style="color: #000000;">★ <%= stats ? stats.avgRating : '5.0' %></div>
    <div class="erp-p" style="margin-top: 6px; color: #16A34A; font-weight: 600; font-size: 12px;">Institutional Quality Score</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="message-square"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Total Reviews</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= stats ? stats.total : (reviews ? reviews.length : 0) %></div>
    <div class="erp-p" style="margin-top: 6px; color: #64748B; font-size: 12px;">Students and staff entries</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="clock"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Pending Action</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= stats ? stats.pending : 0 %></div>
    <div class="erp-p" style="margin-top: 6px; color: #DC2626; font-weight: 600; font-size: 12px;">Requires Acknowledgement</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="check-circle-2"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Acknowledged</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= stats ? stats.acknowledged : 0 %></div>
    <div class="erp-p" style="margin-top: 6px; color: #16A34A; font-weight: 600; font-size: 12px;">Reviewed & Addressed</div>
  </div>
</div>

<!-- Unified Catalogue Toolbar with View Switcher & Multi-Filters -->
<div class="catalogue-toolbar" data-catalogue="admin_reviews">
  <div class="catalogue-search-wrap">
    <i data-lucide="search" class="catalogue-search-icon"></i>
    <input type="text" class="catalogue-search-input" placeholder="Search reviews, reviewer, email, comments...">
  </div>

  <div class="catalogue-filters-group">
    <select class="catalogue-select" data-filter="status" title="Filter by Status">
      <option value="all">All Statuses (<%= reviews ? reviews.length : 0 %>)</option>
      <option value="pending">Pending Review</option>
      <option value="acknowledged">Acknowledged</option>
    </select>

    <select class="catalogue-select" data-filter="rating" title="Filter by Rating">
      <option value="all">All Ratings</option>
      <option value="5">5 Stars (★★★★★)</option>
      <option value="4">4 Stars (★★★★☆)</option>
      <option value="3">3 Stars (★★★☆☆)</option>
      <option value="2">2 Stars (★★☆☆☆)</option>
      <option value="1">1 Star (★☆☆☆☆)</option>
    </select>

    <select class="catalogue-select" data-filter="role" title="Filter by Reviewer Role">
      <option value="all">All Roles</option>
      <option value="student">Students</option>
      <option value="employee">Employees</option>
    </select>

    <select class="catalogue-select" data-filter="sort" title="Sort by">
      <option value="newest">Sort: Newest First</option>
      <option value="rating_desc">Sort: Highest Rating</option>
      <option value="rating_asc">Sort: Lowest Rating</option>
      <option value="name">Sort: Name (A-Z)</option>
    </select>

    <button type="button" class="catalogue-reset-btn" title="Reset all filters">
      <i data-lucide="rotate-ccw"></i> Reset
    </button>
  </div>

  <div class="catalogue-view-switcher">
    <button type="button" class="view-btn active" data-view="list" title="Table / List View">
      <i data-lucide="list"></i> List
    </button>
    <button type="button" class="view-btn" data-view="kanban" title="Kanban / Grid View">
      <i data-lucide="layout-grid"></i> Kanban
    </button>
  </div>

  <div class="catalogue-count-badge">
    Showing <%= reviews ? reviews.length : 0 %> reviews
  </div>
</div>

<!-- 1. LIST VIEW (Responsive Data Table) -->
<div class="catalogue-list-view" data-catalogue="admin_reviews">
  <div class="erp-card" style="padding: 0; background: #FFFFFF; border: 1px solid #E2E8F0; overflow: hidden; margin-bottom: 24px;">
    <div class="erp-table-container" style="border: none; border-radius: 0; margin-bottom: 0;">
      <table class="erp-table">
        <thead>
          <tr>
            <th style="width: 140px; color: #000;">Date</th>
            <th style="width: 180px; color: #000;">Reviewer & Role</th>
            <th style="width: 160px; color: #000;">Course / Category</th>
            <th style="width: 110px; color: #000;">Rating</th>
            <th style="color: #000;">Feedback / Discussion</th>
            <th style="width: 130px; text-align: center; color: #000;">Status</th>
            <th style="width: 180px; text-align: right; color: #000;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (reviews && reviews.length > 0) { %>
            <% reviews.forEach(rev => { 
              const revStatus = (rev.status || 'pending').toLowerCase();
              const revRole = (rev.user_type || 'student').toLowerCase();
              const ratingNum = Number(rev.rating || 5);
            %>
              <tr data-search="<%= (rev.reviewer_name + ' ' + (rev.reviewer_email || '') + ' ' + (rev.title || '') + ' ' + (rev.comment || '') + ' ' + (rev.course_title || '') + ' ' + revRole).toLowerCase() %>"
                  data-status="<%= revStatus %>"
                  data-rating="<%= ratingNum %>"
                  data-role="<%= revRole %>"
                  data-name="<%= rev.reviewer_name.toLowerCase() %>"
                  data-rating_desc="<%= ratingNum %>"
                  data-rating_asc="<%= ratingNum %>"
                  data-newest="<%= rev.id %>">
                <td>
                  <div style="font-size: 12px; color: #000; font-weight: 600;">
                    <%= new Date(rev.created_at || Date.now()).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                  </div>
                </td>
                <td>
                  <div style="font-weight: 700; color: #000; font-size: 13px;"><%= rev.reviewer_name %></div>
                  <div style="display: inline-flex; align-items: center; gap: 4px; margin-top: 2px;">
                    <span style="font-size: 10px; text-transform: uppercase; font-weight: 700; padding: 1px 6px; border-radius: 99px; background: <%= revRole === 'student' ? '#E0E7FF; color: #3730A3;' : '#DCFCE7; color: #166534;' %>">
                      <%= revRole %>
                    </span>
                    <span style="font-size: 11px; color: #64748B;"><%= rev.reviewer_email %></span>
                  </div>
                </td>
                <td>
                  <div style="font-size: 12px; font-weight: 600; color: #000;"><%= rev.course_title || 'General Review' %></div>
                </td>
                <td>
                  <div style="color: #F59E0B; font-weight: 700; font-size: 13px;">
                    <%= '★'.repeat(ratingNum) %>
                    <span style="font-size: 11px; color: #64748B;">(<%= ratingNum %>/5)</span>
                  </div>
                </td>
                <td>
                  <div style="font-weight: 600; font-size: 13px; color: #000; margin-bottom: 2px;"><%= rev.title || 'Institutional Review' %></div>
                  <div style="font-size: 12px; color: #475569; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"><%= rev.comment %></div>
                  <% if (rev.admin_reply) { %>
                    <div style="margin-top: 4px; font-size: 11px; color: #000; background: #F8FAFC; border-left: 2px solid #000; padding: 2px 6px;">
                      Reply: <%= rev.admin_reply %>
                    </div>
                  <% } %>
                </td>
                <td style="text-align: center;">
                  <% if (revStatus === 'acknowledged') { %>
                    <span style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 8px; background: #DCFCE7; color: #166534; border-radius: 99px; font-size: 11px; font-weight: 700;">
                      <i data-lucide="check" style="width: 12px; height: 12px;"></i> Acknowledged
                    </span>
                  <% } else { %>
                    <span style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 8px; background: #FEF3C7; color: #B45309; border-radius: 99px; font-size: 11px; font-weight: 700;">
                      <i data-lucide="clock" style="width: 12px; height: 12px;"></i> Pending
                    </span>
                  <% } %>
                </td>
                <td style="text-align: right;">
                  <div style="display: inline-flex; gap: 6px; justify-content: flex-end;">
                    <% if (revStatus !== 'acknowledged') { %>
                      <button onclick="acknowledgeReview('<%= rev.id %>')" class="erp-btn" style="padding: 4px 10px; background: #000; color: #fff; font-size: 11px; font-weight: 600; border-radius: 6px; border: none; cursor: pointer;">
                        Acknowledge
                      </button>
                    <% } %>
                    <button onclick="openReplyModal('<%= rev.id %>', '<%= rev.reviewer_name %>')" class="erp-btn erp-btn-secondary" style="padding: 4px 8px; border: 1px solid #CBD5E1; color: #000; font-size: 11px; font-weight: 600; border-radius: 6px; cursor: pointer;">
                      <%= rev.admin_reply ? 'Edit Reply' : 'Reply' %>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
          <tr class="empty-state-row" style="display: <%= (!reviews || reviews.length === 0) ? '' : 'none' %>;">
            <td colspan="7" style="text-align: center; padding: 48px; color: #64748B;">
              No reviews matching current filter settings.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- 2. KANBAN / GRID VIEW (Material 3 Cards) -->
<div class="catalogue-kanban-view" data-catalogue="admin_reviews">
  <% if (reviews && reviews.length > 0) { %>
    <% reviews.forEach(rev => { 
      const revStatus = (rev.status || 'pending').toLowerCase();
      const revRole = (rev.user_type || 'student').toLowerCase();
      const ratingNum = Number(rev.rating || 5);
    %>
      <div class="kanban-item-card"
           data-search="<%= (rev.reviewer_name + ' ' + (rev.reviewer_email || '') + ' ' + (rev.title || '') + ' ' + (rev.comment || '') + ' ' + (rev.course_title || '') + ' ' + revRole).toLowerCase() %>"
           data-status="<%= revStatus %>"
           data-rating="<%= ratingNum %>"
           data-role="<%= revRole %>"
           data-name="<%= rev.reviewer_name.toLowerCase() %>"
           data-rating_desc="<%= ratingNum %>"
           data-rating_asc="<%= ratingNum %>"
           data-newest="<%= rev.id %>">
        <div class="kanban-card-top">
          <div>
            <div class="kanban-card-title"><%= rev.reviewer_name %></div>
            <div class="kanban-card-subtitle">
              <span style="text-transform: uppercase; font-weight: 700; font-size: 10px; padding: 1px 6px; border-radius: 99px; background: <%= revRole === 'student' ? '#E0E7FF; color: #3730A3;' : '#DCFCE7; color: #166534;' %>">
                <%= revRole %>
              </span>
              <span style="margin-left: 6px;"><%= rev.course_title || 'General Institutional Feedback' %></span>
            </div>
          </div>
          <% if (revStatus === 'acknowledged') { %>
            <span style="font-size: 10px; font-weight: 750; padding: 2px 8px; border-radius: 99px; text-transform: uppercase; background: #DCFCE7; color: #166534;">
              Acknowledged
            </span>
          <% } else { %>
            <span style="font-size: 10px; font-weight: 750; padding: 2px 8px; border-radius: 99px; text-transform: uppercase; background: #FEF3C7; color: #B45309;">
              Pending
            </span>
          <% } %>
        </div>

        <div class="kanban-card-body">
          <div style="color: #F59E0B; font-size: 15px; margin-bottom: 6px;">
            <%= '★'.repeat(ratingNum) %><%= '☆'.repeat(5 - ratingNum) %>
            <span style="font-size: 12px; color: #000; font-weight: 700; margin-left: 4px;"><%= ratingNum %>/5</span>
          </div>

          <div style="font-weight: 700; font-size: 13.5px; color: #000; margin-bottom: 4px;">
            <%= rev.title || 'Review' %>
          </div>
          <p style="margin: 0; font-size: 12.5px; color: #475569; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
            "<%= rev.comment %>"
          </p>

          <% if (rev.admin_reply) { %>
            <div style="margin-top: 10px; background: #F8FAFC; border-left: 3px solid #000; border-radius: 0 6px 6px 0; padding: 8px 12px; font-size: 12px;">
              <div style="font-size: 10px; font-weight: 750; text-transform: uppercase; color: #000;">Official Response:</div>
              <div style="color: #1E293B; margin-top: 2px;"><%= rev.admin_reply %></div>
            </div>
          <% } %>
        </div>

        <div class="kanban-card-footer">
          <span style="font-size: 11px; color: #64748B;">
            <%= new Date(rev.created_at || Date.now()).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) %>
          </span>

          <div style="display: inline-flex; gap: 6px;">
            <% if (revStatus !== 'acknowledged') { %>
              <button onclick="acknowledgeReview('<%= rev.id %>')" class="erp-btn" style="padding: 4px 10px; background: #000; color: #fff; font-size: 11px; font-weight: 600; border-radius: 6px; border: none; cursor: pointer;">
                Acknowledge
              </button>
            <% } %>
            <button onclick="openReplyModal('<%= rev.id %>', '<%= rev.reviewer_name %>')" class="erp-btn erp-btn-secondary" style="padding: 4px 8px; border: 1px solid #CBD5E1; color: #000; font-size: 11px; font-weight: 600; border-radius: 6px; cursor: pointer;">
              <%= rev.admin_reply ? 'Edit Reply' : 'Reply' %>
            </button>
          </div>
        </div>
      </div>
    <% }) %>
  <% } %>
  <div class="kanban-empty-state" style="display: <%= (!reviews || reviews.length === 0) ? 'block' : 'none' %>;">
    <i data-lucide="message-square" style="width: 36px; height: 36px; margin: 0 auto 10px; color: #94A3B8;"></i>
    <div style="font-weight: 700; font-size: 15px; color: #000;">No Reviews Found</div>
    <div style="font-size: 12px; color: #64748B; margin-top: 4px;">No feedback entries matching selected criteria.</div>
  </div>
</div>

<!-- Modal: Reply to Review -->
<div id="replyModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 99999; align-items: center; justify-content: center; padding: 16px;">
  <div style="background: #FFFFFF; border-radius: 12px; width: 100%; max-width: 500px; padding: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.2);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h3 id="replyModalHeading" style="margin: 0; font-size: 18px; font-weight: 700; color: #000;">Reply to Review</h3>
      <button onclick="closeReplyModal()" style="border: none; background: transparent; font-size: 20px; cursor: pointer; color: #64748B;">&times;</button>
    </div>

    <form onsubmit="handleReplySubmit(event)">
      <input type="hidden" id="modalReviewId" value="">
      <div style="margin-bottom: 16px;">
        <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 6px;">Institutional Response *</label>
        <textarea id="modalReplyText" required rows="4" style="width: 100%; padding: 10px; border: 1px solid #CBD5E1; border-radius: 8px; font-family: inherit; font-size: 13px;" placeholder="Write a response thanking the reviewer or addressing their feedback..."></textarea>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" onclick="closeReplyModal()" class="erp-btn erp-btn-secondary" style="padding: 8px 16px; border: 1px solid #CBD5E1; color: #000; cursor: pointer;">Cancel</button>
        <button type="submit" id="replySubmitBtn" class="erp-btn erp-btn-primary" style="padding: 8px 20px; background: #000; color: #fff; border-radius: 6px; font-weight: 600; cursor: pointer;">Post Response</button>
      </div>
    </form>
  </div>
</div>

<script>
  async function acknowledgeReview(id) {
    try {
      const res = await fetch(`/api/reviews/${id}/acknowledge`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || 'Failed to acknowledge');
      window.location.reload();
    } catch (err) {
      alert(err.message);
    }
  }

  function openReplyModal(id, reviewerName) {
    document.getElementById('replyModalHeading').textContent = `Reply to ${reviewerName}`;
    document.getElementById('modalReviewId').value = id;
    document.getElementById('modalReplyText').value = '';
    document.getElementById('replyModal').style.display = 'flex';
  }

  function closeReplyModal() {
    document.getElementById('replyModal').style.display = 'none';
  }

  async function handleReplySubmit(e) {
    e.preventDefault();
    const id = document.getElementById('modalReviewId').value;
    const reply = document.getElementById('modalReplyText').value.trim();
    const btn = document.getElementById('replySubmitBtn');
    btn.disabled = true;

    try {
      const res = await fetch(`/api/reviews/${id}/reply`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reply })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || 'Failed to post reply');
      closeReplyModal();
      window.location.reload();
    } catch (err) {
      alert(err.message);
    } finally {
      btn.disabled = false;
    }
  }
</script>
