<div class="erp-h1" style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>
    <div style="font-size: 24px; font-weight: 750;">Feedback & Ratings</div>
    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 2px;">Submit organizational and process reviews and track administrative acknowledgements</div>
  </div>
  <button type="button" onclick="openReviewModal()" class="erp-btn erp-btn-primary" style="padding: 8px 16px; background: #000; color: #fff; border-radius: 8px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; border: none; font-size: 13px;">
    <i data-lucide="star" style="width: 15px; height: 15px;"></i>
    <span>Submit Feedback</span>
  </button>
</div>

<!-- Interactive Catalogue Filter Toolbar (Apple + Google Material 3) -->
<!-- Summary Metric Cards -->
<%
  const totalReviews = reviews ? reviews.length : 0;
  const avgRating = reviews && reviews.length > 0 ? (reviews.reduce((acc, r) => acc + Number(r.rating || 5), 0) / reviews.length).toFixed(1) : '5.0';
  const fiveStars = reviews ? reviews.filter(r => Number(r.rating || 0) === 5).length : 0;
  const repliedReviews = reviews ? reviews.filter(r => r.admin_reply || r.status === 'approved').length : 0;
%>
<div class="erp-grid-4" style="margin-bottom: 24px;">
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="message-square"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Total Feedback</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= totalReviews %></div>
    <div class="erp-p" style="margin-top: 6px; color: #64748B; font-size: 12px;">Submitted reviews</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="star"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Average Rating</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= avgRating %> ★</div>
    <div class="erp-p" style="margin-top: 6px; color: #EAB308; font-weight: 600; font-size: 12px;">Overall satisfaction</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="award"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">5-Star Ratings</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= fiveStars %></div>
    <div class="erp-p" style="margin-top: 6px; color: #16A34A; font-weight: 600; font-size: 12px;">Top tier reviews</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="check-circle-2"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Acknowledged</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= repliedReviews %></div>
    <div class="erp-p" style="margin-top: 6px; color: #2563EB; font-weight: 600; font-size: 12px;">Reviewed by management</div>
  </div>
</div>
<div class="catalogue-toolbar" data-catalogue="emp_reviews">
  <div class="catalogue-filters-group">
    <!-- Search Input -->
    <div class="catalogue-search-wrap">
      <i data-lucide="search"></i>
      <input type="text" class="catalogue-search-input" placeholder="Search feedback text, admin reply...">
    </div>

    <!-- Rating Filter -->
    <select class="catalogue-select" data-filter="rating" title="Filter by Rating">
      <option value="all">All Ratings</option>
      <option value="5">⭐⭐⭐⭐⭐ (5 Stars)</option>
      <option value="4">⭐⭐⭐⭐ (4 Stars)</option>
      <option value="3">⭐⭐⭐ (3 Stars)</option>
      <option value="2">⭐⭐ (2 Stars)</option>
      <option value="1">⭐ (1 Star)</option>
    </select>

    <!-- Status Filter -->
    <select class="catalogue-select" data-filter="status" title="Filter by Status">
      <option value="all">All Statuses</option>
      <option value="acknowledged">Acknowledged</option>
      <option value="pending">Pending Review</option>
    </select>

    <!-- Sort Dropdown -->
    <select class="catalogue-select" data-filter="sort" title="Sort records">
      <option value="newest">Newest First</option>
      <option value="rating_desc">Highest Rating</option>
      <option value="rating_asc">Lowest Rating</option>
    </select>

    <!-- Reset Button -->
    <button type="button" class="catalogue-reset-btn" title="Reset all filters">
      <i data-lucide="rotate-ccw" style="width: 13px; height: 13px;"></i>
      <span>Reset</span>
    </button>

    <!-- Result Counter -->
    <span class="catalogue-count-badge">Showing <%= myReviews ? myReviews.length : 0 %> reviews</span>
  </div>

  <!-- Segmented View Switcher: List vs Kanban/Grid -->
  <div class="catalogue-view-switcher">
    <button type="button" class="view-btn active" data-view="list" title="Table List View">
      <i data-lucide="list"></i>
      <span>List</span>
    </button>
    <button type="button" class="view-btn" data-view="kanban" title="Kanban Card Grid View">
      <i data-lucide="layout-grid"></i>
      <span>Kanban</span>
    </button>
  </div>
</div>

<!-- 1. LIST VIEW (Data Table) -->
<div class="catalogue-list-view" data-catalogue="emp_reviews">
  <div class="erp-card" style="background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; overflow-x: auto; padding: 0;">
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
      <thead>
        <tr style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0; font-size: 11px; text-transform: uppercase; color: #64748B; font-weight: 700;">
          <th style="padding: 12px 16px;">Date</th>
          <th style="padding: 12px 16px;">Rating</th>
          <th style="padding: 12px 16px;">Feedback / Review</th>
          <th style="padding: 12px 16px;">Admin Status</th>
          <th style="padding: 12px 16px;">Admin Reply</th>
        </tr>
      </thead>
      <tbody>
        <% if (myReviews && myReviews.length > 0) { %>
          <% myReviews.forEach(r => { %>
            <tr style="border-bottom: 1px solid #E2E8F0;"
                data-search="<%= (r.review_text + ' ' + (r.admin_reply || '') + ' ' + (r.status || '')).toLowerCase() %>"
                data-rating="<%= r.rating %>"
                data-status="<%= (r.status || 'pending').toLowerCase() %>"
                data-newest="<%= r.id %>">
              <td style="padding: 12px 16px;">
                <div style="font-size: 12px; color: #000; font-weight: 600;">
                  <%= new Date(r.created_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                </div>
              </td>
              <td style="padding: 12px 16px;">
                <div style="color: #EAB308; font-weight: 700; font-size: 13px; display: inline-flex; align-items: center; gap: 3px;">
                  <% for (let i = 1; i <= 5; i++) { %>
                    <i data-lucide="star" style="width: 13px; height: 13px; fill: <%= i <= r.rating ? '#EAB308' : 'none' %>; stroke: #EAB308;"></i>
                  <% } %>
                  <span style="font-size: 12px; color: #000; margin-left: 4px;"><%= r.rating %>/5</span>
                </div>
              </td>
              <td style="padding: 12px 16px; max-width: 320px;">
                <div style="font-size: 13px; color: #334155; line-height: 1.4;"><%= r.review_text %></div>
              </td>
              <td style="padding: 12px 16px;">
                <% if (r.status === 'acknowledged') { %>
                  <span style="padding: 3px 8px; border-radius: 99px; font-size: 11px; font-weight: 700; background: #DCFCE7; color: #15803D; display: inline-flex; align-items: center; gap: 4px;">
                    <i data-lucide="check" style="width: 12px; height: 12px;"></i> Acknowledged
                  </span>
                  <div style="font-size: 10px; color: #64748B; margin-top: 2px;">
                    by <%= r.acknowledged_by_name || 'Admin' %> <%= r.acknowledged_at ? 'on ' + new Date(r.acknowledged_at).toLocaleDateString('en-IN') : '' %>
                  </div>
                <% } else { %>
                  <span style="padding: 3px 8px; border-radius: 99px; font-size: 11px; font-weight: 700; background: #FEF3C7; color: #B45309;">Pending Review</span>
                <% } %>
              </td>
              <td style="padding: 12px 16px;">
                <% if (r.admin_reply) { %>
                  <div style="font-size: 12px; color: #000; font-weight: 500; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 6px; padding: 6px 10px;">
                    <%= r.admin_reply %>
                  </div>
                <% } else { %>
                  <span style="color: #94A3B8; font-size: 12px;">None yet</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        <% } %>
        <tr class="empty-state-row" style="display: <%= (!myReviews || myReviews.length === 0) ? '' : 'none' %>;">
          <td colspan="5" style="padding: 32px; text-align: center; color: #64748B;">No feedback records matching current filters.</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<!-- 2. KANBAN / GRID VIEW (Material 3 Cards) -->
<div class="catalogue-kanban-view" data-catalogue="emp_reviews">
  <% if (myReviews && myReviews.length > 0) { %>
    <% myReviews.forEach(r => { %>
      <div class="kanban-item-card"
           data-search="<%= (r.review_text + ' ' + (r.admin_reply || '') + ' ' + (r.status || '')).toLowerCase() %>"
           data-rating="<%= r.rating %>"
           data-status="<%= (r.status || 'pending').toLowerCase() %>"
           data-newest="<%= r.id %>">
        <div class="kanban-card-top">
          <div style="display: flex; align-items: center; gap: 3px; color: #EAB308;">
            <% for (let i = 1; i <= 5; i++) { %>
              <i data-lucide="star" style="width: 13px; height: 13px; fill: <%= i <= r.rating ? '#EAB308' : 'none' %>; stroke: #EAB308;"></i>
            <% } %>
            <span style="font-size: 12px; font-weight: 700; color: #000; margin-left: 4px;"><%= r.rating %>/5</span>
          </div>
          <% if (r.status === 'acknowledged') { %>
            <span style="font-size: 10px; font-weight: 700; padding: 2px 7px; background: #DCFCE7; color: #15803D; border-radius: 4px; text-transform: uppercase;">Acknowledged</span>
          <% } else { %>
            <span style="font-size: 10px; font-weight: 700; padding: 2px 7px; background: #FEF3C7; color: #B45309; border-radius: 4px; text-transform: uppercase;">Pending</span>
          <% } %>
        </div>

        <div class="kanban-card-body">
          <div style="font-size: 13px; color: #334155; line-height: 1.4;">
            "<%= r.review_text %>"
          </div>

          <% if (r.admin_reply) { %>
            <div style="font-size: 11.5px; color: #000; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; padding: 8px 10px; margin-top: 8px;">
              <span style="font-weight: 700; color: #64748B; font-size: 10px; text-transform: uppercase; display: block; margin-bottom: 2px;">Admin Reply:</span>
              <%= r.admin_reply %>
            </div>
          <% } %>
        </div>

        <div class="kanban-card-footer">
          <span style="font-size: 11px; color: #64748B;">
            <i data-lucide="calendar" style="width: 11px; height: 11px; display: inline-block;"></i>
            <%= new Date(r.created_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
          </span>
          <% if (r.status === 'acknowledged' && r.acknowledged_by_name) { %>
            <span style="font-size: 11px; font-weight: 600; color: #15803D;">Ack by <%= r.acknowledged_by_name %></span>
          <% } %>
        </div>
      </div>
    <% }) %>
  <% } %>
  <div class="kanban-empty-state" style="display: <%= (!myReviews || myReviews.length === 0) ? 'block' : 'none' %>;">
    <i data-lucide="message-square" style="width: 36px; height: 36px; margin: 0 auto 10px; color: #94A3B8;"></i>
    <div style="font-weight: 700; font-size: 15px; color: #000;">No Feedback Found</div>
    <div style="font-size: 12px; color: #64748B; margin-top: 4px;">Click "Submit Feedback" above to share workplace insights.</div>
  </div>
</div>

<!-- Modal: Submit Review -->
<div id="reviewModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 9999; align-items: center; justify-content: center; padding: 16px;">
  <div style="background: #FFFFFF; border-radius: 12px; max-width: 480px; width: 100%; padding: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #E2E8F0; padding-bottom: 12px; margin-bottom: 16px;">
      <h3 style="margin: 0; font-size: 17px; font-weight: 700; color: #000;">Submit Feedback & Rating</h3>
      <button type="button" onclick="closeReviewModal()" style="border: none; background: transparent; font-size: 20px; cursor: pointer; color: #64748B;">&times;</button>
    </div>

    <form id="reviewSubmitForm" onsubmit="handleReviewSubmit(event)">
      <div style="margin-bottom: 16px;">
        <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 6px;">Your Rating (1 to 5 Stars)</label>
        <select id="reviewRating" required style="width: 100%; padding: 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 14px; background: #fff;">
          <option value="5">⭐⭐⭐⭐⭐ 5 Stars - Excellent</option>
          <option value="4">⭐⭐⭐⭐ 4 Stars - Very Good</option>
          <option value="3">⭐⭐⭐ 3 Stars - Average</option>
          <option value="2">⭐⭐ 2 Stars - Below Average</option>
          <option value="1">⭐ 1 Star - Poor</option>
        </select>
      </div>

      <div style="margin-bottom: 20px;">
        <label style="display: block; font-size: 12px; font-weight: 700; color: #000; margin-bottom: 6px;">Feedback Comments *</label>
        <textarea id="reviewText" required rows="4" placeholder="Share your workplace, workflow, or training feedback..." style="width: 100%; padding: 10px; border: 1px solid #CBD5E1; border-radius: 6px; resize: vertical; font-size: 13px;"></textarea>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid #E2E8F0; padding-top: 16px;">
        <button type="button" onclick="closeReviewModal()" class="erp-btn erp-btn-secondary" style="padding: 8px 16px; border: 1px solid #CBD5E1; color: #000; cursor: pointer;">Cancel</button>
        <button type="submit" id="saveReviewBtn" class="erp-btn erp-btn-primary" style="padding: 8px 20px; background: #000; color: #fff; border-radius: 6px; font-weight: 600; cursor: pointer; border: none;">Submit Feedback</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openReviewModal() {
    document.getElementById('reviewSubmitForm').reset();
    document.getElementById('reviewModal').style.display = 'flex';
  }

  function closeReviewModal() {
    document.getElementById('reviewModal').style.display = 'none';
  }

  async function handleReviewSubmit(e) {
    e.preventDefault();
    const btn = document.getElementById('saveReviewBtn');
    btn.disabled = true;

    const payload = {
      rating: parseInt(document.getElementById('reviewRating').value, 10),
      review_text: document.getElementById('reviewText').value.trim()
    };

    try {
      const res = await fetch('/api/reviews', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || 'Failed to submit feedback');

      closeReviewModal();
      window.location.reload();
    } catch (err) {
      alert(err.message);
    } finally {
      btn.disabled = false;
    }
  }
</script>
