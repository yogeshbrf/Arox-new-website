<div class="erp-h1" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>Leads: Student Internships</div>
  <div style="font-size: 13px; color: #64748B; font-weight: 500;">
    <i data-lucide="refresh-cw" style="width: 14px; height: 14px; display: inline-block; vertical-align: middle;"></i>
    Live Triangular Synced with Admin & Student Portals
  </div>
</div>

<!-- Summary Metric Cards -->
<%
  const total = internships ? internships.length : 0;
  const confirmed = internships ? internships.filter(i => i.status === 'confirmed' || i.status === 'active').length : 0;
  const pending = internships ? internships.filter(i => i.status === 'pending').length : 0;
  const withReferral = internships ? internships.filter(i => i.referral_code).length : 0;
%>
<div class="erp-grid-4" style="margin-bottom: 24px;">
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="award"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Total Interns</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= total %></div>
    <div class="erp-p" style="margin-top: 6px; color: #64748B; font-size: 12px;">Enrolled applicants</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="check-circle-2"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Confirmed Active</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= confirmed %></div>
    <div class="erp-p" style="margin-top: 6px; color: #16A34A; font-weight: 600; font-size: 12px;">Verified status</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="clock"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Pending Action</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= pending %></div>
    <div class="erp-p" style="margin-top: 6px; color: #D97706; font-weight: 600; font-size: 12px;">Website submissions</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="ticket"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Referral Attributed</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= withReferral %></div>
    <div class="erp-p" style="margin-top: 6px; color: #000000; font-weight: 600; font-size: 12px;">Codes redeemed</div>
  </div>
</div>

<!-- Unified Catalogue Toolbar with View Switcher & Multi-Filters -->
<div class="catalogue-toolbar" data-catalogue="emp_internships">
  <div class="catalogue-search-wrap">
    <i data-lucide="search" class="catalogue-search-icon"></i>
    <input type="text" class="catalogue-search-input" placeholder="Search by name, reg ID, email, college, course...">
  </div>

  <div class="catalogue-filters-group">
    <select class="catalogue-select" data-filter="status" title="Filter by Status">
      <option value="all">All Statuses (<%= total %>)</option>
      <option value="active">Active / Confirmed</option>
      <option value="pending">Pending</option>
      <option value="completed">Completed</option>
      <option value="cancelled">Cancelled</option>
    </select>

    <select class="catalogue-select" data-filter="mode" title="Filter by Mode">
      <option value="all">All Modes</option>
      <option value="online">Online</option>
      <option value="offline">Offline</option>
      <option value="hybrid">Hybrid</option>
    </select>

    <select class="catalogue-select" data-filter="sort" title="Sort by">
      <option value="newest">Sort: Newest First</option>
      <option value="name">Sort: Name (A-Z)</option>
      <option value="paid_desc">Sort: Paid Fee (High to Low)</option>
      <option value="balance_desc">Sort: Balance Due (High to Low)</option>
    </select>

    <button type="button" class="catalogue-reset-btn" title="Reset all filters">
      <i data-lucide="rotate-ccw"></i> Reset
    </button>
  </div>

  <div class="catalogue-view-switcher">
    <button type="button" class="view-btn active" data-view="list" title="Table / List View">
      <i data-lucide="list"></i> List
    </button>
    <button type="button" class="view-btn" data-view="kanban" title="Kanban / Grid View">
      <i data-lucide="layout-grid"></i> Kanban
    </button>
  </div>

  <div class="catalogue-count-badge">
    Showing <%= total %> intern leads
  </div>
</div>

<!-- 1. LIST VIEW (Responsive Data Table) -->
<div class="catalogue-list-view" data-catalogue="emp_internships">
  <div class="erp-card" style="padding: 0; background: #FFFFFF; border: 1px solid #E2E8F0; overflow: hidden; margin-bottom: 24px;">
    <div class="erp-table-container" style="border: none; border-radius: 0; margin-bottom: 0;">
      <table class="erp-table">
        <thead>
          <tr>
            <th style="color: #000;">Reg ID & Student</th>
            <th style="color: #000;">Program / Course</th>
            <th style="color: #000;">Schedule & Dates</th>
            <th style="color: #000;">Mode & Batch</th>
            <th style="color: #000;">Fee & Dues</th>
            <th style="color: #000;">Referral Code</th>
            <th style="color: #000;">Status</th>
            <th style="text-align: right; color: #000;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (internships && internships.length > 0) { %>
            <% internships.forEach(item => { 
              const fullName = `${item.first_name || ''} ${item.last_name || ''}`.trim();
              const itemStatus = (item.status === 'confirmed' ? 'active' : (item.status || 'pending')).toLowerCase();
              const modeVal = (item.mode || item.course_mode || 'online').toLowerCase();
              const totalVal = Number(item.total_amount || 0);
              const paidVal = Number(item.paid_amount || 0);
              const balVal = Number(item.balance_amount || 0);
            %>
              <tr id="intern-row-<%= item.id %>"
                  data-search="<%= (fullName + ' ' + (item.registration_id || '') + ' ' + (item.email || '') + ' ' + (item.phone || '') + ' ' + (item.college || '') + ' ' + (item.course_title || '') + ' ' + modeVal).toLowerCase() %>"
                  data-status="<%= itemStatus %>"
                  data-mode="<%= modeVal %>"
                  data-name="<%= fullName.toLowerCase() %>"
                  data-paid_desc="<%= paidVal %>"
                  data-balance_desc="<%= balVal %>"
                  data-newest="<%= item.id %>">
                <td>
                  <div style="font-weight: 700; color: #000; font-size: 13px;"><%= fullName %></div>
                  <div style="font-size: 11px; font-family: monospace; color: #64748B;"><%= item.registration_id %></div>
                  <div style="font-size: 11px; color: #64748B;"><%= item.email %> • <%= item.phone || '' %></div>
                  <div style="font-size: 10px; color: #94A3B8;"><%= item.college || '—' %></div>
                </td>
                <td>
                  <div style="font-weight: 600; color: #000; font-size: 13px;"><%= item.course_title %></div>
                  <div style="font-size: 11px; color: #64748B;"><%= item.course_duration || '3 Months' %></div>
                </td>
                <td>
                  <div style="font-size: 12px; color: #000; font-weight: 600;">
                    <%= item.start_date ? new Date(item.start_date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'TBD' %>
                  </div>
                  <div style="font-size: 11px; color: #64748B;">to <%= item.end_date ? new Date(item.end_date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'TBD' %></div>
                </td>
                <td>
                  <span style="display: inline-block; padding: 2px 6px; font-size: 11px; font-weight: 600; background: #F1F5F9; border-radius: 4px; text-transform: uppercase;">
                    <%= modeVal %>
                  </span>
                  <div style="font-size: 11px; color: #64748B; margin-top: 2px;"><%= item.batch_name || item.course_batch || 'Default Batch' %></div>
                </td>
                <td>
                  <% if (totalVal <= 0) { %>
                    <div style="display: inline-flex; align-items: center; gap: 5px; padding: 3px 8px; background: #FEF3C7; border: 1px solid #FCD34D; border-radius: 6px; color: #92400E; font-size: 11px; font-weight: 700;">
                      <i data-lucide="help-circle" style="width: 13px; height: 13px; color: #D97706; flex-shrink: 0;"></i>
                      <span>Payment Not Set</span>
                    </div>
                    <div style="margin-top: 3px;">
                      <button type="button" onclick='openEditInternshipModal(<%= item.id %>, <%- JSON.stringify(item).replace(/'/g, "&#39;") %>)' style="background: none; border: none; padding: 0; color: #2563EB; font-size: 11px; font-weight: 600; cursor: pointer; text-decoration: underline;">
                        + Assign Fee
                      </button>
                    </div>
                  <% } else { %>
                    <div style="font-weight: 700; color: #000; font-size: 13px;">₹<%= paidVal.toLocaleString('en-IN') %> <span style="font-size: 11px; font-weight: 400; color: #64748B;">/ ₹<%= Number(item.total_amount || 0).toLocaleString('en-IN') %></span></div>
                    <div style="font-size: 11px; font-weight: 600; color: <%= balVal > 0 ? '#DC2626' : '#16A34A' %>;">
                      <%= balVal > 0 ? `Due: ₹${balVal.toLocaleString('en-IN')}` : 'Cleared' %>
                    </div>
                  <% } %>
                </td>
                <td>
                  <% if (item.referral_code) { %>
                    <span style="font-family: monospace; font-size: 11px; font-weight: 700; background: #000; color: #fff; padding: 2px 6px; border-radius: 4px;">
                      <%= item.referral_code %>
                    </span>
                  <% } else { %>
                    <span style="color: #94A3B8; font-size: 12px;">—</span>
                  <% } %>
                </td>
                <td>
                  <% if (item.status === 'confirmed' || item.status === 'active') { %>
                    <span style="padding: 3px 8px; border-radius: 99px; font-size: 11px; font-weight: 700; background: #DCFCE7; color: #15803D;">Active</span>
                  <% } else if (item.status === 'completed') { %>
                    <span style="padding: 3px 8px; border-radius: 99px; font-size: 11px; font-weight: 700; background: #000000; color: #FFFFFF;">Completed</span>
                  <% } else if (item.status === 'cancelled') { %>
                    <span style="padding: 3px 8px; border-radius: 99px; font-size: 11px; font-weight: 700; background: #FEE2E2; color: #B91C1C;">Cancelled</span>
                  <% } else { %>
                    <span style="padding: 3px 8px; border-radius: 99px; font-size: 11px; font-weight: 700; background: #FEF3C7; color: #B45309;">Pending</span>
                  <% } %>
                </td>
                <td style="text-align: right;">
                  <button type="button" 
                    onclick='openEditInternshipModal(<%= item.id %>, <%- JSON.stringify(item).replace(/'/g, "&#39;") %>)' 
                    class="erp-btn erp-btn-secondary" 
                    style="padding: 4px 10px; font-size: 12px; font-weight: 600; color: #000; border: 1px solid #CBD5E1; cursor: pointer;">
                    <i data-lucide="edit-3" style="width: 13px; height: 13px; display: inline-block; vertical-align: middle;"></i> Edit
                  </button>
                </td>
              </tr>
            <% }); %>
          <% } %>
          <tr class="empty-state-row" style="display: <%= (!internships || internships.length === 0) ? '' : 'none' %>;">
            <td colspan="8" style="text-align: center; padding: 36px; color: #64748B;">
              No matching internship records found.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- 2. KANBAN / GRID VIEW (Material 3 Cards) -->
<div class="catalogue-kanban-view" data-catalogue="emp_internships">
  <% if (internships && internships.length > 0) { %>
    <% internships.forEach(item => { 
      const fullName = `${item.first_name || ''} ${item.last_name || ''}`.trim();
      const itemStatus = (item.status === 'confirmed' ? 'active' : (item.status || 'pending')).toLowerCase();
      const modeVal = (item.mode || item.course_mode || 'online').toLowerCase();
      const paidVal = Number(item.paid_amount || 0);
      const totalVal = Number(item.total_amount || 0);
      const balVal = Number(item.balance_amount || 0);
      const feePct = totalVal > 0 ? Math.min(100, Math.round((paidVal / totalVal) * 100)) : 0;
    %>
      <div class="kanban-item-card"
           data-search="<%= (fullName + ' ' + (item.registration_id || '') + ' ' + (item.email || '') + ' ' + (item.phone || '') + ' ' + (item.college || '') + ' ' + (item.course_title || '') + ' ' + modeVal).toLowerCase() %>"
           data-status="<%= itemStatus %>"
           data-mode="<%= modeVal %>"
           data-name="<%= fullName.toLowerCase() %>"
           data-paid_desc="<%= paidVal %>"
           data-balance_desc="<%= balVal %>"
           data-newest="<%= item.id %>">
        <div class="kanban-card-top">
          <div>
            <div class="kanban-card-title"><%= fullName %></div>
            <div class="kanban-card-subtitle">
              <span style="font-family: monospace; font-weight: 700;"><%= item.registration_id %></span> • <%= item.college || 'College N/A' %>
            </div>
          </div>
          <% if (item.status === 'confirmed' || item.status === 'active') { %>
            <span style="font-size: 10px; font-weight: 750; padding: 2px 8px; border-radius: 99px; text-transform: uppercase; background: #DCFCE7; color: #166534;">Active</span>
          <% } else if (item.status === 'completed') { %>
            <span style="font-size: 10px; font-weight: 750; padding: 2px 8px; border-radius: 99px; text-transform: uppercase; background: #000; color: #fff;">Completed</span>
          <% } else if (item.status === 'cancelled') { %>
            <span style="font-size: 10px; font-weight: 750; padding: 2px 8px; border-radius: 99px; text-transform: uppercase; background: #FEE2E2; color: #B91C1C;">Cancelled</span>
          <% } else { %>
            <span style="font-size: 10px; font-weight: 750; padding: 2px 8px; border-radius: 99px; text-transform: uppercase; background: #FEF3C7; color: #B45309;">Pending</span>
          <% } %>
        </div>

        <div class="kanban-card-body">
          <div style="font-weight: 700; font-size: 13.5px; color: #000; margin-bottom: 4px;">
            <%= item.course_title %>
          </div>

          <div class="kanban-chip-row">
            <div class="kanban-chip" style="text-transform: uppercase;">
              <%= modeVal %>
            </div>
            <div class="kanban-chip">
              <i data-lucide="calendar" style="width: 11px; height: 11px;"></i>
              <%= item.start_date ? new Date(item.start_date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) : 'TBD' %>
            </div>
            <% if (item.referral_code) { %>
              <div class="kanban-chip" style="background: #000; color: #fff; font-family: monospace; font-weight: 700;">
                <%= item.referral_code %>
              </div>
            <% } %>
          </div>

          <!-- Fee Progress -->
          <% if (totalVal <= 0) { %>
            <div style="margin-top: 14px; background: #FEF3C7; border: 1px solid #FCD34D; padding: 10px 12px; border-radius: 10px; display: flex; align-items: center; justify-content: space-between;">
              <div style="display: flex; align-items: center; gap: 6px;">
                <i data-lucide="help-circle" style="width: 16px; height: 16px; color: #D97706; flex-shrink: 0;"></i>
                <div>
                  <div style="font-weight: 700; color: #92400E; font-size: 12px;">Payment Not Set</div>
                  <div style="font-size: 10px; color: #B45309;">Awaiting fee assignment</div>
                </div>
              </div>
              <button type="button" onclick='openEditInternshipModal(<%= item.id %>, <%- JSON.stringify(item).replace(/'/g, "&#39;") %>)' style="background: #D97706; color: #fff; border: none; padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: 700; cursor: pointer;">
                + Assign Fee
              </button>
            </div>
          <% } else { %>
            <div style="margin-top: 14px;">
              <div style="display: flex; justify-content: space-between; font-size: 11px; font-weight: 600; margin-bottom: 4px;">
                <span style="color: #64748B;">Fee Paid: ₹<%= paidVal.toLocaleString('en-IN') %> / ₹<%= totalVal.toLocaleString('en-IN') %></span>
                <span style="color: <%= balVal > 0 ? '#DC2626' : '#16A34A' %>; font-weight: 700;"><%= balVal > 0 ? `Due: ₹${balVal.toLocaleString('en-IN')}` : 'Cleared' %></span>
              </div>
              <div style="width: 100%; height: 5px; background: #E2E8F0; border-radius: 99px; overflow: hidden;">
                <div style="height: 100%; background: #000; width: <%= feePct + '%' %>;"></div>
              </div>
            </div>
          <% } %>
        </div>

        <div class="kanban-card-footer">
          <span style="font-size: 11px; color: #64748B;"><%= item.phone || item.email %></span>
          <button type="button" 
            onclick='openEditInternshipModal(<%= item.id %>, <%- JSON.stringify(item).replace(/'/g, "&#39;") %>)' 
            class="erp-btn erp-btn-secondary" 
            style="padding: 4px 12px; font-size: 11px; font-weight: 600; color: #000; border: 1px solid #CBD5E1; cursor: pointer;">
            <i data-lucide="edit-3" style="width: 12px; height: 12px; display: inline-block; vertical-align: middle;"></i> Edit
          </button>
        </div>
      </div>
    <% }) %>
  <% } %>
  <div class="kanban-empty-state" style="display: <%= (!internships || internships.length === 0) ? 'block' : 'none' %>;">
    <i data-lucide="award" style="width: 36px; height: 36px; margin: 0 auto 10px; color: #94A3B8;"></i>
    <div style="font-weight: 700; font-size: 15px; color: #000;">No Internships Found</div>
    <div style="font-size: 12px; color: #64748B; margin-top: 4px;">No intern records matching selected filters.</div>
  </div>
</div>

<!-- Edit Internship Modal -->
<div id="internshipEditModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 9999; align-items: center; justify-content: center; padding: 16px;">
  <div style="background: #FFFFFF; border-radius: 12px; max-width: 680px; width: 100%; max-height: 90vh; overflow-y: auto; padding: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #E2E8F0; padding-bottom: 12px; margin-bottom: 16px;">
      <h3 style="margin: 0; font-size: 17px; font-weight: 700; color: #000;" id="editModalHeading">Edit Internship Record</h3>
      <button type="button" onclick="closeEditInternshipModal()" style="border: none; background: transparent; font-size: 20px; cursor: pointer; color: #64748B;">&times;</button>
    </div>

    <form id="internshipEditForm" onsubmit="handleInternshipSubmit(event)">
      <input type="hidden" id="editRegId">

      <!-- Section: Student Information -->
      <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; color: #000; margin-bottom: 8px; letter-spacing: 0.05em;">Student Details</div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
        <div>
          <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">First Name</label>
          <input type="text" id="editFirstName" required style="width: 100%; padding: 8px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
        <div>
          <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">Last Name</label>
          <input type="text" id="editLastName" required style="width: 100%; padding: 8px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
        <div>
          <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">Email Address</label>
          <input type="email" id="editEmail" required style="width: 100%; padding: 8px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
        <div>
          <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">Phone Number</label>
          <input type="text" id="editPhone" required style="width: 100%; padding: 8px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
        <div>
          <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">College / Institute</label>
          <input type="text" id="editCollege" style="width: 100%; padding: 8px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
        <div>
          <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">Department</label>
          <input type="text" id="editDepartment" style="width: 100%; padding: 8px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
      </div>

      <!-- Section: Internship & Academic Schedule -->
      <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; color: #000; margin-bottom: 8px; letter-spacing: 0.05em; border-top: 1px solid #E2E8F0; padding-top: 12px;">Internship & Schedule</div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
        <div>
          <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">Program / Course</label>
          <select id="editCourseId" style="width: 100%; padding: 8px; border: 1px solid #CBD5E1; border-radius: 6px; background: #fff;">
            <% if (typeof courses !== 'undefined' && courses) { %>
              <% courses.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.title %> (<%= c.duration %>)</option>
              <% }); %>
            <% } %>
          </select>
        </div>
        <div>
          <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">Batch Name</label>
          <input type="text" id="editBatchName" style="width: 100%; padding: 8px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
        <div>
          <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">Start Date</label>
          <input type="date" id="editStartDate" style="width: 100%; padding: 8px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
        <div>
          <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">End Date</label>
          <input type="date" id="editEndDate" style="width: 100%; padding: 8px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
        <div>
          <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">Delivery Mode</label>
          <select id="editMode" style="width: 100%; padding: 8px; border: 1px solid #CBD5E1; border-radius: 6px; background: #fff;">
            <option value="online">Online</option>
            <option value="offline">Offline / In-Office</option>
            <option value="hybrid">Hybrid</option>
          </select>
        </div>
        <div>
          <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">Enrollment Status</label>
          <select id="editStatus" style="width: 100%; padding: 8px; border: 1px solid #CBD5E1; border-radius: 6px; background: #fff;">
            <option value="pending">Pending</option>
            <option value="confirmed">Confirmed</option>
            <option value="active">Active</option>
            <option value="completed">Completed</option>
            <option value="cancelled">Cancelled</option>
          </select>
        </div>
      </div>

      <!-- Section: Fee & Referral -->
      <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; color: #000; margin-bottom: 8px; letter-spacing: 0.05em; border-top: 1px solid #E2E8F0; padding-top: 12px;">Financial & Referral Attribution</div>
      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; margin-bottom: 12px;">
        <div>
          <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">Total Fee (₹)</label>
          <input type="number" id="editTotalAmount" style="width: 100%; padding: 8px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
        <div>
          <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">Paid Fee (₹)</label>
          <input type="number" id="editPaidAmount" style="width: 100%; padding: 8px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
        <div>
          <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">Balance Due (₹)</label>
          <input type="number" id="editBalanceAmount" style="width: 100%; padding: 8px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px;">
        <div>
          <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">Referral Code</label>
          <input type="text" id="editReferralCode" style="width: 100%; padding: 8px; border: 1px solid #CBD5E1; border-radius: 6px; font-family: monospace; text-transform: uppercase;">
          <div id="editReferralFeedback" style="font-size: 11px; font-weight: 600; margin-top: 4px; display: none;"></div>
        </div>
        <div>
          <label style="display: block; font-size: 11px; font-weight: 700; color: #000; margin-bottom: 4px;">Internal Notes</label>
          <input type="text" id="editNotes" style="width: 100%; padding: 8px; border: 1px solid #CBD5E1; border-radius: 6px;">
        </div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid #E2E8F0; padding-top: 16px;">
        <button type="button" onclick="closeEditInternshipModal()" class="erp-btn erp-btn-secondary" style="padding: 8px 16px; border: 1px solid #CBD5E1; color: #000; cursor: pointer;">Cancel</button>
        <button type="submit" id="saveInternshipBtn" class="erp-btn erp-btn-primary" style="padding: 8px 20px; background: #000; color: #fff; border-radius: 6px; font-weight: 600; cursor: pointer;">Save & Sync Panels</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openEditInternshipModal(id, item) {
    document.getElementById('editRegId').value = id;
    document.getElementById('editModalHeading').textContent = `Edit Internship: ${item.registration_id}`;
    
    document.getElementById('editFirstName').value = item.first_name || '';
    document.getElementById('editLastName').value = item.last_name || '';
    document.getElementById('editEmail').value = item.email || '';
    document.getElementById('editPhone').value = item.phone || '';
    document.getElementById('editCollege').value = item.college || '';
    document.getElementById('editDepartment').value = item.department || '';

    document.getElementById('editCourseId').value = item.course_id || '';
    document.getElementById('editBatchName').value = item.batch_name || item.course_batch || '';
    document.getElementById('editStartDate').value = item.start_date || '';
    document.getElementById('editEndDate').value = item.end_date || '';
    document.getElementById('editMode').value = item.mode || 'online';
    document.getElementById('editStatus').value = item.status || 'pending';

    document.getElementById('editTotalAmount').value = item.total_amount || 0;
    document.getElementById('editPaidAmount').value = item.paid_amount || 0;
    document.getElementById('editBalanceAmount').value = item.balance_amount || 0;
    const refInput = document.getElementById('editReferralCode');
    const refFeedback = document.getElementById('editReferralFeedback');
    refInput.value = item.referral_code || '';
    if (item.referral_code) {
      refFeedback.style.display = 'block';
      refFeedback.style.color = '#16a34a';
      refFeedback.textContent = `Current assigned code: ${item.referral_code}`;
    } else {
      refFeedback.style.display = 'none';
      refFeedback.textContent = '';
    }
    document.getElementById('editNotes').value = item.notes || '';

    document.getElementById('internshipEditModal').style.display = 'flex';
  }

  let empRefTimer = null;
  document.getElementById('editReferralCode').addEventListener('input', function() {
    clearTimeout(empRefTimer);
    const feedback = document.getElementById('editReferralFeedback');
    const code = this.value.trim().toUpperCase();
    this.value = code;

    if (!code) {
      feedback.style.display = 'none';
      feedback.textContent = '';
      return;
    }

    feedback.style.display = 'block';
    feedback.style.color = '#64748b';
    feedback.textContent = 'Validating code...';

    empRefTimer = setTimeout(async () => {
      try {
        const res = await fetch(`/api/referrals/validate/${encodeURIComponent(code)}`);
        const json = await res.json();
        if (res.ok && json.valid) {
          feedback.style.color = '#16a34a';
          feedback.textContent = `✓ Valid: ${json.referrerName} (${json.discountPercent}% discount)`;
        } else {
          feedback.style.color = '#dc2626';
          feedback.textContent = `✕ ${json.message || 'Invalid or inactive code'}`;
        }
      } catch (e) {
        feedback.style.color = '#d97706';
        feedback.textContent = '⚠ Network check error';
      }
    }, 300);
  });

  function closeEditInternshipModal() {
    document.getElementById('internshipEditModal').style.display = 'none';
  }

  async function handleInternshipSubmit(e) {
    e.preventDefault();
    const id = document.getElementById('editRegId').value;
    const btn = document.getElementById('saveInternshipBtn');
    btn.disabled = true;

    const payload = {
      first_name: document.getElementById('editFirstName').value.trim(),
      last_name: document.getElementById('editLastName').value.trim(),
      email: document.getElementById('editEmail').value.trim(),
      phone: document.getElementById('editPhone').value.trim(),
      college: document.getElementById('editCollege').value.trim(),
      department: document.getElementById('editDepartment').value.trim(),
      course_id: document.getElementById('editCourseId').value,
      batch_name: document.getElementById('editBatchName').value.trim(),
      start_date: document.getElementById('editStartDate').value,
      end_date: document.getElementById('editEndDate').value,
      mode: document.getElementById('editMode').value,
      status: document.getElementById('editStatus').value,
      total_amount: document.getElementById('editTotalAmount').value,
      paid_amount: document.getElementById('editPaidAmount').value,
      balance_amount: document.getElementById('editBalanceAmount').value,
      referral_code: document.getElementById('editReferralCode').value.trim(),
      notes: document.getElementById('editNotes').value.trim()
    };

    try {
      const res = await fetch(`/api/registrations/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || 'Failed to update record');

      closeEditInternshipModal();
      window.location.reload();
    } catch (err) {
      alert(err.message);
    } finally {
      btn.disabled = false;
    }
  }
</script>
