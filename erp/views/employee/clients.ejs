<div class="erp-h1" style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>
    <div style="font-size: 24px; font-weight: 750;">Find Clients & Corporate Partners</div>
    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 2px;">Search, explore, edit, and convert corporate accounts and college partnerships</div>
  </div>
  <button onclick="openAddClientModal()" class="erp-btn erp-btn-sm" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #000; color: #fff; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; border: none;">
    <i data-lucide="plus" style="width: 15px; height: 15px;"></i>
    <span>Add New Client</span>
  </button>
</div>

<!-- Interactive Catalogue Filter Toolbar (Apple + Google Material 3) -->
<!-- Summary Metric Cards -->
<%
  const totalClients = clients ? clients.length : 0;
  const activePartners = clients ? clients.filter(c => (c.status || '').toLowerCase() === 'partner').length : 0;
  const prospectsCount = clients ? clients.filter(c => (c.status || '').toLowerCase() === 'prospect' || (c.status || '').toLowerCase() === 'contacted').length : 0;
  const industriesCount = clients ? new Set(clients.map(c => (c.industry || c.category || '').trim()).filter(Boolean)).size : 0;
%>
<div class="erp-grid-4" style="margin-bottom: 24px;">
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="building-2"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Total Clients</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= totalClients %></div>
    <div class="erp-p" style="margin-top: 6px; color: #64748B; font-size: 12px;">Enterprise & Colleges</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="handshake"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Active Partners</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= activePartners %></div>
    <div class="erp-p" style="margin-top: 6px; color: #16A34A; font-weight: 600; font-size: 12px;">MoUs & Contracts</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="target"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">In Discussions</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= prospectsCount %></div>
    <div class="erp-p" style="margin-top: 6px; color: #D97706; font-weight: 600; font-size: 12px;">Prospects & Outreach</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="layers"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Industry Sectors</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= industriesCount %></div>
    <div class="erp-p" style="margin-top: 6px; color: #000000; font-weight: 600; font-size: 12px;">Diverse Domains</div>
  </div>
</div>
<div class="catalogue-toolbar" data-catalogue="emp_clients">
  <div class="catalogue-filters-group">
    <!-- Search Input -->
    <div class="catalogue-search-wrap">
      <i data-lucide="search"></i>
      <input type="text" class="catalogue-search-input" placeholder="Search company, contact person, phone...">
    </div>

    <!-- Status Filter -->
    <select class="catalogue-select" data-filter="status" title="Filter by Status">
      <option value="all">All Statuses</option>
      <option value="prospect">Prospect</option>
      <option value="contacted">Contacted</option>
      <option value="partner">Partner</option>
      <option value="closed">Closed</option>
    </select>

    <!-- Industry Filter -->
    <select class="catalogue-select" data-filter="category" title="Filter by Industry">
      <option value="all">All Industries</option>
      <option value="it & software">IT & Software</option>
      <option value="education & colleges">Education & Colleges</option>
      <option value="healthcare tech">Healthcare Tech</option>
      <option value="financial services">Financial Services</option>
      <option value="manufacturing">Manufacturing</option>
    </select>

    <!-- Sort Dropdown -->
    <select class="catalogue-select" data-filter="sort" title="Sort records">
      <option value="name">Company (A - Z)</option>
      <option value="name_desc">Company (Z - A)</option>
      <option value="newest">Newest First</option>
    </select>

    <!-- Reset Button -->
    <button type="button" class="catalogue-reset-btn" title="Reset all filters">
      <i data-lucide="rotate-ccw" style="width: 13px; height: 13px;"></i>
      <span>Reset</span>
    </button>

    <!-- Result Counter -->
    <span class="catalogue-count-badge">Showing <%= clients ? clients.length : 0 %> clients</span>
  </div>

  <!-- Segmented View Switcher: List vs Kanban/Grid -->
  <div class="catalogue-view-switcher">
    <button type="button" class="view-btn active" data-view="list" title="Table List View">
      <i data-lucide="list"></i>
      <span>List</span>
    </button>
    <button type="button" class="view-btn" data-view="kanban" title="Kanban Card Grid View">
      <i data-lucide="layout-grid"></i>
      <span>Kanban</span>
    </button>
  </div>
</div>

<!-- 1. LIST VIEW (Data Table) -->
<div class="catalogue-list-view" data-catalogue="emp_clients">
  <div class="erp-card" style="background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; overflow-x: auto; padding: 0;">
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
      <thead>
        <tr style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0; font-size: 11px; text-transform: uppercase; color: #64748B; font-weight: 700;">
          <th style="padding: 12px 16px;">Code</th>
          <th style="padding: 12px 16px;">Company Name</th>
          <th style="padding: 12px 16px;">Contact Person</th>
          <th style="padding: 12px 16px;">Industry & Location</th>
          <th style="padding: 12px 16px;">Status</th>
          <th style="padding: 12px 16px; text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (clients && clients.length > 0) { %>
          <% clients.forEach(client => { %>
            <tr style="border-bottom: 1px solid #E2E8F0;" id="client-row-<%= client.id %>"
                data-search="<%= (client.company_name + ' ' + (client.client_code || '') + ' ' + (client.contact_person || '') + ' ' + (client.email || '') + ' ' + (client.phone || '') + ' ' + (client.industry || '') + ' ' + (client.location || '')).toLowerCase() %>"
                data-status="<%= (client.status || 'prospect').toLowerCase() %>"
                data-category="<%= (client.industry || '').toLowerCase() %>"
                data-name="<%= (client.company_name || '').toLowerCase() %>"
                data-newest="<%= client.id %>">
              <td style="padding: 12px 16px; font-weight: 600; color: #64748B;"><%= client.client_code %></td>
              <td style="padding: 12px 16px; font-weight: 700; color: #000;"><%= client.company_name %></td>
              <td style="padding: 12px 16px; color: #334155;">
                <div><%= client.contact_person %></div>
                <div style="font-size: 11px; color: #64748B;"><%= client.phone %> &bull; <%= client.email %></div>
              </td>
              <td style="padding: 12px 16px; color: #475569;">
                <div><%= client.industry %></div>
                <div style="font-size: 11px; color: #64748B;"><%= client.location %></div>
              </td>
              <td style="padding: 12px 16px;">
                <% if (client.status === 'partner') { %>
                  <span style="font-size: 11px; font-weight: 700; padding: 2px 7px; background: #000; color: #fff; border-radius: 4px; text-transform: uppercase;">
                    <%= client.status %>
                  </span>
                <% } else { %>
                  <span style="font-size: 11px; font-weight: 700; padding: 2px 7px; background: #F1F5F9; color: #000; border-radius: 4px; text-transform: uppercase;">
                    <%= client.status %>
                  </span>
                <% } %>
              </td>
              <td style="padding: 12px 16px; text-align: right;">
                <div style="display: inline-flex; gap: 6px; align-items: center;">
                  <button type="button" onclick="openEditClientById('<%= client.id %>')" class="erp-btn erp-btn-secondary" style="padding: 4px 8px; font-size: 11px; border: 1px solid #CBD5E1; color: #000; cursor: pointer;">
                    Edit
                  </button>
                  <button type="button"
                    data-id="<%= client.id %>"
                    data-company="<%= client.company_name %>"
                    data-contact="<%= client.contact_person %>"
                    data-email="<%= client.email %>"
                    data-phone="<%= client.phone %>"
                    onclick="handleConvertLeadClick(this)"
                    style="padding: 4px 8px; background: #000; color: #fff; border: none; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;">
                    + Lead
                  </button>
                  <button type="button"
                    data-id="<%= client.id %>"
                    data-company="<%= client.company_name %>"
                    onclick="handleScheduleFollowupClick(this)"
                    style="padding: 4px 8px; background: #fff; color: #000; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 11px; cursor: pointer;"
                    title="Schedule Follow-up">
                    <i data-lucide="phone-call" style="width: 12px; height: 12px;"></i>
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } %>
        <tr class="empty-state-row" style="display: <%= (!clients || clients.length === 0) ? '' : 'none' %>;">
          <td colspan="6" style="padding: 32px; text-align: center; color: #64748B;">No clients matching current filters.</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<!-- 2. KANBAN / GRID VIEW (Material 3 Cards) -->
<div class="catalogue-kanban-view" data-catalogue="emp_clients">
  <% if (clients && clients.length > 0) { %>
    <% clients.forEach(client => { %>
      <div class="kanban-item-card"
           data-search="<%= (client.company_name + ' ' + (client.client_code || '') + ' ' + (client.contact_person || '') + ' ' + (client.email || '') + ' ' + (client.phone || '') + ' ' + (client.industry || '') + ' ' + (client.location || '')).toLowerCase() %>"
           data-status="<%= (client.status || 'prospect').toLowerCase() %>"
           data-category="<%= (client.industry || '').toLowerCase() %>"
           data-name="<%= (client.company_name || '').toLowerCase() %>"
           data-newest="<%= client.id %>">
        <div class="kanban-card-top">
          <div>
            <span style="font-size: 10px; font-weight: 700; color: #64748B; letter-spacing: 0.05em; text-transform: uppercase;"><%= client.client_code %></span>
            <div class="kanban-card-title"><%= client.company_name %></div>
            <div class="kanban-card-subtitle"><%= client.contact_person %> &bull; <%= client.location %></div>
          </div>
          <% if (client.status === 'partner') { %>
            <span style="font-size: 10px; font-weight: 700; padding: 2px 7px; background: #000; color: #fff; border-radius: 4px; text-transform: uppercase;">Partner</span>
          <% } else { %>
            <span style="font-size: 10px; font-weight: 700; padding: 2px 7px; background: #F1F5F9; color: #000; border-radius: 4px; text-transform: uppercase;"><%= client.status %></span>
          <% } %>
        </div>

        <div class="kanban-card-body">
          <div class="kanban-chip-row">
            <span class="kanban-chip">
              <i data-lucide="tag"></i> <%= client.industry %>
            </span>
            <span class="kanban-chip">
              <i data-lucide="map-pin"></i> <%= client.location %>
            </span>
            <% if (client.company_size) { %>
              <span class="kanban-chip">
                <i data-lucide="users"></i> <%= client.company_size %>
              </span>
            <% } %>
          </div>

          <div style="font-size: 12px; color: #334155; line-height: 1.5; padding: 8px 10px; background: #F8FAFC; border-radius: 8px; border: 1px solid #F1F5F9;">
            <div><i data-lucide="phone" style="width: 11px; height: 11px; display: inline-block;"></i> <%= client.phone %></div>
            <div><i data-lucide="mail" style="width: 11px; height: 11px; display: inline-block;"></i> <%= client.email %></div>
            <% if (client.requirements) { %>
              <div style="margin-top: 4px; font-size: 11px; color: #64748B; border-top: 1px dashed #E2E8F0; padding-top: 4px;">
                <em>"<%= client.requirements %>"</em>
              </div>
            <% } %>
          </div>
        </div>

        <div class="kanban-card-footer">
          <button type="button" onclick="openEditClientById('<%= client.id %>')" class="erp-btn erp-btn-secondary" style="padding: 6px 12px; font-size: 12px; border: 1px solid #CBD5E1; color: #000; border-radius: 8px; cursor: pointer;">
            Edit
          </button>
          <div style="display: inline-flex; gap: 6px;">
            <button type="button"
              data-id="<%= client.id %>"
              data-company="<%= client.company_name %>"
              data-contact="<%= client.contact_person %>"
              data-email="<%= client.email %>"
              data-phone="<%= client.phone %>"
              onclick="handleConvertLeadClick(this)"
              style="padding: 6px 10px; background: #000; color: #fff; border: none; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 4px;">
              <i data-lucide="plus-circle" style="width: 12px; height: 12px;"></i>
              <span>+ Lead</span>
            </button>
            <button type="button"
              data-id="<%= client.id %>"
              data-company="<%= client.company_name %>"
              onclick="handleScheduleFollowupClick(this)"
              style="padding: 6px 10px; background: #fff; color: #000; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer;">
              <i data-lucide="phone-call" style="width: 13px; height: 13px;"></i>
            </button>
          </div>
        </div>
      </div>
    <% }) %>
  <% } %>
  <div class="kanban-empty-state" style="display: <%= (!clients || clients.length === 0) ? 'block' : 'none' %>;">
    <i data-lucide="building" style="width: 36px; height: 36px; margin: 0 auto 10px; color: #94A3B8;"></i>
    <div style="font-weight: 700; font-size: 15px; color: #000;">No Clients Found</div>
    <div style="font-size: 12px; color: #64748B; margin-top: 4px;">Try adjusting your search criteria or add a new client to your directory.</div>
  </div>
</div>

<!-- Modal: Add / Edit Client -->
<div id="addClientModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center; padding: 16px;">
  <div style="background: #fff; border-radius: 14px; width: 100%; max-width: 520px; max-height: 90vh; overflow-y: auto; padding: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h3 id="clientModalTitle" style="font-size: 18px; font-weight: 750; color: #000; margin: 0;">Add New Client</h3>
      <button onclick="closeAddClientModal()" style="background: none; border: none; font-size: 20px; cursor: pointer; color: #64748B;">&times;</button>
    </div>

    <form id="addClientForm" onsubmit="handleCreateClient(event)">
      <input type="hidden" name="id" id="modalClientId">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
        <div style="grid-column: span 2;">
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Company / Institution Name *</label>
          <input type="text" name="company_name" id="modalClientCompany" required placeholder="e.g. Acme Technologies" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
        </div>
        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Contact Person *</label>
          <input type="text" name="contact_person" id="modalClientContact" required placeholder="e.g. Ramesh Kumar" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
        </div>
        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Phone Number *</label>
          <input type="tel" name="phone" id="modalClientPhone" required placeholder="e.g. 9876543210" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
        </div>
        <div style="grid-column: span 2;">
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Official Email *</label>
          <input type="email" name="email" id="modalClientEmail" required placeholder="e.g. contact@acme.com" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
        </div>
        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Industry</label>
          <select name="industry" id="modalClientIndustry" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; background: #fff;">
            <option value="IT & Software">IT & Software</option>
            <option value="Education & Colleges">Education & Colleges</option>
            <option value="Healthcare Tech">Healthcare Tech</option>
            <option value="Financial Services">Financial Services</option>
            <option value="Manufacturing">Manufacturing</option>
          </select>
        </div>
        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Location / City</label>
          <input type="text" name="location" id="modalClientLocation" placeholder="e.g. Chennai" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
        </div>
        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Company Size</label>
          <select name="company_size" id="modalClientSize" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; background: #fff;">
            <option value="1-10">1-10 employees</option>
            <option value="11-50" selected>11-50 employees</option>
            <option value="51-200">51-200 employees</option>
            <option value="201-500">201-500 employees</option>
            <option value="500+">500+ employees</option>
          </select>
        </div>
        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Status</label>
          <select name="status" id="modalClientStatus" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; background: #fff;">
            <option value="prospect" selected>Prospect</option>
            <option value="contacted">Contacted</option>
            <option value="partner">Partner</option>
            <option value="closed">Closed</option>
          </select>
        </div>
        <div style="grid-column: span 2;">
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Website URL</label>
          <input type="url" name="website" id="modalClientWebsite" placeholder="https://example.com" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
        </div>
        <div style="grid-column: span 2;">
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Requirements & Notes</label>
          <textarea name="requirements" id="modalClientRequirements" rows="2" placeholder="e.g. Looking for batch hiring of 20 interns..." style="width: 100%; padding: 8px 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; resize: vertical;"></textarea>
        </div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px;">
        <button type="button" onclick="closeAddClientModal()" style="padding: 8px 16px; background: #F1F5F9; color: #334155; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">Cancel</button>
        <button type="submit" id="saveClientBtn" style="padding: 8px 18px; background: #000; color: #fff; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">Save Client</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Convert Client to Lead -->
<div id="convertLeadModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center; padding: 16px;">
  <div style="background: #fff; border-radius: 14px; width: 100%; max-width: 500px; padding: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h3 style="font-size: 18px; font-weight: 750; color: #000; margin: 0;">Add as Sales / Training Lead</h3>
      <button onclick="closeConvertLeadModal()" style="background: none; border: none; font-size: 20px; cursor: pointer; color: #64748B;">&times;</button>
    </div>

    <form id="convertLeadForm" onsubmit="handleCreateLead(event)">
      <input type="hidden" name="client_id" id="leadClientId">
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Deal Title *</label>
          <input type="text" name="title" id="leadTitle" required placeholder="e.g. Full-Stack Training Batch (15 Students)" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Company Name</label>
            <input type="text" name="company_name" id="leadCompany" required style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Contact Name</label>
            <input type="text" name="contact_name" id="leadContact" required style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
          </div>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Expected Value (₹)</label>
            <input type="number" name="deal_value" placeholder="e.g. 75000" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Initial Stage</label>
            <select name="stage" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; background: #fff;">
              <option value="new">New Lead</option>
              <option value="contacted" selected>Contacted</option>
              <option value="discussion">In Discussion</option>
            </select>
          </div>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Priority</label>
            <select name="priority" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; background: #fff;">
              <option value="high">High Priority</option>
              <option value="medium" selected>Medium Priority</option>
              <option value="low">Low Priority</option>
            </select>
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Source</label>
            <select name="source" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; background: #fff;">
              <option value="inbound">Inbound Client</option>
              <option value="cold_outreach">Cold Outreach</option>
              <option value="linkedin">LinkedIn</option>
              <option value="referral">Referral</option>
            </select>
          </div>
        </div>
        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Next Follow-up Date</label>
          <input type="datetime-local" name="next_followup_date" style="width: 100%; height: 38px; padding: 0 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px;">
        </div>
        <div>
          <label style="font-size: 12px; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Notes</label>
          <textarea name="notes" rows="2" placeholder="Requirements discussed, batch timeline, etc." style="width: 100%; padding: 8px 10px; border: 1px solid #CBD5E1; border-radius: 6px; font-size: 13px; resize: vertical;"></textarea>
        </div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 18px;">
        <button type="button" onclick="closeConvertLeadModal()" style="padding: 8px 16px; background: #F1F5F9; color: #334155; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">Cancel</button>
        <button type="submit" id="saveLeadBtn" style="padding: 8px 18px; background: #000; color: #fff; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">Create Lead</button>
      </div>
    </form>
  </div>
</div>

<script>
  const allClientsMap = <%- JSON.stringify((clients || []).reduce((acc, c) => ({ ...acc, [c.id]: c }), {})) %>;

  function openAddClientModal() {
    document.getElementById('clientModalTitle').textContent = 'Add New Client';
    document.getElementById('modalClientId').value = '';
    document.getElementById('modalClientCompany').value = '';
    document.getElementById('modalClientContact').value = '';
    document.getElementById('modalClientPhone').value = '';
    document.getElementById('modalClientEmail').value = '';
    document.getElementById('modalClientIndustry').value = 'IT & Software';
    document.getElementById('modalClientLocation').value = 'Chennai';
    document.getElementById('modalClientSize').value = '11-50';
    document.getElementById('modalClientStatus').value = 'prospect';
    document.getElementById('modalClientWebsite').value = '';
    document.getElementById('modalClientRequirements').value = '';
    document.getElementById('saveClientBtn').textContent = 'Save Client';
    document.getElementById('addClientModal').style.display = 'flex';
  }

  function openEditClientById(id) {
    const c = allClientsMap[id];
    if (!c) return console.warn('Client not found:', id);

    document.getElementById('clientModalTitle').textContent = `Edit Client: ${c.company_name}`;
    document.getElementById('modalClientId').value = c.id;
    document.getElementById('modalClientCompany').value = c.company_name || '';
    document.getElementById('modalClientContact').value = c.contact_person || '';
    document.getElementById('modalClientPhone').value = c.phone || '';
    document.getElementById('modalClientEmail').value = c.email || '';
    document.getElementById('modalClientIndustry').value = c.industry || 'IT & Software';
    document.getElementById('modalClientLocation').value = c.location || '';
    document.getElementById('modalClientSize').value = c.company_size || '11-50';
    document.getElementById('modalClientStatus').value = c.status || 'prospect';
    document.getElementById('modalClientWebsite').value = c.website || '';
    document.getElementById('modalClientRequirements').value = c.requirements || '';
    document.getElementById('saveClientBtn').textContent = 'Update Client';
    document.getElementById('addClientModal').style.display = 'flex';
  }

  function closeAddClientModal() {
    document.getElementById('addClientModal').style.display = 'none';
  }

  function openConvertLeadModal(clientId, company, contact, email, phone) {
    document.getElementById('leadClientId').value = clientId;
    document.getElementById('leadCompany').value = company;
    document.getElementById('leadContact').value = contact;
    document.getElementById('leadTitle').value = `${company} - Training Batch`;
    document.getElementById('convertLeadModal').style.display = 'flex';
  }
  function closeConvertLeadModal() {
    document.getElementById('convertLeadModal').style.display = 'none';
  }

  function handleConvertLeadClick(btn) {
    if (!btn || !btn.dataset) return;
    openConvertLeadModal(btn.dataset.id, btn.dataset.company, btn.dataset.contact, btn.dataset.email, btn.dataset.phone);
  }

  function handleScheduleFollowupClick(btn) {
    if (!btn || !btn.dataset) return;
    openScheduleFollowUpModal(btn.dataset.id, btn.dataset.company);
  }

  function openScheduleFollowUpModal(clientId, company) {
    window.location.href = `/employee/follow-ups?new=true&client_id=${clientId}`;
  }

  async function handleCreateClient(e) {
    e.preventDefault();
    const btn = document.getElementById('saveClientBtn');
    btn.disabled = true;

    const id = document.getElementById('modalClientId').value;
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());

    try {
      const url = id ? `/api/employee/clients/${id}` : '/api/employee/clients';
      const method = id ? 'PUT' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json();
      if (result.success) {
        window.location.reload();
      } else {
        alert(result.message || 'Failed to save client');
        btn.disabled = false;
      }
    } catch (err) {
      alert('Error saving client');
      btn.disabled = false;
    }
  }

  async function handleCreateLead(e) {
    e.preventDefault();
    const btn = document.getElementById('saveLeadBtn');
    btn.disabled = true;
    btn.textContent = 'Creating...';

    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());

    try {
      const res = await fetch('/api/employee/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json();
      if (result.success) {
        window.location.href = '/employee/leads';
      } else {
        alert(result.message || 'Failed to create lead');
        btn.disabled = false;
        btn.textContent = 'Create Lead';
      }
    } catch (err) {
      alert('Error creating lead');
      btn.disabled = false;
      btn.textContent = 'Create Lead';
    }
  }
</script>
