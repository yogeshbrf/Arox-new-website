<div class="erp-h1" style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>
    <div style="font-size: 26px; font-weight: 750; letter-spacing: -0.02em;">Welcome back, <%= user.first_name || 'Staff' %></div>
    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 4px;">Employee Workspace, Referred Students &amp; Proof Uploads</div>
  </div>
  <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
    <% if (typeof referralCode !== 'undefined' && referralCode) { %>
      <div style="display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 8px; font-size: 12px;">
        <span style="color: #1E40AF; font-weight: 700;">My Referral Code:</span>
        <span style="font-family: monospace; font-weight: 800; color: #0F172A;" id="empDashRefCode"><%= referralCode %></span>
        <button type="button" onclick="copyEmpRefCode()" style="padding: 3px 8px; background: #155EEF; color: #fff; border: none; border-radius: 5px; font-size: 11px; font-weight: 700; cursor: pointer;">Copy</button>
      </div>
    <% } %>
    <a href="/employee/leads" class="erp-btn erp-btn-sm" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; background: #000; color: #fff; border-radius: 8px; font-size: 12px; font-weight: 600;">
      <i data-lucide="plus" style="width: 14px; height: 14px;"></i>
      <span>Add Lead</span>
    </a>
    <a href="/employee/students" class="erp-btn erp-btn-sm" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; background: #fff; color: #000; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 12px; font-weight: 600;">
      <i data-lucide="users" style="width: 14px; height: 14px;"></i>
      <span>My Referred Students (<%= typeof referredStudentsCount !== 'undefined' ? referredStudentsCount : 0 %>)</span>
    </a>
  </div>
</div>

<!-- KPI Cards -->
<div class="erp-grid-4 emp-kpi-grid" style="margin-bottom: 28px;">
  <!-- Clients Card -->
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px; border-radius: 12px;">
    <div class="erp-card-header" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
      <div style="font-size: 13px; font-weight: 600; color: #64748B;">Total Clients</div>
      <div style="width: 36px; height: 36px; border-radius: 8px; background: #000; color: #fff; display: flex; align-items: center; justify-content: center;">
        <i data-lucide="building-2" style="width: 18px; height: 18px;"></i>
      </div>
    </div>
    <div class="erp-card-value" style="font-size: 28px; font-weight: 750; color: #000000;"><%= clientStats.total %></div>
    <div style="font-size: 12px; color: #64748B; margin-top: 6px;">
      <span style="color: #000; font-weight: 600;"><%= clientStats.partner %></span> Partners • <span style="color: #000; font-weight: 600;"><%= clientStats.prospect %></span> Prospects
    </div>
  </div>

  <!-- Active Leads Card -->
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px; border-radius: 12px;">
    <div class="erp-card-header" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
      <div style="font-size: 13px; font-weight: 600; color: #64748B;">Leads Pipeline</div>
      <div style="width: 36px; height: 36px; border-radius: 8px; background: #000; color: #fff; display: flex; align-items: center; justify-content: center;">
        <i data-lucide="target" style="width: 18px; height: 18px;"></i>
      </div>
    </div>
    <div class="erp-card-value" style="font-size: 28px; font-weight: 750; color: #000000;"><%= pipelineStats.totalDeals %> Deals</div>
    <div style="font-size: 12px; color: #64748B; margin-top: 6px;">
      Pipeline: <span style="color: #000; font-weight: 600;">₹<%= pipelineStats.totalPipelineValue.toLocaleString('en-IN') %></span>
    </div>
  </div>

  <!-- Today's Follow-ups Card -->
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px; border-radius: 12px;">
    <div class="erp-card-header" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
      <div style="font-size: 13px; font-weight: 600; color: #64748B;">Today's Follow-ups</div>
      <div style="width: 36px; height: 36px; border-radius: 8px; background: #000; color: #fff; display: flex; align-items: center; justify-content: center;">
        <i data-lucide="phone-call" style="width: 18px; height: 18px;"></i>
      </div>
    </div>
    <div class="erp-card-value" style="font-size: 28px; font-weight: 750; color: #000000;"><%= followUpStats.today %></div>
    <div style="font-size: 12px; color: #64748B; margin-top: 6px;">
      <span style="color: #000; font-weight: 600;"><%= followUpStats.completed %></span> completed • <%= followUpStats.overdue %> overdue
    </div>
  </div>

  <!-- Performance Card -->
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px; border-radius: 12px;">
    <div class="erp-card-header" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
      <div style="font-size: 13px; font-weight: 600; color: #64748B;">Monthly Target Score</div>
      <div style="width: 36px; height: 36px; border-radius: 8px; background: #000; color: #fff; display: flex; align-items: center; justify-content: center;">
        <i data-lucide="award" style="width: 18px; height: 18px;"></i>
      </div>
    </div>
    <div class="erp-card-value" style="font-size: 28px; font-weight: 750; color: #000000;"><%= performance.overallScore %>%</div>
    <div style="font-size: 12px; color: #64748B; margin-top: 6px;">
      Rating: <span style="color: #000; font-weight: 600;">★ <%= performance.rating %>/5.0</span>
    </div>
  </div>
</div>

<!-- Main Content Grid -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 24px; margin-bottom: 32px;">

  <!-- Left Column: Today's Follow-up Schedule -->
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 24px; border-radius: 12px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid #E2E8F0;">
      <div>
        <h3 style="font-size: 16px; font-weight: 700; margin: 0; color: #000;">Today's Follow-ups & Calls</h3>
        <p style="font-size: 12px; color: #64748B; margin: 2px 0 0 0;">Prioritized customer touches and meetings</p>
      </div>
      <a href="/employee/follow-ups" style="font-size: 12px; font-weight: 600; color: #000; text-decoration: underline;">View All &rarr;</a>
    </div>

    <% if (todayFollowUps && todayFollowUps.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <% todayFollowUps.forEach(f => { %>
          <% if (f.status === 'completed') { %>
            <div style="border: 1px solid #E2E8F0; border-radius: 10px; padding: 14px; background: #F8FAFC; display: flex; justify-content: space-between; align-items: center; gap: 12px;">
          <% } else { %>
            <div style="border: 1px solid #E2E8F0; border-radius: 10px; padding: 14px; background: #FFFFFF; display: flex; justify-content: space-between; align-items: center; gap: 12px;">
          <% } %>
            <div style="display: flex; align-items: center; gap: 12px;">
              <div style="width: 36px; height: 36px; border-radius: 8px; background: #000; color: #fff; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <% if (f.type === 'phone_call') { %>
                  <i data-lucide="phone" style="width: 16px; height: 16px;"></i>
                <% } else if (f.type === 'video_meeting') { %>
                  <i data-lucide="video" style="width: 16px; height: 16px;"></i>
                <% } else { %>
                  <i data-lucide="calendar" style="width: 16px; height: 16px;"></i>
                <% } %>
              </div>
              <div>
                <div style="font-size: 13px; font-weight: 650; color: #000;"><%= f.title %></div>
                <div style="font-size: 11px; color: #64748B; margin-top: 2px;">
                  <%= f.lead_company || f.client_company || 'Client' %> &bull; <%= new Date(f.scheduled_at).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %>
                </div>
              </div>
            </div>
            <div>
              <% if (f.status === 'completed') { %>
                <span style="font-size: 11px; padding: 4px 8px; background: #F1F5F9; color: #000; border-radius: 6px; font-weight: 600;">Done ✓</span>
              <% } else { %>
                <button type="button" data-id="<%= f.id %>" onclick="handleQuickCompleteFollowup(this)" class="erp-btn erp-btn-sm" style="padding: 4px 10px; font-size: 11px; font-weight: 600; background: #000; color: #fff; border-radius: 6px; border: none; cursor: pointer;">
                  Complete
                </button>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div style="padding: 32px 16px; text-align: center; color: #64748B; background: #F8FAFC; border-radius: 8px;">
        <i data-lucide="check-circle" style="width: 28px; height: 28px; margin: 0 auto 8px auto; color: #CBD5E1;"></i>
        <div style="font-size: 13px; font-weight: 600;">No pending follow-ups for today</div>
        <a href="/employee/follow-ups" style="display: inline-block; margin-top: 8px; font-size: 12px; color: #000; font-weight: 600; text-decoration: underline;">Schedule a call</a>
      </div>
    <% } %>
  </div>

  <!-- Right Column: Priority Tasks -->
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 24px; border-radius: 12px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid #E2E8F0;">
      <div>
        <h3 style="font-size: 16px; font-weight: 700; margin: 0; color: #000;">My Priority Tasks</h3>
        <p style="font-size: 12px; color: #64748B; margin: 2px 0 0 0;"><%= taskStats.pending %> active tasks pending completion</p>
      </div>
      <a href="/employee/tasks" style="font-size: 12px; font-weight: 600; color: #000; text-decoration: underline;">View All &rarr;</a>
    </div>

    <% if (pendingTasks && pendingTasks.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <% pendingTasks.forEach(t => { %>
          <div style="border: 1px solid #E2E8F0; border-radius: 8px; padding: 12px 14px; display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 10px;">
              <input type="checkbox" data-id="<%= t.id %>" onchange="handleToggleTask(this)" style="cursor: pointer; accent-color: #000; width: 16px; height: 16px;">
              <div>
                <div style="font-size: 13px; font-weight: 600; color: #000;"><%= t.title %></div>
                <div style="font-size: 11px; color: #64748B;">
                  Due: <%= t.due_date || 'No due date' %> &bull; <span style="text-transform: capitalize; font-weight: 600;"><%= t.priority %> Priority</span>
                </div>
                <% if (t.attachment_name || t.attachment_path) {
                     const dashDocName = t.attachment_original_name || t.attachment_name || 'Document';
                %>
                  <div style="margin-top: 5px; display: inline-flex; align-items: center; gap: 5px; flex-wrap: wrap;">
                    <span style="font-size: 11px; color: #1E40AF; font-weight: 600;"><%= dashDocName %></span>
                    <button type="button" onclick="openTaskAttachmentPreview('<%= t.id %>', '<%= t.attachment_ext || '' %>', '<%= dashDocName.replace(/'/g, "\\'") %>')"
                            style="border: none; background: #0F172A; color: #fff; font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 4px; cursor: pointer;">View</button>
                    <a href="/api/employee/tasks/<%= t.id %>/attachment?download=1"
                       style="font-size: 10px; font-weight: 700; color: #155EEF; text-decoration: none;">Download</a>
                  </div>
                <% } %>
              </div>
            </div>
            <span style="font-size: 10px; padding: 3px 6px; background: #F1F5F9; border-radius: 4px; font-weight: 600; text-transform: uppercase;"><%= t.category %></span>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div style="padding: 32px 16px; text-align: center; color: #64748B; background: #F8FAFC; border-radius: 8px;">
        <i data-lucide="check-square" style="width: 28px; height: 28px; margin: 0 auto 8px auto; color: #CBD5E1;"></i>
        <div style="font-size: 13px; font-weight: 600;">All tasks completed! Great job.</div>
        <a href="/employee/tasks" style="display: inline-block; margin-top: 8px; font-size: 12px; color: #000; font-weight: 600; text-decoration: underline;">Create a task</a>
      </div>
    <% } %>
  </div>

</div>
<script src="/js/doc-preview.js"></script>

<!-- Pipeline Stage Progress Bar -->
<div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 24px; border-radius: 12px; margin-bottom: 24px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
    <div>
      <h3 style="font-size: 16px; font-weight: 700; margin: 0; color: #000;">Sales & Corporate Training Pipeline</h3>
      <p style="font-size: 12px; color: #64748B; margin: 2px 0 0 0;">Live status across deals and corporate batches</p>
    </div>
    <a href="/employee/leads" style="font-size: 12px; font-weight: 600; color: #000; text-decoration: underline;">Open Kanban Board &rarr;</a>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px;">
    <div style="border: 1px solid #E2E8F0; border-radius: 8px; padding: 12px; text-align: center; background: #F8FAFC;">
      <div style="font-size: 11px; font-weight: 600; color: #64748B; text-transform: uppercase;">1. New</div>
      <div style="font-size: 20px; font-weight: 750; color: #000; margin: 4px 0;"><%= pipelineStats.stages.new.count %></div>
      <div style="font-size: 11px; color: #64748B;">₹<%= pipelineStats.stages.new.value.toLocaleString('en-IN') %></div>
    </div>
    <div style="border: 1px solid #E2E8F0; border-radius: 8px; padding: 12px; text-align: center; background: #F8FAFC;">
      <div style="font-size: 11px; font-weight: 600; color: #64748B; text-transform: uppercase;">2. Contacted</div>
      <div style="font-size: 20px; font-weight: 750; color: #000; margin: 4px 0;"><%= pipelineStats.stages.contacted.count %></div>
      <div style="font-size: 11px; color: #64748B;">₹<%= pipelineStats.stages.contacted.value.toLocaleString('en-IN') %></div>
    </div>
    <div style="border: 1px solid #E2E8F0; border-radius: 8px; padding: 12px; text-align: center; background: #F8FAFC;">
      <div style="font-size: 11px; font-weight: 600; color: #64748B; text-transform: uppercase;">3. Discussion</div>
      <div style="font-size: 20px; font-weight: 750; color: #000; margin: 4px 0;"><%= pipelineStats.stages.discussion.count %></div>
      <div style="font-size: 11px; color: #64748B;">₹<%= pipelineStats.stages.discussion.value.toLocaleString('en-IN') %></div>
    </div>
    <div style="border: 1px solid #E2E8F0; border-radius: 8px; padding: 12px; text-align: center; background: #F8FAFC;">
      <div style="font-size: 11px; font-weight: 600; color: #64748B; text-transform: uppercase;">4. Proposal</div>
      <div style="font-size: 20px; font-weight: 750; color: #000; margin: 4px 0;"><%= pipelineStats.stages.proposal.count %></div>
      <div style="font-size: 11px; color: #64748B;">₹<%= pipelineStats.stages.proposal.value.toLocaleString('en-IN') %></div>
    </div>
    <div style="border: 1px solid #E2E8F0; border-radius: 8px; padding: 12px; text-align: center; background: #000; color: #fff;">
      <div style="font-size: 11px; font-weight: 600; color: #CBD5E1; text-transform: uppercase;">5. Won</div>
      <div style="font-size: 20px; font-weight: 750; color: #fff; margin: 4px 0;"><%= pipelineStats.stages.won.count %></div>
      <div style="font-size: 11px; color: #94A3B8;">₹<%= pipelineStats.stages.won.value.toLocaleString('en-IN') %></div>
    </div>
  </div>
</div>

<!-- Employee Referred Students (Strict Referral Code Scope) + Upload Work Proof -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 24px; margin-bottom: 32px;">

  <!-- My Referred Students Only -->
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 24px; border-radius: 12px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid #E2E8F0;">
      <div>
        <h3 style="font-size: 16px; font-weight: 750; margin: 0; color: #000;">My Referred Students (<%= (typeof referredStudents !== 'undefined' && referredStudents) ? referredStudents.length : 0 %>)</h3>
        <p style="font-size: 12px; color: #64748B; margin: 2px 0 0 0;">
          <% if (typeof referralCode !== 'undefined' && referralCode) { %>
            Only students registered with code <strong style="font-family: monospace; color: #155EEF;"><%= referralCode %></strong>
          <% } else { %>
            Students referred via your unique code
          <% } %>
        </p>
      </div>
      <a href="/employee/students" style="font-size: 12px; font-weight: 600; color: #000; text-decoration: underline;">View All &rarr;</a>
    </div>

    <% if (typeof referralCode !== 'undefined' && referralCode) { %>
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 12px; background: #F8FAFC; border: 1px dashed #CBD5E1; border-radius: 8px; margin-bottom: 14px; font-size: 12px;">
        <span style="color: #475569; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Share link: <strong id="empRefInvitePath">/apply?ref=<%= referralCode %></strong></span>
        <button type="button" onclick="copyEmpInviteLink()" style="padding: 4px 10px; background: #0F172A; color: #fff; border: none; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer; white-space: nowrap;">Copy Link</button>
      </div>
    <% } %>

    <% if (typeof referredStudents !== 'undefined' && referredStudents && referredStudents.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 10px; max-height: 310px; overflow-y: auto;">
        <% referredStudents.forEach(st => { %>
          <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; border: 1px solid #E2E8F0; border-radius: 8px; background: #F8FAFC;">
            <div>
              <div style="font-weight: 700; font-size: 13px; color: #0F172A;"><%= st.first_name %> <%= st.last_name || '' %></div>
              <div style="font-size: 11px; color: #64748B;"><%= st.course_title || 'Registered Account' %> · <%= st.phone || st.email %></div>
            </div>
            <span style="font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 99px; background: #DBEAFE; color: #1E40AF; text-transform: uppercase;">
              <%= st.reg_status || 'enrolled' %>
            </span>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div style="text-align: center; padding: 28px 16px; color: #64748B; font-size: 13px;">
        No students have registered with your referral code yet. Share <strong><%= (typeof referralCode !== 'undefined' && referralCode) ? referralCode : 'your code' %></strong> to onboard students!
      </div>
    <% } %>
  </div>

  <!-- Upload Work Proof (Dropdown + PDF/PPTX/XLSX/DOCX up to 10MB) -->
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 24px; border-radius: 12px;">
    <div style="border-bottom: 1px solid #E2E8F0; padding-bottom: 12px; margin-bottom: 16px;">
      <h3 style="font-size: 16px; font-weight: 750; margin: 0; color: #000; display: flex; align-items: center; gap: 8px;">
        <i data-lucide="file-up" style="width: 18px; height: 18px; color: #155EEF;"></i>
        Upload Work Deliverable Proof
      </h3>
      <p style="font-size: 12px; color: #64748B; margin: 2px 0 0 0;">Accepted formats: <strong>.pdf, .pptx, .xlsx, .docx</strong> (Max 10 MB)</p>
    </div>

    <form id="employeeProofForm" onsubmit="handleUploadProof(event)" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 12px;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
        <div>
          <label class="erp-label">Proof Category *</label>
          <select id="proofCategorySelect" name="category" class="erp-input" required>
            <option value="Daily Work Report">Daily Work Report</option>
            <option value="Task Deliverable">Task Deliverable Proof</option>
            <option value="Client Presentation">Client Presentation (.pptx)</option>
            <option value="Spreadsheets & Metrics">Spreadsheets &amp; Metrics (.xlsx)</option>
            <option value="Documentation">Documentation (.docx / .pdf)</option>
            <option value="Training & Batch Proof">Training / Lab Session Proof</option>
          </select>
        </div>
        <div>
          <label class="erp-label">Link Assigned Task (Optional)</label>
          <select id="proofTaskIdSelect" name="task_id" class="erp-input">
            <option value="">-- General Deliverable --</option>
            <% if (typeof myTasks !== 'undefined' && myTasks) { %>
              <% myTasks.forEach(t => { %>
                <option value="<%= t.id %>"><%= t.title %> (<%= t.status %>)</option>
              <% }) %>
            <% } %>
          </select>
        </div>
      </div>

      <div>
        <label class="erp-label">Proof Title / Short Description *</label>
        <input type="text" id="proofTitleInput" name="title" class="erp-input" required placeholder="e.g. Week 3 Client Outreach Deck / Report">
      </div>

      <div>
        <label class="erp-label">Attach Document (.pdf, .pptx, .xlsx, .docx — Max 10MB) *</label>
        <input type="file" id="proofFileInput" name="proof" accept=".pdf,.pptx,.xlsx,.docx,application/pdf,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.wordprocessingml.document" class="erp-input" required style="padding: 8px;">
      </div>

      <div>
        <label class="erp-label">Remarks (Optional)</label>
        <input type="text" id="proofRemarksInput" name="remarks" class="erp-input" placeholder="Summary notes for Admin reviewer...">
      </div>

      <button type="submit" id="btnUploadProof" class="erp-btn erp-btn-primary" style="background: #0F172A; color: #fff; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; gap: 8px;">
        <i data-lucide="upload-cloud" style="width: 16px; height: 16px;"></i>
        Upload Proof Document
      </button>
    </form>

    <!-- Uploaded Proofs History -->
    <div style="margin-top: 18px; border-top: 1px solid #E2E8F0; padding-top: 14px;">
      <div style="font-size: 12px; font-weight: 700; color: #334155; margin-bottom: 8px;">My Submitted Proofs (<%= (typeof uploadedProofs !== 'undefined' && uploadedProofs) ? uploadedProofs.length : 0 %>)</div>
      <% if (typeof uploadedProofs !== 'undefined' && uploadedProofs && uploadedProofs.length > 0) { %>
        <div style="display: flex; flex-direction: column; gap: 8px; max-height: 190px; overflow-y: auto;">
          <% uploadedProofs.forEach(pf => { %>
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 8px 10px; border: 1px solid #E2E8F0; border-radius: 8px; background: #F8FAFC; font-size: 12px;">
              <div style="min-width: 0;">
                <a href="<%= pf.file_path %>" target="_blank" style="font-weight: 700; color: #155EEF; text-decoration: none; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= pf.title || pf.original_name %></a>
                <div style="font-size: 11px; color: #64748B;"><%= pf.category %> · <span style="text-transform: uppercase;"><%= pf.file_ext %></span> (<%= (Number(pf.file_size || 0) / (1024 * 1024)).toFixed(2) %> MB)</div>
              </div>
              <div style="display: flex; align-items: center; gap: 6px; flex-shrink: 0;">
                <span style="font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 99px; text-transform: uppercase; background: <%= pf.status === 'approved' ? '#DCFCE7' : (pf.status === 'rejected' ? '#FEE2E2' : '#DBEAFE') %>; color: <%= pf.status === 'approved' ? '#166534' : (pf.status === 'rejected' ? '#B91C1C' : '#1E40AF') %>;"><%= pf.status %></span>
                <% if (pf.status !== 'approved') { %>
                  <button type="button" onclick="deleteMyProof(<%= pf.id %>)" style="border:none; background:#FEE2E2; color:#B91C1C; border-radius:5px; padding:3px 7px; font-size:11px; font-weight:700; cursor:pointer;">Delete</button>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div style="font-size: 12px; color: #94A3B8;">No work proofs uploaded yet.</div>
      <% } %>
    </div>
  </div>
</div>

<script>
  function copyEmpRefCode() {
    const code = '<%= typeof referralCode !== "undefined" && referralCode ? referralCode : "" %>';
    if (!code) return;
    navigator.clipboard.writeText(code).then(() => alert('Referral code copied: ' + code));
  }

  function copyEmpInviteLink() {
    const code = '<%= typeof referralCode !== "undefined" && referralCode ? referralCode : "" %>';
    if (!code) return;
    const url = window.location.origin + '/apply?ref=' + encodeURIComponent(code);
    navigator.clipboard.writeText(url).then(() => alert('Invite link copied: ' + url));
  }

  async function handleUploadProof(e) {
    e.preventDefault();
    const fileInput = document.getElementById('proofFileInput');
    const file = fileInput && fileInput.files && fileInput.files[0];
    if (!file) return alert('Please select a file (.pdf, .pptx, .xlsx, .docx).');
    if (file.size > 10 * 1024 * 1024) return alert('File exceeds the 10 MB limit.');
    if (!/\.(pdf|pptx|xlsx|docx)$/i.test(file.name)) {
      return alert('Invalid format. Only .pdf, .pptx, .xlsx, and .docx files are allowed.');
    }

    const btn = document.getElementById('btnUploadProof');
    const orig = btn.innerHTML;
    btn.disabled = true;
    btn.textContent = 'Uploading...';

    try {
      const fd = new FormData(e.target);
      const res = await fetch('/api/employee/proofs', { method: 'POST', body: fd });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.message || 'Upload failed');
      alert('Work proof uploaded successfully!');
      window.location.reload();
    } catch (err) {
      alert(err.message);
      btn.disabled = false;
      btn.innerHTML = orig;
    }
  }

  async function deleteMyProof(id) {
    if (!confirm('Remove this work proof document?')) return;
    const res = await fetch('/api/employee/proofs/' + id, { method: 'DELETE' });
    const data = await res.json();
    if (!data.success) return alert(data.message || 'Delete failed');
    window.location.reload();
  }
</script>

<script>
  function handleQuickCompleteFollowup(btn) {
    if (btn && btn.dataset && btn.dataset.id) {
      quickCompleteFollowUp(btn.dataset.id);
    }
  }

  function handleToggleTask(checkbox) {
    if (checkbox && checkbox.dataset && checkbox.dataset.id) {
      toggleTaskDone(checkbox.dataset.id, checkbox);
    }
  }

  async function quickCompleteFollowUp(id) {
    if (!confirm('Mark this follow-up call as completed?')) return;
    try {
      const res = await fetch(`/api/employee/follow-ups/${id}/complete`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ outcome: 'interested', notes: 'Completed via quick dashboard action' })
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert(data.message || 'Failed to update follow-up');
      }
    } catch (e) {
      alert('Error updating follow-up');
    }
  }

  async function toggleTaskDone(id, checkbox) {
    if (!checkbox.checked) return;
    try {
      const res = await fetch(`/api/employee/tasks/${id}/status`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: 'completed' })
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        checkbox.checked = false;
        alert(data.message || 'Failed to update task');
      }
    } catch (e) {
      checkbox.checked = false;
      alert('Error updating task');
    }
  }
</script>
