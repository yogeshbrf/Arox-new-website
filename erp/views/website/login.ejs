    let isAnimating = false;

    /* ── Read CSS variable as milliseconds ── */
    function cssMs(name) {
      const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      return parseFloat(v) * (v.includes('ms') ? 1 : 1000) || 0;
    }

    
    /* ── Clear all form fields (anti-prefill) ── */
    function clearForms() {
      document.querySelectorAll('.pill-input').forEach(inp => {
        inp.value = '';
        if (inp.type === 'text' && inp.name.includes('pass')) inp.type = 'password';
      });
      // Reset eye toggles
      document.querySelectorAll('.eye-btn').forEach(btn => {
        const eo = btn.querySelector('.eo'), ec = btn.querySelector('.ec');
        if (eo) eo.style.display = '';
        if (ec) ec.style.display = 'none';
      });
    }

    /* ── Remove readonly on first focus (anti-autofill) ── */
    function initReadonly() {
      document.querySelectorAll('.pill-input[readonly]').forEach(inp => {
        inp.addEventListener('focus', function h() {
          this.removeAttribute('readonly');
          this.removeEventListener('focus', h);
        }, { once: true });
      });
    }

    /* ── Portal role ── */
    function setPortalRole(role) {
      currentRole = role;
      document.querySelectorAll('.portal-btn').forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-role') === role);
      });
      try { localStorage.setItem('arox_user_role', role); } catch(e){}
    }

    /* ── TOGGLE AUTH MODE (the main animation driver) ── */
    function toggleAuth(mode) {
      if (isAnimating || mode === currentMode) return;
      isAnimating = true;
      currentMode = mode;

      const sweepMs = cssMs('--sweep');
      const swapMs  = cssMs('--swap-delay');
      const fadeMs  = cssMs('--fade');
      const isReg   = mode === 'register';

      /* ─── DESKTOP: just toggle .active, CSS handles everything ─── */
      const card = document.getElementById('authCard');
      if (card) card.classList.toggle('active', isReg);

      /* ─── MOBILE: JS-driven sweep + content swap ─── */
      const mobile = document.getElementById('authMobile');
      if (mobile && window.matchMedia('(max-width: 768px)').matches) {
        const oldForm  = document.getElementById(isReg ? 'mobFormSignin' : 'mobFormRegister');
        const newForm  = document.getElementById(isReg ? 'mobFormRegister' : 'mobFormSignin');
        const oldStrip = document.getElementById(isReg ? 'mobStripSignin' : 'mobStripRegister');
        const newStrip = document.getElementById(isReg ? 'mobStripRegister' : 'mobStripSignin');

        // 1. Start sweep curtain
        mobile.classList.add('mob-sweeping');

        // 2. Fade out old content immediately
        if (oldForm) {
          oldForm.style.transition = `opacity ${fadeMs}ms ease`;
          oldForm.style.opacity = '0';
        }
        if (oldStrip) {
          oldStrip.style.transition = `opacity ${fadeMs}ms ease`;
          oldStrip.style.opacity = '0';
        }

        // 3. At swap-delay: swap content
        setTimeout(() => {
          if (oldForm) {
            oldForm.style.display = 'none';
            oldForm.style.opacity = '';
            oldForm.style.transition = '';
          }
          if (oldStrip) {
            oldStrip.style.display = 'none';
            oldStrip.style.opacity = '';
            oldStrip.style.transition = '';
          }

          if (newForm) {
            newForm.style.display = 'flex';
            newForm.classList.add('mob-form-enter');
          }
          if (newStrip) {
            newStrip.style.display = 'flex';
            newStrip.classList.add('mob-strip-enter');
          }
          mobile.classList.toggle('mob-register', isReg);
        }, swapMs);

        // 4. After full sweep: clean up
        setTimeout(() => {
          if (newForm) newForm.classList.remove('mob-form-enter');
          if (newStrip) newStrip.classList.remove('mob-strip-enter');
          mobile.classList.remove('mob-sweeping');
          isAnimating = false;
        }, sweepMs + 50);
      } else {
        // Desktop: animation is CSS only, just unlock after sweep
        setTimeout(() => { isAnimating = false; }, cssMs('--sweep') + 50);
      }

      // URL hash (pushState for back/forward)
      history.pushState({ mode }, '', isReg ? '#register' : '#login');

      // Clear all fields on every toggle
      clearForms();
      setTimeout(initReadonly, 50);
    }

    /* ── Password toggle ── */
    function toggleEye(id, btn) {
      const inp = document.getElementById(id);
      if (!inp) return;
      const eo = btn.querySelector('.eo'), ec = btn.querySelector('.ec');
      if (inp.type === 'password') {
        inp.type = 'text';
        if (eo) eo.style.display = 'none';
        if (ec) ec.style.display = 'block';
      } else {
        inp.type = 'password';
        if (eo) eo.style.display = '';
        if (ec) ec.style.display = 'none';
      }
    }

    /* ── Demo credentials autofill ── */
    const DEMO_CREDENTIALS = {
      student: {
        email: 'student@arox.com',
        pass: 'student'
      },
      employee: {
        email: 'employee@arox.com',
        pass: 'employee'
      },
      admin: {
        email: 'admin@arox.com',
        pass: 'admin'
      }
    };

    function autofillDemo(role) {
      const creds = DEMO_CREDENTIALS[role];
      if (!creds) return;

      // Update role tab and state
      setPortalRole(role);

      // Desktop fields
      const dEmail = document.getElementById('dsi-email');
      const dPass = document.getElementById('dsi-pass');
      if (dEmail) {
        dEmail.removeAttribute('readonly');
        dEmail.value = creds.email;
        dEmail.dispatchEvent(new Event('input', { bubbles: true }));
      }
      if (dPass) {
        dPass.removeAttribute('readonly');
        dPass.value = creds.pass;
        dPass.dispatchEvent(new Event('input', { bubbles: true }));
      }

      // Mobile fields
      const mEmail = document.getElementById('msi-email');
      const mPass = document.getElementById('msi-pass');
      if (mEmail) {
        mEmail.removeAttribute('readonly');
        mEmail.value = creds.email;
        mEmail.dispatchEvent(new Event('input', { bubbles: true }));
      }
      if (mPass) {
        mPass.removeAttribute('readonly');
        mPass.value = creds.pass;
        mPass.dispatchEvent(new Event('input', { bubbles: true }));
      }

      // Highlight active demo button
      document.querySelectorAll('.demo-pill-btn').forEach(btn => {
        const isMatch = btn.getAttribute('data-demo-role') === role;
        btn.classList.toggle('active-demo', isMatch);
      });

      clearAuthAlerts();
    }

    /* ── Inline alerts helper ── */
    function showAuthAlert(form, message, type) {
      let alertEl = form.querySelector('.auth-inline-alert');
      if (!alertEl) {
        alertEl = document.createElement('div');
        alertEl.className = 'auth-inline-alert';
        const submitBtn = form.querySelector('.btn-submit');
        if (submitBtn) {
          form.insertBefore(alertEl, submitBtn);
        } else {
          form.appendChild(alertEl);
        }
      }
      const isErr = type === 'error';
      alertEl.style.cssText = [
        'padding: 10px 14px',
        'margin: 10px 0 12px',
        'border-radius: 9999px',
        'font-size: 12.5px',
        'font-weight: 600',
        'line-height: 1.4',
        'text-align: center',
        'background: ' + (isErr ? 'rgba(239, 68, 68, 0.12)' : 'rgba(16, 185, 129, 0.12)'),
        'color: ' + (isErr ? '#DC2626' : '#059669'),
        'border: 1px solid ' + (isErr ? 'rgba(239, 68, 68, 0.3)' : 'rgba(16, 185, 129, 0.3)'),
        'box-shadow: 0 2px 8px ' + (isErr ? 'rgba(239, 68, 68, 0.08)' : 'rgba(16, 185, 129, 0.08)')
      ].join(';');
      alertEl.textContent = message;
    }

    function clearAuthAlerts() {
      document.querySelectorAll('.auth-inline-alert').forEach(a => a.remove());
    }

    document.addEventListener('input', (e) => {
      if (e.target && e.target.classList.contains('pill-input')) {
        const form = e.target.closest('form');
        if (form) {
          const alertEl = form.querySelector('.auth-inline-alert');
          if (alertEl) alertEl.remove();
        }
      }
    });

    /* ── Form handlers ── */
    async function handleForgot(e) {
      e.preventDefault();
      const form = e.target.closest('form');
      const emailInput = form ? form.querySelector('input[type="email"]') : null;
      let email = emailInput ? emailInput.value.trim() : '';
      if (!email) {
        email = prompt('Enter your registered email address to reset password:');
      }
      if (!email || !email.trim()) return;

      try {
        const res = await fetch('/api/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email.trim().toLowerCase() })
        });
        const result = await res.json();
        alert(result.message || ('Password reset link sent to ' + email.trim() + '.'));
      } catch (err) {
        alert('Password reset instructions sent to ' + email.trim() + '.');
      }
    }

    async function handleSignIn(e) {
      e.preventDefault();
      const form = e.target;
      const emailInput = form.querySelector('input[type="email"]');
      const passInput = form.querySelector('input[type="password"], input[name*="pass"]');
      const submitBtn = form.querySelector('.btn-submit');
      const origText = submitBtn ? submitBtn.textContent : 'Login';

      const email = (emailInput ? emailInput.value : '').trim().toLowerCase();
      const password = passInput ? passInput.value : '';

      if (!email || !password) {
        showAuthAlert(form, 'Please enter your email and password.', 'error');
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Logging in…';
      }

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password, role: currentRole })
        });

        const result = await res.json();

        if (!res.ok || !result.success) {
          throw new Error(result.message || 'Invalid email or password.');
        }

        if (submitBtn) {
          submitBtn.textContent = 'SUCCESS ✓';
        }
        showAuthAlert(form, 'Authenticated! Redirecting to dashboard…', 'success');

        if (result.data && result.data.token) {
          localStorage.setItem('arox_token_' + currentRole, result.data.token);
          localStorage.setItem('arox_token', result.data.token);
          localStorage.setItem('arox_role', currentRole);
          if (result.data.user) {
            const u = result.data.user;
            const uName = [u.first_name, u.last_name].filter(Boolean).join(' ').trim() || (u.email ? u.email.split('@')[0] : 'AROX User');
            const roleLabels = { admin: 'Admin', super_admin: 'Admin', employee: 'Employee', trainer: 'Trainer', staff: 'Employee', student: 'Student' };
            localStorage.setItem('arox_user', JSON.stringify({
              id: u.id,
              email: u.email,
              name: uName,
              role: currentRole,
              displayRole: roleLabels[currentRole] || roleLabels[(u.role || '').toLowerCase()] || 'User',
              dashboardUrl: result.redirectUrl || (currentRole === 'admin' ? '/admin/dashboard' : (currentRole === 'employee' ? '/employee/dashboard' : '/student/dashboard'))
            }));
          }
        }

        const roleDashboards = {
          admin: '/admin/dashboard',
          employee: '/employee/dashboard',
          student: '/student/dashboard'
        };
        const targetUrl = result.redirectUrl || roleDashboards[currentRole] || '/student/dashboard';

        setTimeout(() => {
          window.location.href = targetUrl;
        }, 400);

      } catch (err) {
        showAuthAlert(form, err.message || 'Login failed. Check your credentials.', 'error');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = origText;
        }
      }
    }

    async function handleRegister(e) {
      e.preventDefault();
      const form = e.target;
      const nameInput = form.querySelector('input[name*="name"]');
      const emailInput = form.querySelector('input[type="email"]');
      const phoneInput = form.querySelector('input[type="tel"]');
      const passInput = form.querySelector('input[name*="pass"]');
      const submitBtn = form.querySelector('.btn-submit');
      const origText = submitBtn ? submitBtn.textContent : 'Register';

      const name = (nameInput ? nameInput.value : '').trim();
      const email = (emailInput ? emailInput.value : '').trim().toLowerCase();
      const phone = (phoneInput ? phoneInput.value : '').trim();
      const password = passInput ? passInput.value : '';

      if (!name || !email || !password) {
        showAuthAlert(form, 'Please fill in all mandatory fields.', 'error');
        return;
      }

      if (password.length < 6) {
        showAuthAlert(form, 'Password must be at least 6 characters long.', 'error');
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Creating account…';
      }

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, phone, password, role: currentRole })
        });

        const result = await res.json();

        if (!res.ok || !result.success) {
          throw new Error(result.message || 'Registration failed.');
        }

        if (submitBtn) {
          submitBtn.textContent = 'SUCCESS ✓';
        }
        showAuthAlert(form, 'Account created! Redirecting to dashboard…', 'success');

        if (result.data && result.data.token) {
          localStorage.setItem('arox_token_' + currentRole, result.data.token);
          localStorage.setItem('arox_token', result.data.token);
          localStorage.setItem('arox_role', currentRole);
          if (result.data.user) {
            const u = result.data.user;
            const uName = [u.first_name, u.last_name].filter(Boolean).join(' ').trim() || (u.email ? u.email.split('@')[0] : 'AROX User');
            const roleLabels = { admin: 'Admin', super_admin: 'Admin', employee: 'Employee', trainer: 'Trainer', staff: 'Employee', student: 'Student' };
            localStorage.setItem('arox_user', JSON.stringify({
              id: u.id,
              email: u.email,
              name: uName,
              role: currentRole,
              displayRole: roleLabels[currentRole] || roleLabels[(u.role || '').toLowerCase()] || 'User',
              dashboardUrl: result.redirectUrl || (currentRole === 'admin' ? '/admin/dashboard' : (currentRole === 'employee' ? '/employee/dashboard' : '/student/dashboard'))
            }));
          }
        }

        const roleDashboards = {
          admin: '/admin/dashboard',
          employee: '/employee/dashboard',
          student: '/student/dashboard'
        };
        const targetUrl = result.redirectUrl || roleDashboards[currentRole] || '/student/dashboard';

        setTimeout(() => {
          window.location.href = targetUrl;
        }, 400);

      } catch (err) {
        showAuthAlert(form, err.message || 'Registration failed.', 'error');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = origText;
        }
      }
    }

    /* ── INIT ── */
    document.addEventListener('DOMContentLoaded', () => {
      clearForms();
      initReadonly();

      // Set initial mode from URL hash (no animation)
      const hash = window.location.hash;
      if (hash === '#register' || hash === '#signup') {
        currentMode = 'register';
        // Desktop
        const card = document.getElementById('authCard');
        if (card) card.classList.add('active');
        // Mobile
        const authMob = document.getElementById('authMobile');
        if (authMob) authMob.classList.add('mob-register');
        const mSign = document.getElementById('mobFormSignin');
        const mReg = document.getElementById('mobFormRegister');
        const sSign = document.getElementById('mobStripSignin');
        const sReg = document.getElementById('mobStripRegister');
        if (mSign) mSign.style.display = 'none';
        if (mReg) mReg.style.display = 'flex';
        if (sSign) sSign.style.display = 'none';
        if (sReg) sReg.style.display = 'flex';
      }

      // Restore portal role
      try {
        const r = localStorage.getItem('arox_user_role');
        if (r && ['student','employee','admin'].includes(r)) setPortalRole(r);
      } catch(e){}

      // Extra clear after browsers autofill post-DOMContentLoaded
      setTimeout(clearForms, 100);
      setTimeout(clearForms, 500);
    });

    /* ── BROWSER BACK / FORWARD (BFCache reset) ── */
    window.addEventListener('pageshow', () => {
      document.querySelectorAll('.btn-submit').forEach(btn => {
        btn.disabled = false;
        if (btn.closest('#mobFormRegister') || btn.closest('.auth-form-l')) {
          btn.textContent = 'Register';
        } else {
          btn.textContent = 'Login';
        }
      });
      clearAuthAlerts();
    });

    /* ── BROWSER BACK / FORWARD ── */
    window.addEventListener('popstate', () => {
      const hash = window.location.hash;
      const target = (hash === '#register' || hash === '#signup') ? 'register' : 'signin';
      if (target !== currentMode) {
        isAnimating = false; // reset lock so popstate always works
        toggleAuth(target);
      }
    });

    /* ── RESIZE: re-sync mobile state if crossing breakpoint ── */
    window.addEventListener('resize', () => {
      const isMobile = window.matchMedia('(max-width: 768px)').matches;
      const isReg = currentMode === 'register';
      if (isMobile) {
        const authMob = document.getElementById('authMobile');
        if (authMob) authMob.classList.toggle('mob-register', isReg);
        const mSign = document.getElementById('mobFormSignin');
        const mReg = document.getElementById('mobFormRegister');
        const sSign = document.getElementById('mobStripSignin');
        const sReg = document.getElementById('mobStripRegister');
        if (mSign) mSign.style.display = isReg ? 'none' : 'flex';
        if (mReg) mReg.style.display = isReg ? 'flex' : 'none';
        if (sSign) sSign.style.display = isReg ? 'none' : 'flex';
        if (sReg) sReg.style.display = isReg ? 'flex' : 'none';
      }
    });
  </script>
</body>
</html>
