<div class="erp-h1" style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>
    <div style="font-size: 24px; font-weight: 750;">My Enrolled Programs</div>
    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 2px;">Track your curriculum syllabus, batch status, daily attendance, and credentials</div>
  </div>
  <div style="font-size: 13px; color: #64748B; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;">
    <i data-lucide="book-marked" style="width: 15px; height: 15px;"></i>
    <span>Curriculum & Credentials</span>
  </div>
</div>

<!-- Interactive Catalogue Filter Toolbar (Apple + Google Material 3) -->
<!-- Summary Metric Cards -->
<%
  const courseList = (typeof courses !== 'undefined' && courses) ? courses : ((typeof registrations !== 'undefined' && registrations) ? registrations : []);
  const totalCourses = courseList.length;
  const activeCourses = courseList.filter(r => {
    const s = (r.reg_status || r.status || '').toLowerCase();
    return s === 'confirmed' || s === 'active' || s === 'enrolled';
  }).length;
  const completedCourses = courseList.filter(r => (r.reg_status || r.status || '').toLowerCase() === 'completed').length;
  const credentialsReady = courseList.filter(r => r.offer_letter_generated || (r.reg_status || r.status || '').toLowerCase() === 'completed').length;
%>
<div class="erp-grid-4" style="margin-bottom: 24px;">
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="book-open"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Enrolled Programs</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= totalCourses %></div>
    <div class="erp-p" style="margin-top: 6px; color: #64748B; font-size: 12px;">Active & completed courses</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="play-circle"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Active Learning</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= activeCourses %></div>
    <div class="erp-p" style="margin-top: 6px; color: #16A34A; font-weight: 600; font-size: 12px;">Currently in session</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="award"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Completed Tracks</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= completedCourses %></div>
    <div class="erp-p" style="margin-top: 6px; color: #2563EB; font-weight: 600; font-size: 12px;">Curriculum cleared</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="file-check-2"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Credentials Ready</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= credentialsReady %></div>
    <div class="erp-p" style="margin-top: 6px; color: #000000; font-weight: 600; font-size: 12px;">Letters & Certificates</div>
  </div>
</div>
<div class="catalogue-toolbar" data-catalogue="st_courses">
  <div class="catalogue-filters-group">
    <!-- Search Input -->
    <div class="catalogue-search-wrap">
      <i data-lucide="search"></i>
      <input type="text" class="catalogue-search-input" placeholder="Search enrolled courses, batches...">
    </div>

    <!-- Category Filter -->
    <select class="catalogue-select" data-filter="category" title="Filter by Program Type">
      <option value="all">All Programs</option>
      <option value="internship">Internship Tracks</option>
      <option value="training">Training Courses</option>
    </select>

    <!-- Status Filter -->
    <select class="catalogue-select" data-filter="status" title="Filter by Status">
      <option value="all">All Statuses</option>
      <option value="active">Active</option>
      <option value="confirmed">Confirmed</option>
      <option value="completed">Completed</option>
      <option value="pending">Pending</option>
    </select>

    <!-- Sort Dropdown -->
    <select class="catalogue-select" data-filter="sort" title="Sort programs">
      <option value="newest">Newest First</option>
      <option value="name">Program Title (A - Z)</option>
    </select>

    <!-- Reset Button -->
    <button type="button" class="catalogue-reset-btn" title="Reset all filters">
      <i data-lucide="rotate-ccw" style="width: 13px; height: 13px;"></i>
      <span>Reset</span>
    </button>

    <!-- Result Counter -->
    <span class="catalogue-count-badge">Showing <%= courses ? courses.length : 0 %> programs</span>
  </div>

  <!-- Segmented View Switcher: List vs Kanban/Grid -->
  <div class="catalogue-view-switcher">
    <button type="button" class="view-btn active" data-view="list" title="Table List View">
      <i data-lucide="list"></i>
      <span>List</span>
    </button>
    <button type="button" class="view-btn" data-view="kanban" title="Kanban Card Grid View">
      <i data-lucide="layout-grid"></i>
      <span>Kanban</span>
    </button>
  </div>
</div>

<!-- 1. LIST VIEW (Data Table) -->
<div class="catalogue-list-view" data-catalogue="st_courses">
  <div class="erp-card" style="background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; overflow-x: auto; padding: 0;">
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
      <thead>
        <tr style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0; font-size: 11px; text-transform: uppercase; color: #64748B; font-weight: 700;">
          <th style="padding: 12px 16px;">Program Title</th>
          <th style="padding: 12px 16px;">Track</th>
          <th style="padding: 12px 16px;">Batch</th>
          <th style="padding: 12px 16px;">Duration</th>
          <th style="padding: 12px 16px;">Status</th>
          <th style="padding: 12px 16px; text-align: right;">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (courses && courses.length > 0) { %>
          <% courses.forEach(course => { 
            const cat = ((course.category || '').toLowerCase() === 'internship') ? 'internship' : 'training';
            const stat = (course.reg_status || 'enrolled').toLowerCase();
          %>
            <tr style="border-bottom: 1px solid #E2E8F0;"
                data-search="<%= (course.title + ' ' + (course.batch_name || '') + ' ' + (course.category || '') + ' ' + (course.description || '')).toLowerCase() %>"
                data-category="<%= cat %>"
                data-status="<%= stat %>"
                data-name="<%= course.title.toLowerCase() %>"
                data-newest="<%= course.id || course.registration_id %>">
              <td style="padding: 12px 16px;">
                <div style="font-weight: 700; color: #000; font-size: 14px;"><%= course.title %></div>
                <div style="font-size: 11.5px; color: #64748B; margin-top: 2px;"><%= course.short_description || course.description || 'Verified course track' %></div>
              </td>
              <td style="padding: 12px 16px;">
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; background: #F1F5F9; color: #000; padding: 2px 7px; border-radius: 4px;">
                  <%= course.category || 'Program' %>
                </span>
              </td>
              <td style="padding: 12px 16px; font-weight: 600; color: #000;">
                <%= course.batch_name || 'General' %>
              </td>
              <td style="padding: 12px 16px; color: #475569;">
                <%= course.duration || 'Flexible' %>
              </td>
              <td style="padding: 12px 16px;">
                <% if (course.reg_status === 'active' || course.reg_status === 'confirmed') { %>
                  <span style="font-size: 11px; font-weight: 700; padding: 2px 8px; background: #000; color: #fff; border-radius: 4px; text-transform: uppercase;">Active</span>
                <% } else { %>
                  <span style="font-size: 11px; font-weight: 600; padding: 2px 8px; background: #F1F5F9; color: #64748B; border-radius: 4px; text-transform: uppercase;"><%= course.reg_status || 'Enrolled' %></span>
                <% } %>
              </td>
              <td style="padding: 12px 16px; text-align: right;">
                <a href="/student/courses/<%= course.registration_id %>" class="erp-btn erp-btn-sm" style="padding: 6px 14px; background: #000; color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 12px; display: inline-flex; align-items: center; gap: 4px;">
                  <span>Dashboard</span>
                  <i data-lucide="arrow-right" style="width: 12px; height: 12px;"></i>
                </a>
              </td>
            </tr>
          <% }); %>
        <% } %>
        <tr class="empty-state-row" style="display: <%= (!courses || courses.length === 0) ? '' : 'none' %>;">
          <td colspan="6" style="padding: 32px; text-align: center; color: #64748B;">No enrolled programs matching current filters.</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<!-- 2. KANBAN / GRID VIEW (Material 3 Cards) -->
<div class="catalogue-kanban-view" data-catalogue="st_courses">
  <% if (courses && courses.length > 0) { %>
    <% courses.forEach(course => { 
      const cat = ((course.category || '').toLowerCase() === 'internship') ? 'internship' : 'training';
      const stat = (course.reg_status || 'enrolled').toLowerCase();
    %>
      <div class="kanban-item-card"
           data-search="<%= (course.title + ' ' + (course.batch_name || '') + ' ' + (course.category || '') + ' ' + (course.description || '')).toLowerCase() %>"
           data-category="<%= cat %>"
           data-status="<%= stat %>"
           data-name="<%= course.title.toLowerCase() %>"
           data-newest="<%= course.id || course.registration_id %>">
        <div class="kanban-card-top">
          <div>
            <span style="font-size: 10px; font-weight: 700; text-transform: uppercase; background: #F1F5F9; color: #000; padding: 2px 6px; border-radius: 4px; display: inline-block; margin-bottom: 4px;">
              <%= course.category || 'Program' %>
            </span>
            <div class="kanban-card-title"><%= course.title %></div>
            <div class="kanban-card-subtitle">Batch: <%= course.batch_name || 'General' %> &bull; <%= course.duration || 'Flexible' %></div>
          </div>
          <% if (course.reg_status === 'active' || course.reg_status === 'confirmed') { %>
            <span style="font-size: 10px; font-weight: 700; padding: 2px 7px; background: #000; color: #fff; border-radius: 4px; text-transform: uppercase;">Active</span>
          <% } else { %>
            <span style="font-size: 10px; font-weight: 600; padding: 2px 7px; background: #F1F5F9; color: #64748B; border-radius: 4px; text-transform: uppercase;"><%= course.reg_status || 'Enrolled' %></span>
          <% } %>
        </div>

        <div class="kanban-card-body">
          <p style="margin: 0; font-size: 12.5px; color: #475569; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
            <%= course.short_description || course.description || 'Access syllabus modules, daily attendance, and certificate validation.' %>
          </p>

          <div class="kanban-chip-row" style="margin-top: 10px;">
            <span class="kanban-chip">
              <i data-lucide="clock"></i> <%= course.duration || 'Flexible' %>
            </span>
            <span class="kanban-chip">
              <i data-lucide="calendar"></i> <%= new Date(course.enrolled_at || course.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %>
            </span>
          </div>
        </div>

        <div class="kanban-card-footer">
          <a href="/student/courses/<%= course.registration_id %>" class="erp-btn erp-btn-primary" style="width: 100%; padding: 8px 12px; font-size: 12px; font-weight: 600; background: #000; color: #fff; border-radius: 8px; text-align: center; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 6px;">
            <span>Open Program Dashboard</span>
            <i data-lucide="arrow-right" style="width: 13px; height: 13px;"></i>
          </a>
        </div>
      </div>
    <% }); %>
  <% } %>
  <div class="kanban-empty-state" style="display: <%= (!courses || courses.length === 0) ? 'block' : 'none' %>;">
    <i data-lucide="book-open" style="width: 36px; height: 36px; margin: 0 auto 10px; color: #94A3B8;"></i>
    <div style="font-weight: 700; font-size: 15px; color: #000;">No Enrolled Programs Found</div>
    <div style="font-size: 12px; color: #64748B; margin-top: 4px;">Explore our certified internships and training tracks to enroll.</div>
  </div>
</div>
