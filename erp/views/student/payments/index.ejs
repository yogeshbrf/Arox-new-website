<div class="erp-h1" style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>
    <div style="font-size: 24px; font-weight: 750;">Payments & Dues</div>
    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 2px;">Official AROX UPI and bank transfer verification, receipt access, and payment status history</div>
  </div>
  <div style="font-size: 13px; color: #64748B; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;">
    <i data-lucide="shield-check" style="width: 15px; height: 15px;"></i>
    <span>Official AROX UPI & Bank Gateway</span>
  </div>
</div>

<!-- Financial Summary Cards -->
<% 
  let grandTotal = 0;
  let grandPaid = 0;
  let grandPending = 0;
  if (registrations && registrations.length > 0) {
    registrations.forEach(r => {
      grandTotal += Number(r.total_amount || 0);
      grandPaid += Number(r.paid_amount || 0);
      grandPending += Number(r.balance_amount || 0);
    });
  }
%>
<div class="erp-grid-4" style="margin-bottom: 24px;">
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="book-open"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Total Fee Owed</div>
    </div>
    <% if (grandTotal <= 0) { %>
      <div class="erp-card-value" style="color: #D97706; font-size: 1.15rem; font-weight: 700;">Pending Setup</div>
      <div class="erp-p" style="margin-top: 6px; color: #92400E; font-size: 12px; font-weight: 600;">
        <i data-lucide="clock" style="width: 12px; height: 12px; display: inline-block; vertical-align: middle;"></i> Awaiting assignment
      </div>
    <% } else { %>
      <div class="erp-card-value" style="color: #000000;">₹<%= grandTotal.toLocaleString('en-IN') %></div>
      <div class="erp-p" style="margin-top: 6px; color: #64748B; font-size: 12px;">Enrolled programs</div>
    <% } %>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="check-circle-2"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Total Paid & Verified</div>
    </div>
    <div class="erp-card-value" style="color: #000000;">₹<%= grandPaid.toLocaleString('en-IN') %></div>
    <div class="erp-p" style="margin-top: 6px; color: #16A34A; font-weight: 600; font-size: 12px;">
      <i data-lucide="shield" style="width: 13px; height: 13px; display: inline-block; vertical-align: middle;"></i> Cleared Dues
    </div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="clock"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Outstanding Balance</div>
    </div>
    <div class="erp-card-value" style="color: #000000;">₹<%= grandPending.toLocaleString('en-IN') %></div>
    <div class="erp-p" style="margin-top: 6px; color: #64748B; font-size: 12px;">
      <%= grandPending > 0 ? 'Due for verification' : 'All dues settled' %>
    </div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="receipt"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Payment Records</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= payments ? payments.length : 0 %></div>
    <div class="erp-p" style="margin-top: 6px; color: #64748B; font-size: 12px;">Verified transactions</div>
  </div>
</div>

<!-- Main 2-Column Balanced Layout -->
<div style="display: grid; grid-template-columns: 1.35fr 1fr; gap: 24px; align-items: flex-start;" class="payments-grid-wrapper">
  
  <!-- Left: Transaction & Verification History with Catalogue System -->
  <div>
    <!-- Interactive Catalogue Filter Toolbar (Apple + Google Material 3) -->
    <div class="catalogue-toolbar" data-catalogue="st_payments" style="margin-bottom: 16px;">
      <div class="catalogue-filters-group">
        <!-- Search Input -->
        <div class="catalogue-search-wrap">
          <i data-lucide="search"></i>
          <input type="text" class="catalogue-search-input" placeholder="Search payment ID, course, method...">
        </div>

        <!-- Status Filter -->
        <select class="catalogue-select" data-filter="status" title="Filter by Status">
          <option value="all">All Statuses</option>
          <option value="verified">Verified</option>
          <option value="pending">Pending</option>
          <option value="rejected">Rejected</option>
        </select>

        <!-- Sort Dropdown -->
        <select class="catalogue-select" data-filter="sort" title="Sort records">
          <option value="newest">Newest First</option>
          <option value="amount_desc">Highest Amount</option>
          <option value="amount_asc">Lowest Amount</option>
        </select>

        <!-- Reset Button -->
        <button type="button" class="catalogue-reset-btn" title="Reset all filters">
          <i data-lucide="rotate-ccw" style="width: 13px; height: 13px;"></i>
          <span>Reset</span>
        </button>

        <!-- Result Counter -->
        <span class="catalogue-count-badge">Showing <%= payments ? payments.length : 0 %> payments</span>
      </div>

      <!-- Segmented View Switcher: List vs Kanban/Grid -->
      <div class="catalogue-view-switcher">
        <button type="button" class="view-btn active" data-view="list" title="Table List View">
          <i data-lucide="list"></i>
          <span>List</span>
        </button>
        <button type="button" class="view-btn" data-view="kanban" title="Kanban Card Grid View">
          <i data-lucide="layout-grid"></i>
          <span>Kanban</span>
        </button>
      </div>
    </div>

    <!-- 1. LIST VIEW (Data Table) -->
    <div class="catalogue-list-view" data-catalogue="st_payments">
      <div class="erp-card" style="background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; overflow-x: auto; padding: 0;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
          <thead>
            <tr style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0; font-size: 11px; text-transform: uppercase; color: #64748B; font-weight: 700;">
              <th style="padding: 12px 16px;">Date & Reference</th>
              <th style="padding: 12px 16px;">Course</th>
              <th style="padding: 12px 16px;">Method</th>
              <th style="padding: 12px 16px;">Amount</th>
              <th style="padding: 12px 16px;">Verified By</th>
              <th style="padding: 12px 16px; text-align: center;">Receipt</th>
              <th style="padding: 12px 16px; text-align: right;">Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (payments && payments.length > 0) { %>
              <% payments.forEach(payment => { 
                const rawStatus = (payment.status || 'pending').toLowerCase();
                const normStatus = (rawStatus === 'completed' || rawStatus === 'confirmed' || rawStatus === 'verified') ? 'verified' : (rawStatus === 'failed' || rawStatus === 'rejected') ? 'rejected' : 'pending';
                const amt = Number(payment.total_amount || payment.amount || 0);
              %>
                <tr style="border-bottom: 1px solid #E2E8F0;"
                    data-search="<%= ((payment.transaction_id || payment.payment_id || '') + ' ' + (payment.course_title || '') + ' ' + (payment.payment_method || '')).toLowerCase() %>"
                    data-status="<%= normStatus %>"
                    data-amount="<%= amt %>"
                    data-newest="<%= payment.id %>">
                  <td style="padding: 12px 16px;">
                    <div style="font-weight: 600; font-size: 13px; color: #000000;">
                      <%= new Date(payment.paid_at || payment.created_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                    </div>
                    <div style="font-family: monospace; font-size: 11px; color: #64748B;"><%= payment.transaction_id || payment.payment_id %></div>
                  </td>
                  <td style="padding: 12px 16px;">
                    <div style="font-weight: 600; font-size: 13px; color: #000000;"><%= payment.course_title %></div>
                  </td>
                  <td style="padding: 12px 16px;">
                    <span style="text-transform: uppercase; font-size: 11px; font-weight: 600; background: #F1F5F9; color: #000000; padding: 2px 7px; border-radius: 4px; border: 1px solid #E2E8F0;">
                      <%= payment.payment_method || 'UPI' %>
                    </span>
                  </td>
                  <td style="padding: 12px 16px; font-weight: 700; font-size: 13px; color: #000000;">
                    ₹<%= amt.toLocaleString('en-IN') %>
                  </td>
                  <td style="padding: 12px 16px;">
                    <% if (payment.verified_by_name) { %>
                      <span style="font-size: 12px; font-weight: 600; color: #16A34A; display: inline-flex; align-items: center; gap: 4px;">
                        <i data-lucide="shield-check" style="width: 13px; height: 13px;"></i> <%= payment.verified_by_name %>
                      </span>
                      <div style="font-size: 10px; color: #64748B;"><%= payment.verified_at ? new Date(payment.verified_at).toLocaleDateString('en-IN') : '' %></div>
                    <% } else { %>
                      <span style="color: #94A3B8; font-size: 12px;">Staff Review</span>
                    <% } %>
                  </td>
                  <td style="padding: 12px 16px; text-align: center;">
                    <% if (payment.receipt_path) { %>
                      <a href="<%= payment.receipt_path %>" target="_blank" class="erp-btn erp-btn-secondary" style="padding: 3px 8px; font-size: 11px; font-weight: 600; color: #000000; border: 1px solid #CBD5E1; text-decoration: none; border-radius: 4px;">
                        <i data-lucide="file-text" style="width: 12px; height: 12px;"></i> View
                      </a>
                    <% } else { %>
                      <span style="color: #94A3B8; font-size: 12px;">-</span>
                    <% } %>
                  </td>
                  <td style="padding: 12px 16px; text-align: right;">
                    <% if (normStatus === 'verified') { %>
                      <span style="display: inline-block; padding: 3px 8px; background: #000000; color: #FFFFFF; border-radius: 99px; font-size: 11px; font-weight: 600;">Verified</span>
                    <% } else if (normStatus === 'rejected') { %>
                      <span style="display: inline-block; padding: 3px 8px; background: #F1F5F9; color: #64748B; border: 1px solid #CBD5E1; border-radius: 99px; font-size: 11px; font-weight: 600;">Rejected</span>
                    <% } else { %>
                      <span style="display: inline-block; padding: 3px 8px; background: #F1F5F9; color: #000000; border: 1px solid #000000; border-radius: 99px; font-size: 11px; font-weight: 600;">Pending</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } %>
            <tr class="empty-state-row" style="display: <%= (!payments || payments.length === 0) ? '' : 'none' %>;">
              <td colspan="7" style="padding: 32px; text-align: center; color: #64748B;">No payment records matching current filters.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 2. KANBAN / GRID VIEW (Material 3 Cards) -->
    <div class="catalogue-kanban-view" data-catalogue="st_payments">
      <% if (payments && payments.length > 0) { %>
        <% payments.forEach(payment => { 
          const rawStatus = (payment.status || 'pending').toLowerCase();
          const normStatus = (rawStatus === 'completed' || rawStatus === 'confirmed' || rawStatus === 'verified') ? 'verified' : (rawStatus === 'failed' || rawStatus === 'rejected') ? 'rejected' : 'pending';
          const amt = Number(payment.total_amount || payment.amount || 0);
        %>
          <div class="kanban-item-card"
               data-search="<%= ((payment.transaction_id || payment.payment_id || '') + ' ' + (payment.course_title || '') + ' ' + (payment.payment_method || '')).toLowerCase() %>"
               data-status="<%= normStatus %>"
               data-amount="<%= amt %>"
               data-newest="<%= payment.id %>">
            <div class="kanban-card-top">
              <div>
                <span style="font-size: 10px; font-weight: 700; text-transform: uppercase; background: #F1F5F9; color: #000; padding: 2px 6px; border-radius: 4px; display: inline-block; margin-bottom: 4px;">
                  <%= payment.payment_method || 'UPI' %>
                </span>
                <div class="kanban-card-title"><%= payment.course_title %></div>
                <div class="kanban-card-subtitle" style="font-family: monospace;"><%= payment.transaction_id || payment.payment_id %></div>
              </div>
              <% if (normStatus === 'verified') { %>
                <span style="font-size: 10px; font-weight: 700; padding: 2px 7px; background: #000000; color: #FFFFFF; border-radius: 4px; text-transform: uppercase;">Verified</span>
              <% } else if (normStatus === 'rejected') { %>
                <span style="font-size: 10px; font-weight: 700; padding: 2px 7px; background: #F1F5F9; color: #64748B; border: 1px solid #CBD5E1; border-radius: 4px; text-transform: uppercase;">Rejected</span>
              <% } else { %>
                <span style="font-size: 10px; font-weight: 700; padding: 2px 7px; background: #F1F5F9; color: #000000; border: 1px solid #000; border-radius: 4px; text-transform: uppercase;">Pending</span>
              <% } %>
            </div>

            <div class="kanban-card-body">
              <div style="font-size: 18px; font-weight: 800; color: #000;">
                ₹<%= amt.toLocaleString('en-IN') %>
              </div>

              <div class="kanban-chip-row" style="margin-top: 8px;">
                <span class="kanban-chip">
                  <i data-lucide="calendar"></i> <%= new Date(payment.paid_at || payment.created_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) %>
                </span>
                <% if (payment.verified_by_name) { %>
                  <span class="kanban-chip" style="background: #DCFCE7; color: #15803D;">
                    <i data-lucide="shield-check"></i> <%= payment.verified_by_name %>
                  </span>
                <% } else { %>
                  <span class="kanban-chip">
                    <i data-lucide="clock"></i> Under Verification
                  </span>
                <% } %>
              </div>
            </div>

            <div class="kanban-card-footer">
              <span style="font-size: 11px; color: #64748B;">
                <%= payment.receipt_path ? 'Receipt on file' : 'No receipt' %>
              </span>
              <% if (payment.receipt_path) { %>
                <a href="<%= payment.receipt_path %>" target="_blank" class="erp-btn erp-btn-secondary" style="padding: 4px 10px; font-size: 11px; font-weight: 600; color: #000; border: 1px solid #CBD5E1; text-decoration: none; border-radius: 6px;">
                  <i data-lucide="file-text" style="width: 12px; height: 12px;"></i> View Receipt
                </a>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } %>
      <div class="kanban-empty-state" style="display: <%= (!payments || payments.length === 0) ? 'block' : 'none' %>;">
        <i data-lucide="receipt" style="width: 36px; height: 36px; margin: 0 auto 10px; color: #94A3B8;"></i>
        <div style="font-weight: 700; font-size: 15px; color: #000;">No Payment Records</div>
        <div style="font-size: 12px; color: #64748B; margin-top: 4px;">Submit a payment proof after scanning the QR code on the right.</div>
      </div>
    </div>
  </div>

  <!-- Right: Scan & Pay UPI & Submit Proof Form -->
  <div style="display: flex; flex-direction: column; gap: 20px;">

    <% if (grandTotal <= 0) { %>
      <!-- Pending Fee Setup Notice -->
      <div class="erp-card" style="background: #FFFBEB; border: 1px solid #FCD34D; padding: 20px 22px; border-radius: 14px; text-align: center;">
        <div style="width: 44px; height: 44px; border-radius: 50%; background: #FEF3C7; color: #D97706; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px;">
          <i data-lucide="help-circle" style="width: 24px; height: 24px;"></i>
        </div>
        <h3 style="margin: 0 0 6px 0; font-size: 16px; font-weight: 700; color: #92400E;">Fee Structure Under Assignment</h3>
        <p style="margin: 0; font-size: 12.5px; color: #B45309; line-height: 1.55;">
          Once your exact fee is assigned by an Admin, you can submit your payment proof below or pay immediately using the official UPI QR below.
        </p>
      </div>
    <% } %>

    <!-- QR & UPI Payment Card (Always visible so UPI QR & ID are accessible anywhere) -->
    <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 24px; border-radius: 14px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 class="erp-h3" style="margin: 0; color: #000000; font-size: 16px;">Scan & Pay via UPI</h3>
        <span style="font-size: 11px; font-weight: 600; padding: 3px 8px; background: #000000; color: #FFFFFF; border-radius: 99px;">Official QR</span>
      </div>

      <!-- QR Code Display -->
      <% const stuPayUpi = (typeof paymentConfig !== 'undefined' && paymentConfig && paymentConfig.upi_id) ? paymentConfig.upi_id : '6379000598@amazonpay'; %>
      <div style="background: #F8FAFC; border: 1px dashed #CBD5E1; border-radius: 12px; padding: 16px; text-align: center; margin-bottom: 16px;">
        <img src="/api/payments/qr?note=<%= encodeURIComponent('AROX Tech Fee Payment') %>" alt="AROX UPI QR Code" style="width: 155px; height: 155px; margin: 0 auto; display: block; border-radius: 8px; border: 1px solid #E2E8F0; background: #FFFFFF; padding: 4px;">
        <div style="font-weight: 700; font-size: 13px; color: #000000; margin-top: 10px;"><%= (typeof paymentConfig !== 'undefined' && paymentConfig && paymentConfig.upi_name) ? paymentConfig.upi_name : 'AROX Tech Pvt. Ltd.' %></div>
        <div style="font-size: 11px; color: #64748B; margin-top: 2px;">Scan with GPay, PhonePe, Paytm, Amazon Pay, BHIM</div>
        <a href="upi://pay?pa=<%= encodeURIComponent(stuPayUpi) %>&pn=<%= encodeURIComponent('AROX Tech') %>&cu=INR" class="erp-btn erp-btn-sm erp-btn-primary" style="margin-top: 10px; display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
          <i data-lucide="smartphone" style="width: 13px; height: 13px;"></i> Pay via UPI App
        </a>
      </div>

      <!-- UPI ID Copy Box -->
      <div style="padding: 10px 14px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
        <div>
          <div style="font-size: 10px; text-transform: uppercase; font-weight: 700; color: #64748B;">UPI ID</div>
          <div style="font-family: monospace; font-weight: 700; font-size: 13px; color: #000000;"><%= stuPayUpi %></div>
        </div>
        <button type="button" onclick="copyUpiText('<%= stuPayUpi %>', this)" class="erp-btn erp-btn-secondary" style="padding: 4px 10px; font-size: 12px; font-weight: 600; color: #000000; border: 1px solid #CBD5E1; cursor: pointer;">
          <i data-lucide="copy" style="width: 12px; height: 12px;"></i> Copy
        </button>
      </div>

      <!-- Bank Transfer Details -->
      <div style="padding: 12px 14px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; font-size: 12px;">
        <div style="font-size: 10px; text-transform: uppercase; font-weight: 700; color: #64748B; margin-bottom: 6px;">Bank Transfer (NEFT / IMPS)</div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
          <span style="color: #64748B;">Account:</span>
          <span style="font-family: monospace; font-weight: 600; color: #000000;">000905034821</span>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
          <span style="color: #64748B;">IFSC Code:</span>
          <span style="font-family: monospace; font-weight: 600; color: #000000;">ICIC0000009</span>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span style="color: #64748B;">Bank & Branch:</span>
          <span style="font-weight: 600; color: #000000;">ICICI Bank, Chennai Main</span>
        </div>
      </div>
    </div>

    <!-- Submit Payment Proof Form Card -->
    <% if (registrations && registrations.length > 0) { %>
      <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 24px; border-radius: 14px;">
        <h3 class="erp-h3" style="margin: 0 0 4px 0; color: #000000; display: flex; align-items: center; gap: 8px; font-size: 16px;">
          <i data-lucide="file-up" style="width: 18px; height: 18px; color: #000000;"></i>
          Submit Payment Screenshot
        </h3>
        <p style="margin: 0 0 16px 0; font-size: 12px; color: #64748B;">Upload your transaction screenshot with 12-digit UTR reference for admin verification.</p>

        <form id="globalProofForm" onsubmit="submitGlobalProof(event)" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 14px;">
          <div>
            <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">Select Program</label>
            <select name="registration_id" required class="erp-input" style="font-size: 13px; width: 100%; height: 38px; border: 1px solid #CBD5E1; border-radius: 6px; padding: 0 10px; background: #fff;">
              <% registrations.forEach(reg => { %>
                <option value="<%= reg.id %>"><%= reg.course_title %> (Due: ₹<%= reg.balance_amount %>)</option>
              <% }); %>
            </select>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div>
              <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">Amount Paid (₹)</label>
              <input type="number" name="amount" required min="1" placeholder="Amount" class="erp-input" style="font-size: 13px; font-weight: 700; width: 100%; height: 38px; border: 1px solid #CBD5E1; border-radius: 6px; padding: 0 10px;">
            </div>
            <div>
              <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">Payment Method</label>
              <select name="payment_method" required class="erp-input" style="font-size: 13px; width: 100%; height: 38px; border: 1px solid #CBD5E1; border-radius: 6px; padding: 0 10px; background: #fff;">
                <option value="upi">UPI (GPay / PhonePe / Paytm)</option>
                <option value="netbanking">Net Banking (IMPS / NEFT)</option>
                <option value="cash">Direct Deposit</option>
                <option value="card">Card</option>
              </select>
            </div>
          </div>

          <div>
            <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">12-Digit UTR / Transaction Reference *</label>
            <input type="text" name="transaction_id" required placeholder="e.g. 412345678901" class="erp-input" style="font-size: 13px; font-family: monospace; width: 100%; height: 38px; border: 1px solid #CBD5E1; border-radius: 6px; padding: 0 10px;">
          </div>

          <div>
            <label style="display: block; font-size: 12px; font-weight: 600; color: #000000; margin-bottom: 4px;">Attach Screenshot (PNG, JPG, PDF) *</label>
            <input type="file" name="receipt" required accept="image/*, application/pdf" class="erp-input" style="font-size: 12px; padding: 6px 10px; width: 100%; border: 1px solid #CBD5E1; border-radius: 6px; background: #fff;">
          </div>

          <button type="submit" id="btnSubmitGlobalProof" class="erp-btn erp-btn-primary" style="width: 100%; padding: 10px; font-size: 13px; font-weight: 600; background: #000000; color: #FFFFFF; border-radius: 8px; margin-top: 4px; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px;">
            <i data-lucide="send" style="width: 14px; height: 14px;"></i>
            <span>Upload for Admin Verification</span>
          </button>
        </form>
      </div>
    <% } %>
  </div>

</div>

<style>
  @media (max-width: 900px) {
    .payments-grid-wrapper {
      grid-template-columns: 1fr !important;
    }
  }
  @media (max-width: 768px) {
    .erp-grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 10px !important; }
    .erp-grid-3 { grid-template-columns: 1fr !important; gap: 12px !important; }
    .erp-h1 { font-size: 20px !important; margin-bottom: 16px !important; }
    .erp-grid-4 .erp-card { padding: 12px 10px !important; }
    .erp-grid-3 .erp-card { padding: 16px !important; }
  }
</style>

<script>
  function copyUpiText(text, btn) {
    navigator.clipboard.writeText(text);
    const orig = btn.innerHTML;
    btn.innerHTML = '<i data-lucide="check" style="width: 12px; height: 12px;"></i> Copied!';
    if (window.lucide) lucide.createIcons();
    setTimeout(() => {
      btn.innerHTML = orig;
      if (window.lucide) lucide.createIcons();
    }, 2000);
  }

  async function submitGlobalProof(e) {
    e.preventDefault();
    const form = document.getElementById('globalProofForm');
    const btn = document.getElementById('btnSubmitGlobalProof');
    const origText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = 'Submitting Proof...';

    try {
      const formData = new FormData(form);
      const res = await fetch('/api/payments/submit-proof', {
        method: 'POST',
        body: formData
      });
      const data = await res.json();
      if (res.ok && data.success) {
        alert("Payment screenshot submitted successfully! ✅\n\nOur Admin team will review and verify your payment shortly.");
        window.location.reload();
      } else {
        alert(data.message || "Failed to submit payment proof.");
        btn.disabled = false;
        btn.innerHTML = origText;
      }
    } catch (err) {
      console.error(err);
      alert("Network error submitting payment proof.");
      btn.disabled = false;
      btn.innerHTML = origText;
    }
  }
</script>
