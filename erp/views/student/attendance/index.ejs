<div class="erp-h1" style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #000000;">
  <div>
    <div style="font-size: 24px; font-weight: 750;">Attendance & Course Schedule</div>
    <div style="font-size: 13px; color: #64748B; font-weight: 500; margin-top: 2px;">Server-validated real-time attendance logging, interactive schedule calendar, and verification metrics</div>
  </div>
  <div style="font-size: 13px; color: #64748B; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;">
    <i data-lucide="shield-check" style="width: 15px; height: 15px;"></i>
    <span>Server-Validated Attendance</span>
  </div>
</div>

<!-- Server Date & Time Banner -->
<div class="erp-card" style="background: #000000; color: #FFFFFF; border-radius: 12px; padding: 18px 24px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
  <div>
    <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: #94A3B8; font-weight: 700;">Official Server Date</div>
    <div style="font-size: 20px; font-weight: 800; margin-top: 2px;">
      <%= new Date(serverToday + 'T00:00:00').toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
    </div>
  </div>
  <div style="font-size: 12px; color: #CBD5E1; text-align: right;">
    <span>Attendance can strictly be logged for the current server date within your program duration.</span>
  </div>
</div>

<!-- Interactive Catalogue Filter Toolbar (Apple + Google Material 3) -->
<!-- Summary Metric Cards -->
<%
  const enrolledCoursesCount = courses ? courses.length : 0;
  const overallPct = courses && courses.length > 0 ? Math.round(courses.reduce((acc, c) => acc + (c.percentage || 0), 0) / courses.length) : 0;
  const totalDaysPresent = courses ? courses.reduce((acc, c) => acc + (c.presentDays || 0), 0) : 0;
  const markedTodayStatus = courses && courses.some(c => c.isMarkedToday) ? 'Completed' : 'Pending';
%>
<div class="erp-grid-4" style="margin-bottom: 24px;">
  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="book-open"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Enrolled Courses</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= enrolledCoursesCount %></div>
    <div class="erp-p" style="margin-top: 6px; color: #64748B; font-size: 12px;">Active course batches</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="percent"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Overall Attendance</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= overallPct %>%</div>
    <div class="erp-p" style="margin-top: 6px; color: <%= overallPct >= 75 ? '#16A34A' : '#DC2626' %>; font-weight: 600; font-size: 12px;"><%= overallPct >= 75 ? 'Meets 75% threshold' : 'Below 75% required' %></div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="calendar-check"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Total Sessions Present</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= totalDaysPresent %> <span style="font-size: 13px; font-weight: 500; color: #64748B;">Days</span></div>
    <div class="erp-p" style="margin-top: 6px; color: #2563EB; font-weight: 600; font-size: 12px;">Logged & verified</div>
  </div>

  <div class="erp-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; padding: 20px;">
    <div class="erp-card-header">
      <div class="erp-card-icon" style="background: #000000; color: #FFFFFF;">
        <i data-lucide="clock"></i>
      </div>
      <div class="erp-card-title" style="color: #64748B;">Today's Session</div>
    </div>
    <div class="erp-card-value" style="color: #000000;"><%= markedTodayStatus %></div>
    <div class="erp-p" style="margin-top: 6px; color: <%= markedTodayStatus === 'Completed' ? '#16A34A' : '#D97706' %>; font-weight: 600; font-size: 12px;"><%= markedTodayStatus === 'Completed' ? 'Logged for today' : 'Log your session today' %></div>
  </div>
</div>
<div class="catalogue-toolbar" data-catalogue="st_attendance">
  <div class="catalogue-filters-group">
    <!-- Search Input -->
    <div class="catalogue-search-wrap">
      <i data-lucide="search"></i>
      <input type="text" class="catalogue-search-input" placeholder="Search program, batch, mode...">
    </div>

    <!-- Mode Filter -->
    <select class="catalogue-select" data-filter="category" title="Filter by Mode">
      <option value="all">All Modes</option>
      <option value="online">Online</option>
      <option value="offline">Offline</option>
      <option value="hybrid">Hybrid</option>
    </select>

    <!-- Today Status Filter -->
    <select class="catalogue-select" data-filter="status" title="Filter by Today's Status">
      <option value="all">All Statuses</option>
      <option value="marked">Marked Today</option>
      <option value="unmarked">Unmarked Today</option>
    </select>

    <!-- Sort Dropdown -->
    <select class="catalogue-select" data-filter="sort" title="Sort programs">
      <option value="newest">Newest First</option>
      <option value="attendance_desc">Highest Attendance %</option>
      <option value="attendance_asc">Lowest Attendance %</option>
      <option value="name">Program Title (A - Z)</option>
    </select>

    <!-- Reset Button -->
    <button type="button" class="catalogue-reset-btn" title="Reset all filters">
      <i data-lucide="rotate-ccw" style="width: 13px; height: 13px;"></i>
      <span>Reset</span>
    </button>

    <!-- Result Counter -->
    <span class="catalogue-count-badge">Showing <%= courses ? courses.length : 0 %> courses</span>
  </div>

  <!-- Segmented View Switcher: List vs Kanban/Grid -->
  <div class="catalogue-view-switcher">
    <button type="button" class="view-btn active" data-view="list" title="Table List View">
      <i data-lucide="list"></i>
      <span>List</span>
    </button>
    <button type="button" class="view-btn" data-view="kanban" title="Kanban Card Grid View">
      <i data-lucide="layout-grid"></i>
      <span>Kanban</span>
    </button>
  </div>
</div>

<!-- 1. LIST VIEW (Data Table) -->
<div class="catalogue-list-view" data-catalogue="st_attendance">
  <div class="erp-card" style="background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; overflow-x: auto; padding: 0;">
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
      <thead>
        <tr style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0; font-size: 11px; text-transform: uppercase; color: #64748B; font-weight: 700;">
          <th style="padding: 12px 16px;">Course Title</th>
          <th style="padding: 12px 16px;">Batch & Mode</th>
          <th style="padding: 12px 16px;">Duration & Range</th>
          <th style="padding: 12px 16px;">Attendance Rate</th>
          <th style="padding: 12px 16px;">Today's Status</th>
          <th style="padding: 12px 16px; text-align: right;">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (courses && courses.length > 0) { %>
          <% courses.forEach((c, idx) => { 
            const todayStat = c.isMarkedToday ? 'marked' : 'unmarked';
          %>
            <tr style="border-bottom: 1px solid #E2E8F0;"
                data-search="<%= (c.course_title + ' ' + (c.batch_name || '') + ' ' + (c.course_mode || '')).toLowerCase() %>"
                data-category="<%= (c.course_mode || 'online').toLowerCase() %>"
                data-status="<%= todayStat %>"
                data-attendance="<%= c.percentage %>"
                data-name="<%= c.course_title.toLowerCase() %>"
                data-newest="<%= idx %>">
              <td style="padding: 12px 16px;">
                <div style="font-weight: 750; color: #000; font-size: 14px;"><%= c.course_title %></div>
              </td>
              <td style="padding: 12px 16px;">
                <div style="font-weight: 600; color: #000;"><%= c.batch_name || 'Cohort Batch' %></div>
                <span style="font-size: 10px; font-weight: 700; text-transform: uppercase; background: #000; color: #fff; padding: 2px 6px; border-radius: 4px; display: inline-block; margin-top: 2px;">
                  <%= c.course_mode || 'Online' %>
                </span>
              </td>
              <td style="padding: 12px 16px; font-size: 12px; color: #475569;">
                <div><strong><%= c.course_duration || 'Flexible' %></strong></div>
                <div style="color: #64748B; font-size: 11px;">
                  <%= c.start_date ? new Date(c.start_date + 'T00:00:00').toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) : 'TBD' %> &rarr;
                  <%= c.end_date ? new Date(c.end_date + 'T00:00:00').toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'TBD' %>
                </div>
              </td>
              <td style="padding: 12px 16px;">
                <div style="font-size: 16px; font-weight: 800; color: <%= c.percentage >= 75 ? '#16A34A' : '#D97706' %>;">
                  <%= c.percentage %>%
                </div>
                <div style="font-size: 10.5px; color: #64748B;"><%= c.presentCount %> / <%= c.totalRecorded %> sessions</div>
              </td>
              <td style="padding: 12px 16px;">
                <% if (c.isMarkedToday) { %>
                  <span style="font-size: 11px; font-weight: 700; color: #16A34A; display: inline-flex; align-items: center; gap: 4px;">
                    <i data-lucide="check-circle-2" style="width: 13px; height: 13px;"></i> Present
                  </span>
                <% } else if (c.canMarkToday) { %>
                  <span style="font-size: 11px; font-weight: 700; color: #D97706; display: inline-flex; align-items: center; gap: 4px;">
                    <i data-lucide="clock" style="width: 13px; height: 13px;"></i> Unmarked Today
                  </span>
                <% } else { %>
                  <span style="font-size: 11px; font-weight: 500; color: #94A3B8;">
                    <%= c.dateRestrictionReason %>
                  </span>
                <% } %>
              </td>
              <td style="padding: 12px 16px; text-align: right;">
                <button type="button" onclick="openCalendarModal(<%= idx %>)" class="erp-btn erp-btn-secondary" style="padding: 6px 14px; font-size: 12px; font-weight: 600; color: #000; border: 1px solid #CBD5E1; border-radius: 6px; cursor: pointer;">
                  Calendar & Mark &rarr;
                </button>
              </td>
            </tr>
          <% }); %>
        <% } %>
        <tr class="empty-state-row" style="display: <%= (!courses || courses.length === 0) ? '' : 'none' %>;">
          <td colspan="6" style="padding: 32px; text-align: center; color: #64748B;">No courses matching current filters.</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<!-- 2. KANBAN / GRID VIEW (Material 3 Cards) -->
<div class="catalogue-kanban-view" data-catalogue="st_attendance">
  <% if (courses && courses.length > 0) { %>
    <% courses.forEach((c, idx) => { 
      const todayStat = c.isMarkedToday ? 'marked' : 'unmarked';
    %>
      <div class="kanban-item-card"
           data-search="<%= (c.course_title + ' ' + (c.batch_name || '') + ' ' + (c.course_mode || '')).toLowerCase() %>"
           data-category="<%= (c.course_mode || 'online').toLowerCase() %>"
           data-status="<%= todayStat %>"
           data-attendance="<%= c.percentage %>"
           data-name="<%= c.course_title.toLowerCase() %>"
           data-newest="<%= idx %>"
           onclick="openCalendarModal(<%= idx %>)" style="cursor: pointer;">
        <div class="kanban-card-top">
          <div>
            <span style="font-size: 10px; font-weight: 700; text-transform: uppercase; background: #000; color: #fff; padding: 2px 7px; border-radius: 4px; display: inline-block; margin-bottom: 4px;">
              <%= c.course_mode || 'Online' %>
            </span>
            <div class="kanban-card-title"><%= c.course_title %></div>
            <div class="kanban-card-subtitle"><%= c.batch_name || 'Cohort Batch' %></div>
          </div>
          <div style="text-align: right;">
            <div style="font-size: 18px; font-weight: 800; color: <%= c.percentage >= 75 ? '#16A34A' : '#D97706' %>;">
              <%= c.percentage %>%
            </div>
            <div style="font-size: 10px; color: #64748B;">Attendance Rate</div>
          </div>
        </div>

        <div class="kanban-card-body">
          <div style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; padding: 10px 12px; font-size: 12px;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
              <span style="color: #64748B;">Duration:</span>
              <span style="font-weight: 700; color: #000;"><%= c.course_duration || 'Flexible' %></span>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="color: #64748B;">Dates:</span>
              <span style="font-weight: 600; color: #000;">
                <%= c.start_date ? new Date(c.start_date + 'T00:00:00').toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) : 'TBD' %> - <%= c.end_date ? new Date(c.end_date + 'T00:00:00').toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) : 'TBD' %>
              </span>
            </div>
          </div>

          <div class="kanban-chip-row" style="margin-top: 10px;">
            <span class="kanban-chip">
              Attended: <%= c.presentCount %> / <%= c.totalRecorded %>
            </span>
          </div>
        </div>

        <div class="kanban-card-footer">
          <div>
            <% if (c.isMarkedToday) { %>
              <span style="font-size: 11px; font-weight: 700; color: #16A34A; display: inline-flex; align-items: center; gap: 4px;">
                <i data-lucide="check-circle-2" style="width: 13px; height: 13px;"></i> Present Today
              </span>
            <% } else if (c.canMarkToday) { %>
              <span style="font-size: 11px; font-weight: 700; color: #D97706; display: inline-flex; align-items: center; gap: 4px;">
                <i data-lucide="clock" style="width: 13px; height: 13px;"></i> Unmarked Today
              </span>
            <% } else { %>
              <span style="font-size: 11px; font-weight: 500; color: #94A3B8;">
                <%= c.dateRestrictionReason %>
              </span>
            <% } %>
          </div>
          <button type="button" class="erp-btn erp-btn-secondary" style="padding: 6px 12px; font-size: 11.5px; font-weight: 600; color: #000; border: 1px solid #CBD5E1; border-radius: 6px; cursor: pointer;">
            Calendar &rarr;
          </button>
        </div>
      </div>
    <% }); %>
  <% } %>
  <div class="kanban-empty-state" style="display: <%= (!courses || courses.length === 0) ? 'block' : 'none' %>;">
    <i data-lucide="calendar-x-2" style="width: 36px; height: 36px; margin: 0 auto 10px; color: #94A3B8;"></i>
    <div style="font-weight: 700; font-size: 15px; color: #000;">No Enrolled Programs Found</div>
    <div style="font-size: 12px; color: #64748B; margin-top: 4px;">Your course cards and attendance tracking will appear once enrolled.</div>
  </div>
</div>

<!-- Interactive Calendar Modal -->
<div id="calendarModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.65); z-index: 9999; align-items: center; justify-content: center; padding: 16px;">
  <div style="background: #FFFFFF; border-radius: 14px; max-width: 680px; width: 100%; max-height: 90vh; overflow-y: auto; padding: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.15);">
    <!-- Modal Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid #E2E8F0; padding-bottom: 14px; margin-bottom: 16px;">
      <div>
        <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: #000;" id="modalCourseTitle">Course Schedule</h3>
        <div style="font-size: 12px; color: #64748B; margin-top: 2px;" id="modalCourseRange">Program Range</div>
      </div>
      <button type="button" onclick="closeCalendarModal()" style="border: none; background: transparent; font-size: 24px; cursor: pointer; color: #64748B; line-height: 1;">&times;</button>
    </div>

    <!-- Today Action Banner (Supports Marking & Updating Today's Daily Attendance) -->
    <div id="modalTodayBanner" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px; padding: 14px; margin-bottom: 16px; display: flex; flex-direction: column; gap: 12px;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <div>
          <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #64748B;">Today's Daily Attendance (<%= serverToday %>)</div>
          <div style="font-size: 14px; font-weight: 750; color: #000;" id="modalTodayStatusText">Checking status...</div>
        </div>
        <div id="modalTodayBadge"></div>
      </div>
      <div id="modalTodayActionContainer" style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center;">
        <!-- Mark / Update Attendance Controls rendered dynamically -->
      </div>
    </div>

    <!-- Month Navigation -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
      <button type="button" onclick="changeMonth(-1)" class="erp-btn erp-btn-secondary" style="padding: 4px 10px; font-size: 12px; border: 1px solid #CBD5E1; color: #000; cursor: pointer;">&larr; Prev</button>
      <div style="font-size: 15px; font-weight: 800; color: #000;" id="calendarMonthYear">Month Year</div>
      <button type="button" onclick="changeMonth(1)" class="erp-btn erp-btn-secondary" style="padding: 4px 10px; font-size: 12px; border: 1px solid #CBD5E1; color: #000; cursor: pointer;">Next &rarr;</button>
    </div>

    <!-- Calendar Legend -->
    <div style="display: flex; gap: 16px; font-size: 11px; font-weight: 600; margin-bottom: 12px; flex-wrap: wrap;">
      <div style="display: flex; align-items: center; gap: 6px;">
        <span style="width: 12px; height: 12px; background: #DCFCE7; border: 1px solid #86EFAC; border-radius: 3px; display: inline-block;"></span> Present
      </div>
      <div style="display: flex; align-items: center; gap: 6px;">
        <span style="width: 12px; height: 12px; background: #EFF6FF; border: 1px solid #93C5FD; border-radius: 3px; display: inline-block;"></span> Active Range
      </div>
      <div style="display: flex; align-items: center; gap: 6px;">
        <span style="width: 12px; height: 12px; background: #000000; border-radius: 3px; display: inline-block;"></span> Today
      </div>
      <div style="display: flex; align-items: center; gap: 6px;">
        <span style="width: 12px; height: 12px; background: #F1F5F9; border-radius: 3px; display: inline-block;"></span> Outside Range
      </div>
    </div>

    <!-- Day Headers -->
    <div style="display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; font-size: 11px; font-weight: 800; color: #64748B; margin-bottom: 6px;">
      <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
    </div>

    <!-- Calendar Days Grid -->
    <div id="calendarDaysGrid" style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px;">
      <!-- Populated via JS -->
    </div>
  </div>
</div>

<script>
  const coursesData = <%- JSON.stringify(courses || []) %>;
  const SERVER_TODAY = "<%= serverToday %>";
  let activeCourse = null;
  let currentCalDate = new Date();

  function openCalendarModal(index) {
    activeCourse = coursesData[index];
    if (!activeCourse) return;

    document.getElementById('modalCourseTitle').textContent = `${activeCourse.course_title} (${activeCourse.course_duration || 'Duration'})`;
    const startStr = activeCourse.start_date || 'TBD';
    const endStr = activeCourse.end_date || 'TBD';
    document.getElementById('modalCourseRange').textContent = `Cohort Schedule: ${startStr} to ${endStr}`;

    updateTodayBanner();

    if (activeCourse.start_date) {
      const parts = activeCourse.start_date.split('-');
      currentCalDate = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, 1);
    } else {
      currentCalDate = new Date();
    }

    renderCalendarGrid();
    document.getElementById('calendarModal').style.display = 'flex';
  }

  function closeCalendarModal() {
    document.getElementById('calendarModal').style.display = 'none';
  }

  function updateTodayBanner() {
    const bannerText = document.getElementById('modalTodayStatusText');
    const badgeEl = document.getElementById('modalTodayBadge');
    const container = document.getElementById('modalTodayActionContainer');

    const curRec = activeCourse.todayRecord || null;
    const curStatus = curRec ? (curRec.status || 'present') : 'present';
    const curMethod = curRec ? (curRec.method || (activeCourse.course_mode === 'offline' ? 'offline' : 'online')) : (activeCourse.course_mode === 'offline' ? 'offline' : 'online');
    const curRemarks = curRec && curRec.remarks ? curRec.remarks : '';

    if (activeCourse.isMarkedToday) {
      const statusColors = { present: '#16A34A', late: '#D97706', leave: '#2563EB', absent: '#DC2626', holiday: '#7C3AED' };
      const cColor = statusColors[curStatus] || '#16A34A';
      bannerText.innerHTML = `<span style="color: ${cColor};">● ${curStatus.toUpperCase()} — ${(curRec && curRec.check_in_time) ? 'Checked in at ' + curRec.check_in_time : 'Recorded for today'}</span>`;
      if (badgeEl) {
        badgeEl.innerHTML = `<span style="font-size: 11px; font-weight: 700; color: ${cColor}; background: #EFF6FF; padding: 4px 10px; border-radius: 99px;">Marked (${curStatus.toUpperCase()})</span>`;
      }
      container.innerHTML = `
        <select id="stuTodayStatus" class="erp-input" style="padding: 6px 10px; font-size: 12px; font-weight: 700; width: auto;">
          <option value="present" ${curStatus === 'present' ? 'selected' : ''}>Present</option>
          <option value="late" ${curStatus === 'late' ? 'selected' : ''}>Late</option>
          <option value="leave" ${curStatus === 'leave' ? 'selected' : ''}>On Leave</option>
          <option value="absent" ${curStatus === 'absent' ? 'selected' : ''}>Absent</option>
        </select>
        <select id="stuTodayMethod" class="erp-input" style="padding: 6px 10px; font-size: 12px; width: auto;">
          <option value="online" ${curMethod === 'online' ? 'selected' : ''}>Online Mode</option>
          <option value="offline" ${curMethod === 'offline' ? 'selected' : ''}>Offline Mode</option>
        </select>
        <input type="text" id="stuTodayRemarks" value="${String(curRemarks).replace(/"/g, '&quot;')}" placeholder="Optional note..." class="erp-input" style="padding: 6px 10px; font-size: 12px; flex: 1 1 160px;">
        <button type="button" id="updateAttendanceBtn" onclick="updateTodayAttendance()" class="erp-btn erp-btn-primary" style="padding: 8px 16px; background: #155EEF; color: #fff; border-radius: 6px; font-weight: 700; font-size: 12px; cursor: pointer; border: none;">
          Update Today's Attendance
        </button>
      `;
    } else if (activeCourse.canMarkToday) {
      bannerText.innerHTML = `<span style="color: #D97706;">● Unmarked for Today (${SERVER_TODAY})</span>`;
      if (badgeEl) badgeEl.innerHTML = '';
      container.innerHTML = `
        <select id="stuTodayStatus" class="erp-input" style="padding: 6px 10px; font-size: 12px; font-weight: 700; width: auto;">
          <option value="present" selected>Present</option>
          <option value="late">Late</option>
          <option value="leave">On Leave</option>
          <option value="absent">Absent</option>
        </select>
        <select id="stuTodayMethod" class="erp-input" style="padding: 6px 10px; font-size: 12px; width: auto;">
          <option value="online" ${curMethod === 'online' ? 'selected' : ''}>Online Mode</option>
          <option value="offline" ${curMethod === 'offline' ? 'selected' : ''}>Offline Mode</option>
        </select>
        <input type="text" id="stuTodayRemarks" placeholder="Optional note..." class="erp-input" style="padding: 6px 10px; font-size: 12px; flex: 1 1 160px;">
        <button type="button" id="markAttendanceBtn" onclick="markTodayAttendance()" class="erp-btn erp-btn-primary" style="padding: 8px 18px; background: #000; color: #fff; border-radius: 6px; font-weight: 700; font-size: 13px; cursor: pointer; border: none;">
          Mark Attendance Today
        </button>
      `;
    } else {
      bannerText.innerHTML = `<span style="color: #64748B;">● Cannot mark attendance (${activeCourse.dateRestrictionReason})</span>`;
      container.innerHTML = `<button type="button" disabled class="erp-btn" style="padding: 8px 18px; background: #E2E8F0; color: #94A3B8; border-radius: 6px; font-weight: 600; font-size: 13px; cursor: not-allowed; border: none;">Mark Attendance</button>`;
    }
  }

  function changeMonth(delta) {
    currentCalDate.setMonth(currentCalDate.getMonth() + delta);
    renderCalendarGrid();
  }

  function renderCalendarGrid() {
    const grid = document.getElementById('calendarDaysGrid');
    grid.innerHTML = '';

    const year = currentCalDate.getFullYear();
    const month = currentCalDate.getMonth();

    const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
    document.getElementById('calendarMonthYear').textContent = `${monthNames[month]} ${year}`;

    const firstDayIndex = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();

    const attendanceMap = {};
    if (activeCourse.records) {
      activeCourse.records.forEach(r => {
        attendanceMap[r.date] = r;
      });
    }

    const startDate = activeCourse.start_date || '9999-99-99';
    const endDate = activeCourse.end_date || '0000-00-00';

    for (let i = 0; i < firstDayIndex; i++) {
      const blank = document.createElement('div');
      blank.style.height = '48px';
      grid.appendChild(blank);
    }

    for (let day = 1; day <= daysInMonth; day++) {
      const monthStr = String(month + 1).padStart(2, '0');
      const dayStr = String(day).padStart(2, '0');
      const dateKey = `${year}-${monthStr}-${dayStr}`;

      const cell = document.createElement('div');
      cell.style.height = '48px';
      cell.style.border = '1px solid #E2E8F0';
      cell.style.borderRadius = '6px';
      cell.style.padding = '4px';
      cell.style.display = 'flex';
      cell.style.flexDirection = 'column';
      cell.style.justifyContent = 'space-between';
      cell.style.position = 'relative';

      const inRange = (dateKey >= startDate && dateKey <= endDate);
      const isToday = (dateKey === SERVER_TODAY);
      const record = attendanceMap[dateKey];

      if (isToday) {
        cell.style.border = '2px solid #000000';
      }

      if (record) {
        const bgMap = { present: '#DCFCE7', late: '#FEF3C7', leave: '#DBEAFE', absent: '#FEE2E2', holiday: '#EDE9FE' };
        const bdMap = { present: '#86EFAC', late: '#FCD34D', leave: '#93C5FD', absent: '#FCA5A5', holiday: '#C4B5FD' };
        cell.style.background = bgMap[record.status] || '#DCFCE7';
        cell.style.borderColor = bdMap[record.status] || '#86EFAC';
      } else if (inRange) {
        cell.style.background = '#F0F9FF';
      } else {
        cell.style.background = '#F8FAFC';
        cell.style.opacity = '0.5';
      }

      let inner = `<div style="font-size: 11px; font-weight: ${isToday ? '800' : '600'}; color: ${isToday ? '#000' : '#334155'};">${day}</div>`;

      if (record) {
        const clrMap = { present: '#16A34A', late: '#B45309', leave: '#1D4ED8', absent: '#DC2626', holiday: '#6D28D9' };
        const txtMap = { present: '✓ Present', late: 'Late', leave: 'Leave', absent: 'Absent', holiday: 'Holiday' };
        inner += `<div style="font-size: 9px; font-weight: 700; color: ${clrMap[record.status] || '#16A34A'}; text-align: center;">${txtMap[record.status] || record.status}</div>`;
      } else if (isToday) {
        inner += `<div style="font-size: 9px; font-weight: 800; color: #000; text-align: center;">TODAY</div>`;
      }

      cell.innerHTML = inner;
      grid.appendChild(cell);
    }
  }

  async function markTodayAttendance() {
    if (!activeCourse) return;
    const btn = document.getElementById('markAttendanceBtn');
    if (btn) btn.disabled = true;

    const status = (document.getElementById('stuTodayStatus') || {}).value || 'present';
    const method = (document.getElementById('stuTodayMethod') || {}).value || 'online';
    const remarks = (document.getElementById('stuTodayRemarks') || {}).value || '';

    try {
      const res = await fetch('/api/student/attendance/mark', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ course_id: activeCourse.course_id, status, method, remarks })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || 'Failed to mark attendance.');

      alert(data.message || 'Attendance marked successfully!');
      window.location.reload();
    } catch (err) {
      alert(err.message);
      if (btn) btn.disabled = false;
    }
  }

  async function updateTodayAttendance() {
    if (!activeCourse) return;
    const btn = document.getElementById('updateAttendanceBtn');
    if (btn) btn.disabled = true;

    const status = (document.getElementById('stuTodayStatus') || {}).value || 'present';
    const method = (document.getElementById('stuTodayMethod') || {}).value || 'online';
    const remarks = (document.getElementById('stuTodayRemarks') || {}).value || '';

    try {
      const res = await fetch('/api/student/attendance/today', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ course_id: activeCourse.course_id, status, method, remarks })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || 'Failed to update today\'s attendance.');

      alert(data.message || 'Today\'s attendance updated successfully!');
      window.location.reload();
    } catch (err) {
      alert(err.message);
      if (btn) btn.disabled = false;
    }
  }
</script>
